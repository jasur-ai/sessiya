{
  "name": "deborah",
  "version": "2.0.0",
  "description": "Deborah — Real-time multiplayer quiz platform (Node.js Edition)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "mock": "node scripts/mock-up.js",
    "seed": "node scripts/seed-dev.js",
    "reset": "rm -f data/db.json && npm run seed",
    "build:og": "node scripts/build-og-image.js",
    "build:pwa": "node scripts/build-pwa-icons.js",
    "build:poster": "node scripts/build-product-poster.js",
    "build": "npm run build:pwa && npm run build:og && npm run build:poster",
    "test:unit": "vitest run tests/unit",
    "test:auth": "vitest run tests/auth/unit tests/auth/integration tests/auth/security",
    "test:e2e:auth": "playwright test tests/e2e/auth",
    "test:security:auth": "vitest run tests/auth/security",
    "test:coverage:cast": "vitest run tests/unit/cast-*.test.js --coverage --coverage.include=services/cast/permissions.js --coverage.include=services/cast/timer-service.js --coverage.include=services/cast/state-machine.js --coverage.include=services/cast/scoring.js --coverage.include=services/cast/presets.js --coverage.include=services/cast/config-schema.js",
    "test:integration": "vitest run tests/integration",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "test:views": "node scripts/test-views.js",
    "test:views:http": "node scripts/test-views-http.js",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:audit": "node scripts/design-audit.js",
    "test:a11y": "node scripts/a11y-audit.js && NODE_ENV=test npx playwright test --project=a11y-audit tests/a11y/",
    "test:a11y:static": "node scripts/a11y-audit.js",
    "design:tokens:build": "node scripts/validate-design-tokens.js && node scripts/build-design-tokens.js",
    "design:tokens:check": "node scripts/validate-design-tokens.js",
    "design:lint": "node scripts/design-lint.js",
    "perf:budget": "node scripts/performance-budget.js",
    "research:analyze": "node scripts/research-analyze.js",
    "legacy:usage": "node scripts/legacy-usage.js",
    "launch:gate": "node scripts/launch-gate.js",
    "launch:gate:full": "node scripts/launch-gate.js --full",
    "design:check": "node scripts/design-check.js",
    "design:check:full": "node scripts/design-check.js --full",
    "fonts:check": "node scripts/check-fonts.js",
    "fonts:download": "node scripts/fonts-download.js",
    "brand:validate": "node scripts/validate-brand-assets.js",
    "contrast:check": "node scripts/check-contrast.js",
    "cvd:check": "node scripts/check-cvd.js",
    "color:check": "node scripts/check-contrast.js && node scripts/check-cvd.js",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "pretest:vip": "rm -f data/db.json",
    "test:vip": "node scripts/test-vip-browser.js",
    "test:typecheck": "tsc --noEmit",
    "test:security": "node scripts/test-xss.js",
    "test:security:ci": "node scripts/security-ci.js",
    "test:security:fuzz": "node scripts/security-fuzz.js",
    "test:load": "node scripts/load-test.js --all",
    "test:load:auth": "node scripts/auth-load-test.js --all",
    "test:chaos": "node scripts/chaos-inject.js --all",
    "test:drill": "node scripts/backup-restore-drill.js --all",
    "test:reliability": "vitest run tests/unit/reliability.test.js tests/integration/reliability.test.js tests/e2e/reliability-release.test.js && npm run test:load && npm run test:chaos && npm run test:drill",
    "test:gate0": "bash scripts/gate-0-verify.sh",
    "test:anskey": "node scripts/answer-key-scan.js",
    "test:security-guard": "vitest run tests/unit/security-guard.test.js tests/integration/security-guard.test.js tests/e2e/security-guard-redteam.test.js",
    "test": "npm run typecheck && npm run test:ci && npm run test:security && npm run test:vip",
    "verify:all": "npm run typecheck && npm run test:ci && npm run test:security && npm run test:reliability && node scripts/release-signoff.js --rehearsal && node scripts/final-migration.js --rehearsal",
    "db:migrate": "node scripts/db-migrate.js",
    "db:status": "node scripts/db-migrate.js --status"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1112.0",
    "@aws-sdk/client-s3": "^3.1098.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@socket.io/redis-streams-adapter": "^0.3.1",
    "argon2": "^0.45.1",
    "compression": "^1.7.4",
    "connect-redis": "^8.1.0",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.18.0",
    "firebase-admin": "^12.6.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "kysely": "^0.29.4",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "otplib": "^13.4.1",
    "pdf-parse": "2.4.5",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zxcvbn": "^4.4.2"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "ioredis-mock": "^8.13.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "sharp": "^0.35.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
