<% const current = user || {}; %>
<!DOCTYPE html>
<html lang="<%= ({ 'uz-Latn': 'uz', 'uz-Cyrl': 'uz-Cyrl-UZ' })[locale] || locale || 'uz' %>" dir="ltr" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Deborah</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/design/premium-theme.css">
  <link rel="stylesheet" href="/design/foundations/responsive.css"><!-- S13: mobil qatlam -->
</head>
<body class="app-body">
  <nav class="navbar">
    <div class="nav-inner">
      <a href="/" class="nav-logo">
        <img src="/images/logo-vintage.png" alt="Deborah" class="logo-img" style="height:34px;width:auto">
        Deborah
      </a>
      <div class="nav-links">
        <a href="/user/panel"><%= ui.navPanel %></a>
        <a href="/user/portfolio" class="active"><%= ui.navPortfolio %></a>
        <a href="/user/security-profile"><%= ui.navSecurity %></a>
        <a href="/user/logout"><%= ui.navLogout %></a>
      </div>
    </div>
  </nav>

  <main class="page-wrap" style="max-width:900px;margin:0 auto;padding:24px 16px">
    <div class="card" style="margin-bottom:20px">
      <h1 style="margin:0 0 4px"><%= ui.evidenceTitle %></h1>
      <p style="margin:0;color:var(--deborah-semantic-color-text-muted);font-size:14px">
        <%= ui.evidenceDesc %>
      </p>
      <span class="chip <%= (portfolio && portfolio.isPublic) ? 'chip-ok' : 'chip-warn' %>"
        style="margin-top:10px;display:inline-block">
        <%= (portfolio && portfolio.isPublic) ? ui.publicChip : ui.privacyChip %>
      </span>
    </div>

    <!-- AUTH C-13: diplom.edu.uz tekshiruv (P3) — client-side, server fetch qilmaydi (SSRF yo'q) -->
    <div class="card" style="margin-bottom:20px">
      <h2 style="margin:0 0 6px"><%= ui.diplomaTitle %></h2>
      <p style="margin:0 0 14px;color:var(--deborah-semantic-color-text-muted);font-size:14px">
        <%= ui.diplomaDesc %>
      </p>
      <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
        <a class="btn btn-primary" id="btnDiplomaCheck" href="/api/user/portfolio/diploma-check"
           style="min-height:44px;min-width:120px;text-decoration:none"
           aria-label="<%= ui.diplomaBtn %>"><%= ui.diplomaBtn %></a>
        <span style="font-size:12px;color:var(--deborah-semantic-color-text-muted)" aria-hidden="true">↗ <%= ui.diplomaOpen %></span>
      </div>
    </div>

    <!-- AUTH A-12: transcript/diploma import (PDF · Excel) -->
    <div class="card" style="margin-bottom:20px">
      <h2 style="margin:0 0 6px"><%= ui.importTitle %></h2>
      <p style="margin:0 0 14px;color:var(--deborah-semantic-color-text-muted);font-size:14px">
        <%= ui.importDesc %>
      </p>
      <div style="display:grid;gap:12px">
        <label for="fImportFile" class="input" style="display:flex;align-items:center;gap:10px;min-height:44px;cursor:pointer">
          <span style="font-size:20px" aria-hidden="true">📄</span>
          <span id="importFileName"><%= ui.importChoose %></span>
          <input id="fImportFile" type="file" accept=".pdf,.xlsx,.csv" style="position:absolute;opacity:0;width:1px;height:1px" aria-label="<%= ui.importChoose %>">
        </label>
        <label style="display:flex;gap:10px;align-items:flex-start;font-size:13px;color:var(--deborah-semantic-color-text-muted);cursor:pointer">
          <input type="checkbox" id="fConsent" style="width:20px;height:20px;margin-top:1px" aria-describedby="importConsentHint">
          <span id="importConsentHint"><%= ui.importConsent %></span>
        </label>
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
          <button class="btn btn-primary" id="btnImport" style="min-height:44px;min-width:120px" disabled><%= ui.importBtn %></button>
          <a class="btn" href="/api/user/portfolio/export" id="btnExport" style="min-height:44px;text-decoration:none" aria-label="<%= ui.exportBtn %>"><%= ui.exportBtn %></a>
        </div>
        <p id="importStatus" role="status" style="margin:0;font-size:13px;min-height:18px"></p>
        <p style="margin:0;font-size:12px;color:var(--deborah-semantic-color-text-muted)"><%= ui.exportHint %> · <%= ui.safeParse %></p>
      </div>
    </div>

    <div class="card" style="margin-bottom:20px">
      <h2 style="margin:0 0 12px"><%= ui.addTitle %></h2>
      <div style="display:grid;gap:10px">
        <div style="display:flex;gap:10px;flex-wrap:wrap">
          <label for="fKind" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)"><%= ui.addTitle %> — tur</label>
          <select id="fKind" class="input" style="flex:1;min-width:160px;min-height:44px">
            <option value="proposal"><%= ui.kindProposal %></option>
            <option value="outline"><%= ui.kindOutline %></option>
            <option value="source_shortlist"><%= ui.kindSourceShortlist %></option>
            <option value="draft"><%= ui.kindDraft %></option>
            <option value="teacher_feedback"><%= ui.kindTeacherFeedback %></option>
            <option value="reflection"><%= ui.kindReflection %></option>
            <option value="oral_defense"><%= ui.kindOralDefense %></option>
            <option value="credential"><%= ui.kindCredential %></option>
            <option value="result"><%= ui.kindResult %></option>
            <option value="certificate"><%= ui.kindCertificate %></option>
          </select>
          <label for="fTitle" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)"><%= ui.addPlaceholder %></label>
          <input id="fTitle" class="input" style="flex:2;min-width:200px;min-height:44px" placeholder="<%= ui.addPlaceholder %>">
          <select id="fAiLevel" class="input" style="flex:1;min-width:140px;min-height:44px" aria-label="<%= ui.aiLevel %>">
            <option value="A0"><%= ui.aiA0 %></option>
            <option value="A1"><%= ui.aiA1 %></option>
            <option value="A2"><%= ui.aiA2 %></option>
            <option value="A3"><%= ui.aiA3 %></option>
            <option value="A4"><%= ui.aiA4 %></option>
          </select>
        </div>
        <div style="display:flex;gap:10px">
          <button class="btn btn-primary" id="btnAdd" style="min-height:44px;min-width:120px"><%= ui.addBtn %></button>
          <span class="muted" id="addHint" style="font-size:13px"></span>
        </div>
      </div>
    </div>

    <div class="card">
      <h2 style="margin:0 0 12px"><%= ui.itemsTitle %></h2>
      <div id="itemsWrap">
        <% (items || []).forEach((it) => { %>
          <div class="row" style="display:flex;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--deborah-semantic-color-border-default)">
            <div style="flex:1">
              <b><%= it.title %></b>
              <div style="font-size:12px;color:var(--deborah-semantic-color-text-muted)">
                <%= it.kind %> · <%= ui.aiLevel %> <%= (it.contentMeta && it.contentMeta.aiUseLevel) ? it.contentMeta.aiUseLevel : 'A0' %>
                <% if (it.evidence && it.evidence.subject) { %>
                  · <%= it.evidence.subject %> <% if (it.evidence.grade) { %>— baho <%= it.evidence.grade %><% } %><% if (it.evidence.credit) { %>, kredit <%= it.evidence.credit %><% } %>
                <% } %>
              </div>
            </div>
            <select class="input vis-select" style="width:130px;min-height:44px" data-id="<%= it.id %>" aria-label="<%= ui.itemsTitle %>">
              <option value="private" <%= it.visibility === 'private' ? 'selected' : '' %>><%= ui.visPrivate %></option>
              <option value="shared" <%= it.visibility === 'shared' ? 'selected' : '' %>><%= ui.visShared %></option>
              <option value="public" <%= it.visibility === 'public' ? 'selected' : '' %>><%= ui.visPublic %></option>
            </select>
            <button class="btn btn-sm share-btn" data-id="<%= it.id %>" style="min-height:44px"><%= ui.shareBtn %></button>
            <button class="btn btn-sm del-btn" data-id="<%= it.id %>" aria-label="<%= ui.delAria %>" style="min-height:44px;min-width:44px">🗑</button>
          </div>
        <% }) %>
        <% if (!items || items.length === 0) { %>
          <p class="muted"><%= ui.itemsEmpty %></p>
        <% } %>
      </div>
    </div>

    <div class="card" style="margin-top:20px">
      <h2 style="margin:0 0 12px"><%= ui.credentialsTitle %></h2>
      <div id="credWrap"><span class="muted"><%= ui.credentialsLoading %></span></div>
      <div style="margin-top:10px;font-size:12px;color:var(--deborah-semantic-color-text-muted)">
        <%= ui.credentialsNote %>
      </div>
    </div>
  </main>

<script>
(function () {
  const CSRF = '<%= csrfToken || "" %>';
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  async function api(path, opts = {}) {
    const res = await fetch(path, {
      method: opts.method || 'GET',
      headers: { 'content-type': 'application/json', 'X-CSRF-Token': CSRF },
      body: opts.body ? JSON.stringify(opts.body) : undefined,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || 'HTTP ' + res.status);
    return data;
  }

  const fileInput = $('fImportFile');
  const consentBox = $('fConsent');
  const importBtn = $('btnImport');

  function syncImportState() {
    importBtn.disabled = !(fileInput.files.length > 0 && consentBox.checked);
  }
  fileInput.addEventListener('change', () => {
    $('importFileName').textContent = fileInput.files[0] ? fileInput.files[0].name : '<%= ui.importChoose %>';
    syncImportState();
  });
  consentBox.addEventListener('change', syncImportState);

  importBtn.addEventListener('click', async () => {
    const file = fileInput.files[0];
    if (!file) return;
    if (!consentBox.checked) { $('importStatus').textContent = '<%= ui.importNoConsent %>'; return; }
    const fd = new FormData();
    fd.append('file', file);
    fd.append('consent', 'true');
    $('importStatus').textContent = '…';
    importBtn.disabled = true;
    try {
      const res = await fetch('/api/user/portfolio/import', {
        method: 'POST',
        headers: { 'X-CSRF-Token': CSRF },
        body: fd,
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'HTTP ' + res.status);
      $('importStatus').textContent = '<%= ui.importOk %>'.replace('{created}', data.created)
        + (data.skipped ? ' (duplikat: ' + data.skipped + ')' : '')
        + (data.warnings && data.warnings.length ? ' — ' + data.warnings.join(' ') : '');
      setTimeout(() => location.reload(), 500);
    } catch (e) {
      $('importStatus').textContent = '✗ ' + e.message;
      importBtn.disabled = false;
      syncImportState();
    }
  });

  $('btnAdd').addEventListener('click', async () => {
    const title = $('fTitle').value.trim();
    if (!title) { $('addHint').textContent = '<%= ui.errTitleRequired %>'; return; }
    try {
      const r = await api('/api/user/portfolio/items', {
        method: 'POST',
        body: { kind: $('fKind').value, title, visibility: 'private', contentMeta: { aiUseLevel: $('fAiLevel').value } },
      });
      $('addHint').textContent = '<%= ui.addedOk %>';
      setTimeout(() => location.reload(), 400);
    } catch (e) { $('addHint').textContent = '✗ ' + e.message; }
  });

  document.querySelectorAll('.vis-select').forEach((sel) => {
    sel.addEventListener('change', async () => {
      try {
        await api('/api/user/portfolio/items/' + sel.dataset.id, { method: 'PATCH', body: { visibility: sel.value } });
      } catch (e) { alert(e.message); }
    });
  });

  document.querySelectorAll('.share-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        const r = await api('/api/user/items/' + btn.dataset.id + '/share', { method: 'POST', body: {} });
        const url = location.origin + r.url;
        try { await navigator.clipboard.writeText(url); }
        catch (e2) { window.prompt('<%= ui.sharePrompt %>', url); }
        alert('<%= ui.shareCopied %>');
      } catch (e) { alert(e.message); }
    });
  });

  document.querySelectorAll('.del-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!window.confirm('Delete this item?')) return;
      try {
        await api('/api/user/portfolio/items/' + btn.dataset.id, { method: 'DELETE' });
        location.reload();
      } catch (e) { alert(e.message); }
    });
  });

  (async function loadCredentials() {
    try {
      const { credentials } = await api('/api/user/credentials');
      $('credWrap').innerHTML = (credentials || []).map((c) =>
        '<div style="padding:8px 0;border-bottom:1px solid var(--deborah-semantic-color-border-default)">' +
          '<b>' + esc(c.name || ('#' + c.id)) + '</b> ' +
          '<span class="chip chip-' + (c.effectiveStatus === 'revoked' ? 'err' : (c.effectiveStatus === 'expired' ? 'warn' : 'ok')) + '">' + esc(c.effectiveStatus) + '</span>' +
          '<div style="font-size:12px;color:var(--deborah-semantic-color-text-muted)">Digest: ' + esc((c.vc_digest || '').slice(0, 16)) + '… · Verify: <a href="/verify/' + esc(c.vc_digest || '') + '">ochish</a></div>' +
        '</div>'
      ).join('') || '<span class="muted"><%= ui.credentialsEmpty %></span>';
    } catch (e) { $('credWrap').innerHTML = '<span class="muted">✗ ' + esc(e.message) + '</span>'; }
  })();
})();
</script>
</body>
</html>
