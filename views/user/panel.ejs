  <script defer>
  /* ── PANEL I18N (4 til: uz / uz-cyrl / ru / en) — yagona manba __PANEL_COPY.
     Server copy data/panel-i18n.js dan keladi; EJS static matnlar allaqachon
     to'g'ri tilda render qilingan, data-i18n esa bosish paytidagi tezkor
     almashuv uchun. Bitta listener — dublikat PATCH/reload YO'Q. ── */
  window.__PANEL_LANG = <%- JSON.stringify(panelLang || 'uz') %>;
  window.__PANEL_COPY = <%- JSON.stringify(panelCopyAll || { uz: panelCopy || {} }) %>;
  (function(){
    var P = window.__PANEL_COPY || {};
    // Flat (faqat bitta til) bo'lsa nest qilib olamiz — server har doim to'liq 4 til beradi
    if (P.uz === undefined && P['ws.title'] !== undefined) P = { uz: P };
    var cur = (P[window.__PANEL_LANG] !== undefined) ? window.__PANEL_LANG : 'uz';
    window.__PANEL_LANG = cur;
    window.__PT = function(k, fb){
      var d = P[cur] || {};
      return (d[k] !== undefined) ? d[k] : (fb !== undefined ? fb : '');
    };
    // Son ko'plik shakli (ru: 3, en: 2, uz/uz-cyrl: 1) — '|' bilan ajratilgan shakllar
    window.__PF = function(k, n, fb){
      var d = P[cur] || {};
      var v = (d[k] !== undefined) ? String(d[k]) : (fb !== undefined ? String(fb) : '');
      if (!v) return '';
      var nn = Number(n) || 0;
      var parts = v.split('|');
      if (parts.length === 1) return v.split('{n}').join(String(nn));
      var idx = 0;
      if (cur === 'ru') { idx = (nn % 10 === 1 && nn % 100 !== 11) ? 0 : ((nn % 10 >= 2 && nn % 10 <= 4 && (nn % 100 < 12 || nn % 100 > 14)) ? 1 : (parts.length > 2 ? 2 : 1)); }
      else if (cur === 'en') { idx = nn === 1 ? 0 : (parts.length > 1 ? 1 : 0); }
      return (parts[Math.min(idx, parts.length - 1)] || '').split('{n}').join(String(nn));
    };
    function apply(l){
      var d = P[l]; if(!d) return;
      document.querySelectorAll('[data-i18n]').forEach(function(el){
        var k = el.getAttribute('data-i18n');
        if (d[k] !== undefined) el.innerHTML = d[k];
      });
    }
    var group = document.getElementById('panelLangGroup');
    if (group) {
      group.querySelectorAll('button').forEach(function(b){
        b.addEventListener('click', function(){
          var l = b.getAttribute('data-plang');
          if (l === cur || b.classList.contains('on')) return;
          group.querySelectorAll('button').forEach(function(x){ x.classList.toggle('on', x === b); });
          apply(l); // client-side darhol (reload'gacha)
          fetch('/user/api/settings/profile', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin', body: JSON.stringify({ lang: l }) })
            .then(function(r){ if (r.ok) { location.reload(); } else { console.warn('lang save failed'); } })
            .catch(function(){});
        });
      });
    }
    var tbtn = document.getElementById('panelThemeBtn');
    if (tbtn) {
      tbtn.addEventListener('click', function(){
        var T = window.DeborahTheme;
        var next = (T && T.isLight && T.isLight()) ? 'dark' : 'light';
        if (T && T.setState) { T.setState(next); } else if (T && T.apply) { T.apply(next); }
        fetch('/user/api/settings/profile', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin', body: JSON.stringify({ theme: next }) }).catch(function(){});
      });
    }
  })();
  </script>
  <script>
    // AUTH A-28: risk banner — device trust (step-up) + mid-session mismatch
    (function () {
      'use strict';
      var banner = document.getElementById('risk-banner');
      if (!banner || !window.DeborahDeviceFingerprint) return;
      var copy = window.__RISK_COPY__ || {};
      var fp = window.DeborahDeviceFingerprint.compute();
      var closed = false;
      function show(title, msg, opts) {
        if (closed) return;
        document.getElementById('risk-banner-title').textContent = title || '';
        document.getElementById('risk-banner-msg').textContent = msg || '';
        document.getElementById('risk-banner-trust').style.display = opts.trust ? '' : 'none';
        document.getElementById('risk-banner-reauth').style.display = opts.reauth ? '' : 'none';
        document.getElementById('risk-banner-logout').style.display = opts.logout ? '' : 'none';
        if (opts.trust) document.getElementById('risk-banner-trust-label').textContent = copy.trustBtn || '';
        if (opts.reauth) document.getElementById('risk-banner-reauth-label').textContent = copy.reauthBtn || '';
        if (opts.logout) document.getElementById('risk-banner-logout-label').textContent = copy.logoutBtn || '';
        banner.style.display = 'flex';
      }
      function hide() { closed = true; banner.style.display = 'none'; }
      document.getElementById('risk-banner-close').addEventListener('click', hide);
      document.getElementById('risk-banner-trust').addEventListener('click', function () {
        fetch('/api/auth/device/trust', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
        }).then(function (r) { return r.json(); }).then(function (j) {
          if (j.ok) {
            document.getElementById('risk-banner-msg').textContent = copy.done || '';
            document.getElementById('risk-banner-trust').style.display = 'none';
            document.getElementById('risk-banner-close').style.display = 'none';
          }
        }).catch(function () {});
      });
      document.getElementById('risk-banner-reauth').addEventListener('click', function () {
        var pwd = window.prompt(copy.reauthBtn || 'Parolni kiriting');
        if (!pwd) return;
        fetch('/api/auth/reauth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ password: pwd }),
        }).then(function (r) { return r.json(); }).then(function (j) {
          if (j.ok) { hide(); } else { window.alert(copy.mismatchMsg || 'Tekshiruv muvaffaqiyatsiz'); }
        }).catch(function () {});
      });
      document.getElementById('risk-banner-logout').addEventListener('click', function () {
        window.location.href = '/logout';
      });
      if (!fp) return;
      // 1) Mid-session mismatch (server-side audit bilan)
      fetch('/api/auth/device/check', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ fingerprint: fp }),
      }).then(function (r) { return r.json(); }).then(function (j) {
        if (j.mismatch) show(copy.mismatchTitle, copy.mismatchMsg, { reauth: true, logout: true });
      }).catch(function () {});
      // 2) Step-up (unknown tier) → device trust
      fetch('/api/auth/device/status', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); }).then(function (j) {
          if (closed) return;
          if (j.riskStepup && !j.riskFlagged) {
            show(copy.deviceTrust, copy.deviceTrustMsg, { trust: true, close: true });
          } else if (j.riskFlagged) {
            show(copy.mismatchTitle, copy.mismatchMsg, { reauth: true, logout: true });
          }
        }).catch(function () {});
    })();
  </script>
  <script>
    // S26: API POST'lar uchun CSRF token (X-CSRF-Token header)
    window.__CSRF_TOKEN = <%- JSON.stringify(csrfToken || '') %>;
    // AUTH A-28: risk banner copy (i18n)
    window.__RISK_COPY__ = <%- JSON.stringify(riskCopy || {}) %>;
