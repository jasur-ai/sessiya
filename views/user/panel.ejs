<!DOCTYPE html>
<html lang="<%= htmlLang %>" dir="ltr">
<head>
  <%- include('../partials/head') %>
  <% const __pl = (typeof panelCopy !== 'undefined' && panelCopy) ? panelCopy : null; %>
  <% const __p = (k, d) => (__pl && __pl[k] !== undefined) ? __pl[k] : (d !== undefined ? d : ''); %>
  <% const __pct = (k, n) => (__pl && __pl[k] !== undefined) ? String(__pl[k]).split('{n}').join(String(n)) : ''; %>
  <% const __plang = (typeof panelLang !== 'undefined' && panelLang) ? panelLang : 'uz'; %>
  <% const __pf = (k, n) => { const v = (__pl && __pl[k] !== undefined) ? String(__pl[k]) : ''; if (!v) return ''; const nn = Number(n) || 0; const parts = v.split('|'); if (parts.length === 1) return v.split('{n}').join(String(nn)); let idx = 0; if (__plang === 'ru') { idx = (nn % 10 === 1 && nn % 100 !== 11) ? 0 : ((nn % 10 >= 2 && nn % 10 <= 4 && (nn % 100 < 12 || nn % 100 > 14)) ? 1 : (parts.length > 2 ? 2 : 1)); } else if (__plang === 'en') { idx = nn === 1 ? 0 : (parts.length > 1 ? 1 : 0); } return parts[Math.min(idx, parts.length - 1)].split('{n}').join(String(nn)); }; %>
  <link rel="stylesheet" href="/css/cast-studio.css">
  <link rel="stylesheet" href="/design/contexts/workspace.css">
  <style>
    /* S25.05: shell qismi navigation.css/style.css'dan — sahifaga xos faqat tor override'lar */
    .ws-live { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

    /* ── AUTH A-18: email verify banner + modal ── */
    .email-verify-banner{display:flex;align-items:center;gap:12px;padding:12px 16px;margin-bottom:16px;border:1px solid var(--deborah-semantic-color-border-default,rgba(201,165,101,.35));border-radius:var(--deborah-radius-md,14px);background:var(--deborah-semantic-color-action-primary-soft,rgba(201,165,101,.09));}
    .email-verify-banner .evb-icon{flex-shrink:0;width:34px;height:34px;display:flex;align-items:center;justify-content:center;border-radius:10px;background:var(--deborah-semantic-color-action-primary,rgba(201,165,101,.16));color:var(--deborah-semantic-color-action-primary,#c9a565);}
    .email-verify-banner .evb-text{flex:1;display:flex;flex-direction:column;gap:2px;font-size:.86rem;color:var(--deborah-semantic-color-text-secondary);}
    .email-verify-banner .evb-text strong{color:var(--deborah-semantic-color-text-primary);font-size:.92rem;}
    .email-verify-banner .evb-btn{flex-shrink:0;min-height:40px;}
    .evm-err{color:var(--deborah-semantic-color-status-danger,#c05b44);font-size:.84rem;font-weight:600;margin-bottom:8px;}
    .evm-note{color:var(--deborah-semantic-color-text-secondary,#8b93a7);font-size:.82rem;font-weight:600;margin:-6px 0 10px;}
    .evm-resend{margin-top:12px;font-size:.82rem;font-weight:600;color:var(--deborah-semantic-color-action-primary,#c9a565);background:none;border:none;cursor:pointer;min-height:44px;}
    .evm-resend:disabled{opacity:.5;cursor:not-allowed;}
    .evm-resend:not(:disabled):hover{text-decoration:underline;}
    .evm-resend:focus-visible{outline:2px solid var(--deborah-semantic-color-action-primary,#c9a565);outline-offset:2px;border-radius:8px;}
    .evm-toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(16px);background:var(--deborah-semantic-color-action-primary,#c9a565);color:var(--deborah-semantic-color-action-on-action,#1a1305);padding:12px 20px;border-radius:12px;font-weight:700;font-size:.9rem;opacity:0;transition:opacity 200ms ease,transform 200ms ease;z-index:600;box-shadow:0 8px 24px rgba(0,0,0,.25);}
    .evm-toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
    .evm-foot{margin-top:12px;text-align:center;}
    .evm-update-email{font-size:.8rem;font-weight:600;color:var(--deborah-semantic-color-text-muted);text-decoration:underline;text-underline-offset:3px;min-height:44px;display:inline-flex;align-items:center;justify-content:center;padding:0 4px;}
    .evm-update-email:hover{color:var(--deborah-semantic-color-action-primary,#c9a565);}
    .evm-update-email:focus-visible{outline:2px solid var(--deborah-semantic-color-action-primary,#c9a565);outline-offset:2px;border-radius:8px;}
    @media (max-width:640px){.email-verify-banner{flex-wrap:wrap;}.email-verify-banner .evb-btn{width:100%;}}

    /* ── Modals (saqlangan — start + cast studio) ── */
    .modal-overlay{position:fixed;inset:0;z-index:500;display:none;align-items:center;justify-content:center;padding:20px;background:var(--deborah-semantic-color-surface-scrim, rgba(2,6,16,.6));backdrop-filter:blur(8px);}

    /* ── Demo 1:1: topbar til + tema boshqaruvi ── */
    .ws-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
    .tb-lang{display:flex;gap:2px;background:var(--deborah-semantic-color-surface-nested,rgba(127,137,161,.12));border:1px solid var(--deborah-semantic-color-border-subtle,rgba(127,137,161,.22));border-radius:9px;padding:2px;}
    .tb-lang button{background:transparent;border:none;border-radius:7px;color:var(--deborah-semantic-color-text-secondary,#9aa3b8);font-family:ui-monospace,'SF Mono',Menlo,Consolas,monospace;font-size:.62rem;letter-spacing:.08em;padding:6px 9px;cursor:pointer;transition:all .15s;min-height:0;}
    .tb-lang button:hover{color:var(--deborah-semantic-color-text-primary,#e8ebf5);}
    .tb-lang button.on{background:var(--deborah-semantic-color-action-primary,#c9a45c);color:var(--deborah-semantic-color-action-on-action,#1a1305);font-weight:700;}
    .tb-theme-btn{width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;border-radius:9px;border:1px solid var(--deborah-semantic-color-border-subtle,rgba(127,137,161,.22));background:var(--deborah-semantic-color-surface-nested,rgba(127,137,161,.12));color:var(--deborah-semantic-color-text-secondary,#9aa3b8);cursor:pointer;transition:all .15s;}
    .tb-theme-btn:hover{color:var(--deborah-semantic-color-text-primary,#e8ebf5);border-color:var(--deborah-semantic-color-border-default,rgba(127,137,161,.4));}
    .tb-theme-btn svg{width:16px;height:16px;}
    html[data-resolved-theme="light"] .tb-theme-btn .ico-moon{display:none;}
    html:not([data-resolved-theme="light"]) .tb-theme-btn .ico-sun{display:none;}
    html[data-resolved-theme="light"] .tb-theme-btn .ico-sun{display:block;}
    html:not([data-resolved-theme="light"]) .tb-theme-btn .ico-moon{display:block;}

    .modal-overlay.open{display:flex;}
    .modal-box{background:var(--deborah-semantic-color-surface-raised);border-radius:var(--deborah-radius-lg,20px);padding:24px;width:100%;max-width:480px;border:1px solid var(--deborah-semantic-color-border-subtle);box-shadow:var(--shadow-xl);max-height:90vh;overflow-y:auto;}
    .modal-title{font-family:var(--deborah-typography-font-display,var(--font-display));font-size:1.2rem;margin-bottom:4px;display:flex;align-items:center;gap:8px;color:var(--deborah-semantic-color-text-primary);}
    .modal-sub{color:var(--deborah-semantic-color-text-muted);font-size:.88rem;margin-bottom:16px;font-weight:600;}
    .modal-actions{display:flex;gap:8px;margin-top:16px;}
    .modal-btn{flex:1;border:none;border-radius:var(--deborah-radius-sm,10px);padding:12px;font-family:var(--deborah-typography-font-body,var(--font-body));font-size:.9rem;font-weight:700;cursor:pointer;min-height:44px;}
    .modal-btn-primary{background:var(--deborah-semantic-color-action-primary);color:var(--deborah-semantic-color-action-on-action,#1a1305);}
    .modal-btn-primary:hover{background:var(--deborah-semantic-color-action-primary-hover);}
    .modal-btn-secondary{background:var(--deborah-semantic-color-surface-nested);color:var(--deborah-semantic-color-text-secondary);}
    .modal-btn-secondary:hover{background:var(--deborah-semantic-color-surface-default);}
    .modal-divider{border:none;border-top:1px solid var(--deborah-semantic-color-divider);margin:14px 0;}
    .modal-time-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:14px;}
    .modal-time-opt{border:2px solid var(--deborah-semantic-color-border-subtle);background:var(--deborah-semantic-color-surface-nested);border-radius:var(--deborah-radius-sm,10px);padding:8px 4px;text-align:center;cursor:pointer;min-height:44px;transition:border-color 120ms ease,background-color 120ms ease;}
    .modal-time-opt:hover{border-color:var(--deborah-semantic-color-border-default);}
    .modal-time-opt.selected{border-color:var(--deborah-semantic-color-action-primary);background:var(--deborah-semantic-color-action-primary-soft);}
    .modal-time-opt .tv{font-size:.88rem;font-weight:700;color:var(--deborah-semantic-color-text-primary);}
    .modal-time-opt .tl{font-size:.74rem;font-weight:700;color:var(--deborah-semantic-color-text-muted);margin-top:2px;}
    .modal-section-label{font-size:.8rem;font-weight:700;color:var(--deborah-semantic-color-text-secondary);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px;}
    .modal-type-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:14px;}
    .modal-type-opt{border:2px solid var(--deborah-semantic-color-border-subtle);background:var(--deborah-semantic-color-surface-nested);border-radius:var(--deborah-radius-sm,10px);padding:10px 8px;text-align:center;cursor:pointer;min-height:44px;transition:border-color 120ms ease;}
    .modal-type-opt:hover{border-color:var(--deborah-semantic-color-border-default);}
    .modal-type-opt.selected{border-color:var(--deborah-semantic-color-action-primary);background:var(--deborah-semantic-color-action-primary-soft);}
    .modal-type-opt .tic{font-size:1.2rem;margin-bottom:3px;}
    .modal-type-opt .tl{font-size:.76rem;font-weight:600;color:var(--deborah-semantic-color-text-muted);}

    /* ── Search (S25.02: header ichida) ── */
    .ws-search{display:flex;gap:8px;min-width:240px;}
    .ws-search-inp{flex:1;background:var(--deborah-semantic-color-surface-input);border:1px solid var(--deborah-semantic-color-border-default);border-radius:var(--deborah-radius-sm,10px);padding:10px 14px;color:var(--deborah-semantic-color-text-primary);font-family:var(--deborah-typography-font-body,var(--font-body));font-size:.92rem;font-weight:600;outline:none;min-height:44px;transition:border-color 120ms ease,box-shadow 120ms ease;}
    .ws-search-inp:focus{border-color:var(--deborah-semantic-color-action-primary);box-shadow:0 0 0 3px var(--deborah-semantic-color-focus);}
    .ws-search-inp::placeholder{color:var(--deborah-semantic-color-text-muted);}
    .ws-search-btn{background:var(--deborah-semantic-color-surface-nested);border:1px solid var(--deborah-semantic-color-border-default);border-radius:var(--deborah-radius-sm,10px);padding:0 16px;color:var(--deborah-semantic-color-text-secondary);font-family:var(--deborah-typography-font-body,var(--font-body));font-size:.9rem;font-weight:700;cursor:pointer;min-height:44px;display:inline-flex;align-items:center;gap:6px;transition:background-color 120ms ease,color 120ms ease;}
    .ws-search-btn:hover{background:var(--deborah-semantic-color-action-primary);color:var(--deborah-semantic-color-action-on-action,#1a1305);}


    /* ── Search result cards ── */
    .search-result-card{display:flex;align-items:center;gap:12px;background:var(--deborah-semantic-color-surface-raised);border-radius:var(--deborah-radius-sm,12px);padding:12px 15px;margin-bottom:7px;border:1px solid var(--deborah-semantic-color-border-subtle);}
    .sr-name{font-weight:700;font-size:.9rem;display:flex;align-items:center;gap:6px;color:var(--deborah-semantic-color-text-primary);}
    .sr-meta{font-size:.875rem;font-weight:600;color:var(--deborah-semantic-color-text-muted);}
    .sr-start{border-radius:var(--deborah-radius-sm,9px);border:1px solid var(--deborah-semantic-color-border-default);background:var(--deborah-semantic-color-surface-raised);color:var(--deborah-semantic-color-status-success);padding:8px 13px;font-family:var(--deborah-typography-font-body,var(--font-body));font-size:.875rem;font-weight:700;cursor:pointer;min-height:38px;flex-shrink:0;display:inline-flex;align-items:center;gap:5px;}
    .sr-start:hover{background:var(--deborah-semantic-color-status-success);border-color:var(--deborah-semantic-color-status-success);color:#fff;}

    @media(max-width:600px){.tc-actions{flex-wrap:wrap;}}
    /* ── 09/2026: Cast qilish / Sinov tugmalari — bitta issiq palitra (oltin/bronza).
          Reklamadagi aralash yorqin gradientlar (ko'k-binafsha-qizil / qizil) olib
          tashlandi: qizil/ko'k yo'q, premium oltin-jigarrang tokenlar ishlatiladi. ── */
    .act-cast, .act-sinov { position: relative; overflow: hidden; border: 0 !important;
      background-image: none !important; font-weight: 800 !important;
      box-shadow: 0 6px 18px rgba(10,8,4,.28); transition: transform .16s ease, box-shadow .16s ease, filter .16s ease; }
    .act-cast { background: linear-gradient(135deg, #d9b465 0%, #c9a565 55%, #a37f3a 100%) !important; color: #1a1305 !important; }
    .act-sinov { background: linear-gradient(135deg, #8a6a2e 0%, #7e5f28 60%, #5f471d 100%) !important; color: #faf5e8 !important; }
    .act-cast:hover, .act-sinov:hover { transform: translateY(-2px) scale(1.03); filter: brightness(1.1); box-shadow: 0 10px 26px rgba(10,8,4,.34); }
    .act-cast:active, .act-sinov:active { transform: translateY(0) scale(.99); }
    .act-cast::after, .act-sinov::after { content: ''; position: absolute; top: 0; left: -80%; width: 50%; height: 100%;
      background: linear-gradient(105deg, transparent, rgba(255,255,255,.22), transparent); transform: skewX(-20deg);
      transition: left .45s ease; pointer-events: none; }
    .act-cast:hover::after, .act-sinov:hover::after { left: 135%; }
    @media (prefers-reduced-motion: reduce) { .act-cast, .act-sinov { transition: none; } .act-cast::after, .act-sinov::after { display: none; } }
    /* 09/2026: Testlarim bo'limi — sarlavha osti izohi + minor sarlavha */
    .ws-sec-sub{font-size:.84rem;color:var(--deborah-semantic-color-text-muted);font-weight:600;margin-top:2px;}
    .ws-sec-title--minor{font-size:.96rem !important;color:var(--deborah-semantic-color-text-secondary);letter-spacing:.01em;}
    .ws-sec-hd--minor{margin-top:34px;}
    .modal-time-opt.opt-untimed{outline:1.5px dashed var(--deborah-semantic-color-action-primary, #b8860b);outline-offset:1px;}
  </style>
</head>
<body>
  <!-- Skip-link sidebar'da (shell) -->
  <%- include('../partials/sidebar', { active: 'panel', user: { username }, role: 'student' }) %>

  <main class="main" id="main-content" tabindex="-1">

    <!-- AUTH A-27: passkey nudge — passkey yo'q va WebAuthn qo'llansa ko'rinadi (dismissible) -->
    <div class="email-verify-banner" id="passkey-nudge" role="region" aria-live="polite" data-testid="passkey-nudge" style="display:none">
      <div class="evb-icon"><%- icon('key', 16) %></div>
      <div class="evb-text">
        <strong data-i18n="pk.title"><%= __p('pk.title') %></strong>
        <span data-i18n="pk.sub"><%= __p('pk.sub') %></span>
      </div>
      <div class="evb-actions">
        <a class="btn btn-primary evb-btn" href="/user/security-profile" style="text-decoration:none"><%- icon('shieldCheck', 14) %> <span data-i18n="pk.cta"><%= __p('pk.cta') %></span></a>
        <button type="button" class="btn evb-btn evb-ghost" id="passkey-nudge-close" aria-label="<%= __p('aria.close') %>"><%- icon('x', 14) %></button>
      </div>
    </div>

    <!-- AUTH A-28: risk banner — step-up (device trust) yoki mid-session mismatch -->
    <div class="email-verify-banner" id="risk-banner" role="region" aria-live="polite" data-testid="risk-banner" style="display:none">
      <div class="evb-icon"><%- icon('shieldCheck', 16) %></div>
      <div class="evb-text">
        <strong id="risk-banner-title"></strong>
        <span id="risk-banner-msg"></span>
      </div>
      <div class="evb-actions">
        <button type="button" class="btn btn-primary evb-btn" id="risk-banner-trust" style="display:none"><%- icon('check', 14) %> <span id="risk-banner-trust-label"></span></button>
        <button type="button" class="btn evb-btn" id="risk-banner-reauth" style="display:none"><span id="risk-banner-reauth-label"></span></button>
        <button type="button" class="btn evb-btn evb-ghost" id="risk-banner-logout" style="display:none"><span id="risk-banner-logout-label"></span></button>
        <button type="button" class="btn evb-btn evb-ghost" id="risk-banner-close" aria-label="<%= __p('aria.close') %>"><%- icon('x', 14) %></button>
      </div>
    </div>

    <!-- AUTH A-29: breach banner — parol ma'lum breach'da topilgan (HIBP P1) -->
    <% if (typeof breachFlagged !== 'undefined' && breachFlagged) { %>
    <div class="email-verify-banner banner-danger" role="region" aria-live="polite" data-testid="breach-banner">
      <div class="evb-icon"><%- icon('alertTriangle', 16) %></div>
      <div class="evb-text">
        <strong><%= accountCopy.breachTitle || 'Parolingiz xavfsiz emas' %></strong>
        <span><%= accountCopy.breachMsg || 'Parolingiz ma\'lum ma\'lumot sizdirilishlarida topilgan — xavfsizlik uchun uni o\'zgartiring.' %></span>
      </div>
      <a class="btn btn-primary evb-btn" href="/user/security-profile" style="text-decoration:none" data-analytics="breach_change_password"><%- icon('shieldCheck', 14) %> <%= accountCopy.changeNow || 'Hozir o\'zgartirish' %></a>
    </div>
    <% } %>

    <!-- AUTH D-25 §12: re-consent banner — privacy policy yangilangan/berilmagan -->
    <% if (typeof consentStale !== 'undefined' && consentStale) { %>
    <div class="email-verify-banner banner-warning" role="region" aria-live="polite" data-testid="consent-banner">
      <div class="evb-icon"><%- icon('shieldCheck', 16) %></div>
      <div class="evb-text">
        <strong data-i18n="c.title"><%= __p('c.title') %></strong>
        <span data-i18n="c.body"><%- __p('c.body') %></span>
      </div>
      <div class="evb-actions">
        <button type="button" class="btn btn-primary evb-btn" id="btn-consent-grant" data-analytics="consent_regrant"><%- icon('check', 14) %> <span data-i18n="c.cta"><%= __p('c.cta') %></span></button>
        <button type="button" class="btn evb-btn evb-ghost" id="btn-consent-dismiss" aria-label="<%= __p('aria.close') %>"><%- icon('x', 14) %></button>
      </div>
    </div>
    <% } %>

    <!-- AUTH A-18/B-06: limited mode banner — email verify'siz summative blok -->
    <% if (typeof emailVerified !== 'undefined' && !emailVerified) { %>
    <div class="email-verify-banner" role="region" aria-live="polite" data-testid="email-verify-banner">
      <div class="evb-icon"><%- icon('mail', 16) %></div>
      <div class="evb-text">
        <strong><%= verifyCopy.bannerTitle || 'Emailingizni tasdiqlang' %></strong>
        <span><%= userEmail ? (verifyCopy.modalSub || 'Kod ' + userEmail + ' manziliga yuborildi').replace('{email}', userEmail) : (verifyCopy.modalSubNoEmail || 'Emailingizga yuborilgan kodni kiriting') %> — <%= verifyCopy.bannerMsg || 'nazorat topshiriqlari va parol tiklash uchun shart' %>.</span>
      </div>
      <button type="button" class="btn btn-primary evb-btn" id="btn-verify-email" data-analytics="email_verify_open"><%- icon('check', 14) %> <%= verifyCopy.submit || 'Tasdiqlash' %></button>
    </div>
    <% } %>

    <div class="topbar">
      <div>
        <h1 data-i18n="ws.title"><%= __p('ws.title') %></h1>
        <div class="ws-header-sub"><%= __p('ws.sub').replace('{name}', username) %></div>
      </div>
      <div class="ws-actions">
        <% /* Demo 1:1: topbar'da til (UZ/RU/EN) + tema tugmasi */ %>
        <div class="tb-lang" role="group" aria-label="<%= __p('aria.lang') %>" id="panelLangGroup">
          <button type="button" data-plang="uz" class="<%= (typeof panelLang !== 'undefined' && panelLang === 'uz') || typeof panelLang === 'undefined' ? 'on' : '' %>">UZ</button>
          <button type="button" data-plang="uz-cyrl" class="<%= typeof panelLang !== 'undefined' && panelLang === 'uz-cyrl' ? 'on' : '' %>">ЎЗ</button>
          <button type="button" data-plang="ru" class="<%= typeof panelLang !== 'undefined' && panelLang === 'ru' ? 'on' : '' %>">RU</button>
          <button type="button" data-plang="en" class="<%= typeof panelLang !== 'undefined' && panelLang === 'en' ? 'on' : '' %>">EN</button>
        </div>
        <button class="tb-theme-btn" id="panelThemeBtn" type="button" aria-label="<%= __p('aria.theme') %>">
          <svg class="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
          <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5 5l1.6 1.6M17.4 17.4 19 19M19 5l-1.6 1.6M6.6 17.4 5 19"/></svg>
        </button>
        <% /* 09/2026 (user qarori): topbar'da faqat til + tema. Quick Prompt, Profilim
              va dublikat 'Yangi test' olib tashlandi — yangi test faqat kutubxona
              sarlavhasida bitta joyda turadi (pastda shartli ko'rinadi). */ %>
      </div>
    </div>

    <div class="ws-live" role="status" aria-live="polite" id="ws-live"></div>

    <!-- First fold (S25.03) -->
    <% if (tests.length > 0) { %>
      <div class="ws-resume">
        <div class="ws-resume-ico"><%- icon('gamepad', 22) %></div>
        <div class="ws-resume-body">
          <h2 class="ws-resume-title"><%= tests[0].name %></h2>
          <p class="ws-resume-meta"><%= __pf('rsMeta.qcount', tests[0].count) %></p>
        </div>
        <div class="ws-resume-actions">
