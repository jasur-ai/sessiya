<!DOCTYPE html>
<html lang="<%= htmlLang %>" dir="ltr">
<head>
  <%- include('../partials/head') %>
  <style>
    /* Yakka mashq (Sinov) — premium token uslubi (panel/workspace bilan bir xil
       dizayn tili: light/dark temaga moslashadi, panel bilan bir xil ranglar). */
    *{box-sizing:border-box;}
    html,body{min-height:100%;}
    body{
      font-family:var(--deborah-typography-font-body, 'Source Sans 3', system-ui, sans-serif);
      background:var(--deborah-semantic-color-surface-default);
      color:var(--deborah-semantic-color-text-primary);
      margin:0;padding:0;
    }
    .pr-top{
      position:sticky;top:0;z-index:20;
      display:flex;align-items:center;gap:10px;flex-wrap:wrap;
      padding:10px 16px;
      background:var(--deborah-semantic-color-surface-raised);
      border-bottom:1px solid var(--deborah-semantic-color-border-default);
      backdrop-filter:blur(10px);
    }
    .pr-title{
      font-family:var(--deborah-typography-font-display, var(--deborah-typography-font-body, inherit));
      font-size:1rem;font-weight:800;margin:0;display:flex;align-items:center;gap:8px;min-width:0;
    }
    .pr-badge{
      font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;
      color:var(--deborah-semantic-color-action-on-action,#fff);
      background:var(--deborah-semantic-color-action-primary);
      border-radius:50px;padding:3px 10px;flex-shrink:0;
    }
    .pr-back{
      margin-left:auto;text-decoration:none;font-size:.82rem;font-weight:700;
      color:var(--deborah-semantic-color-text-secondary);
      padding:8px 12px;border-radius:10px;border:1px solid var(--deborah-semantic-color-border-subtle);
      background:var(--deborah-semantic-color-surface-nested);
    }
    .pr-back:hover{color:var(--deborah-semantic-color-text-primary);border-color:var(--deborah-semantic-color-border-default);}
    .pr-wrap{max-width:760px;margin:0 auto;padding:18px 16px 90px;}
    .pr-meta{font-size:.84rem;color:var(--deborah-semantic-color-text-muted);font-weight:600;margin-bottom:10px;}
    .pr-timer{
      font-family:ui-monospace,'SF Mono',Menlo,Consolas,monospace;font-weight:800;
      font-size:1.05rem;color:var(--deborah-semantic-color-status-warning, var(--deborah-semantic-color-action-primary));
      margin-bottom:12px;min-height:26px;
    }
    .pr-dots{display:flex;gap:6px;flex-wrap:wrap;margin:2px 0 16px;}
    .pr-dot{
      width:32px;height:32px;border-radius:9px;border:1.5px solid var(--deborah-semantic-color-border-default);
      background:var(--deborah-semantic-color-surface-raised);color:var(--deborah-semantic-color-text-secondary);
      font-size:.74rem;font-weight:800;cursor:pointer;font-family:inherit;
    }
    .pr-dot.done{background:var(--deborah-semantic-color-action-primary-soft, color-mix(in srgb, var(--deborah-semantic-color-action-primary) 14%, transparent));border-color:var(--deborah-semantic-color-action-primary);color:var(--deborah-semantic-color-text-primary);}
    .pr-dot.miss{background:rgba(180,83,9,.14);border-color:#b45309;color:#b45309;}
    .pr-dot.cur{outline:2px solid var(--deborah-semantic-color-action-primary);outline-offset:1px;}
    .pr-card{
      background:var(--deborah-semantic-color-surface-raised);
      border:1px solid var(--deborah-semantic-color-border-subtle);
      border-radius:var(--deborah-radius-lg, 18px);
      padding:20px;margin-bottom:14px;
      box-shadow:var(--shadow-lg, 0 10px 30px rgba(0,0,0,.06));
    }
    .pr-q{font-weight:800;font-size:1.05rem;line-height:1.45;margin-bottom:14px;color:var(--deborah-semantic-color-text-primary);}
    .pr-opt{
      display:flex;align-items:flex-start;gap:11px;
      border:1.5px solid var(--deborah-semantic-color-border-default);
      background:var(--deborah-semantic-color-surface-default);
      border-radius:12px;padding:12px 14px;margin-bottom:8px;cursor:pointer;
      font-size:.92rem;transition:border-color .12s ease, background-color .12s ease;
    }
    .pr-opt:hover{border-color:var(--deborah-semantic-color-action-primary);}
    .pr-opt.sel{border-color:var(--deborah-semantic-color-action-primary);background:var(--deborah-semantic-color-action-primary-soft, color-mix(in srgb, var(--deborah-semantic-color-action-primary) 12%, transparent));}
    .pr-opt input{margin-top:3px;accent-color:var(--deborah-semantic-color-action-primary);}
    .pr-opt b{color:var(--deborah-semantic-color-text-secondary);}
    .pr-nav{display:flex;gap:10px;justify-content:space-between;margin-top:16px;}
    .btn{border:0;border-radius:11px;padding:11px 18px;font-weight:700;font-size:.9rem;cursor:pointer;min-height:44px;font-family:inherit;text-decoration:none;}
    .btn-primary{background:var(--deborah-semantic-color-action-primary);color:var(--deborah-semantic-color-action-on-action,#fff);}
    .btn-primary:hover{background:var(--deborah-semantic-color-action-primary-hover);}
    .btn-quiet{background:var(--deborah-semantic-color-surface-nested);color:var(--deborah-semantic-color-text-secondary);border:1px solid var(--deborah-semantic-color-border-subtle);}
    .btn-quiet:hover{color:var(--deborah-semantic-color-text-primary);}
    .btn[disabled]{opacity:.5;cursor:not-allowed;}
    .pr-res-score{font-size:2.6rem;font-weight:900;text-align:center;color:var(--deborah-semantic-color-status-success,#16a34a);}
    .pr-res-sub{text-align:center;color:var(--deborah-semantic-color-text-muted);font-size:.9rem;font-weight:600;margin-bottom:18px;}
    .pr-review{border:1px solid var(--deborah-semantic-color-border-default);border-radius:12px;padding:12px 14px;margin-bottom:10px;}
    .pr-review.wrong{border-color:color-mix(in srgb, var(--deborah-semantic-color-text-danger) 45%, transparent);background:color-mix(in srgb, var(--deborah-semantic-color-text-danger) 7%, transparent);}
    .pr-review.right{border-color:color-mix(in srgb, var(--deborah-semantic-color-status-success) 45%, transparent);background:color-mix(in srgb, var(--deborah-semantic-color-status-success) 7%, transparent);}
    .pr-rv-q{font-weight:700;font-size:.9rem;margin-bottom:6px;}
    .pr-rv-o{font-size:.84rem;margin-left:10px;color:var(--deborah-semantic-color-text-secondary);}
    .pr-rv-o.ok{color:var(--deborah-semantic-color-status-success,#16a34a);font-weight:700;}
    .pr-rv-o.no{color:var(--deborah-semantic-color-text-danger,#dc2626);}
    .pr-rv-e{font-size:.78rem;color:var(--deborah-semantic-color-text-muted);margin-top:8px;border-top:1px dashed var(--deborah-semantic-color-border-subtle);padding-top:8px;}
    @media (max-width:560px){ .pr-wrap{padding:14px 10px 80px;} .pr-q{font-size:.95rem;} }
    @media print { .pr-top,.pr-nav,.no-print,.pr-dots{display:none !important;} body{background:#fff;} }

    /* ── 09/2026: Sinov — reklama-uslub yorqin sahna (Kahoot ruhida) ── */
    .pr-top { border-bottom: 1px solid var(--deborah-semantic-color-border-subtle); }
    .pr-opt {
      position: relative; overflow: hidden;
      border-left: 6px solid var(--accent, #4f46e5);
      transition: border-color .14s ease, background-color .14s ease, transform .14s ease, box-shadow .14s ease;
    }
    .pr-opt:nth-child(4n+1) { --accent:#4f46e5; --g1:#3730a3; --g2:#4f46e5; }
    .pr-opt:nth-child(4n+2) { --accent:#be123c; --g1:#9f1239; --g2:#be123c; }
    .pr-opt:nth-child(4n+3) { --accent:#b45309; --g1:#92400e; --g2:#a16207; }
    .pr-opt:nth-child(4n+4) { --accent:#7c3aed; --g1:#5b21b6; --g2:#7c3aed; }
    .pr-opt b { color: var(--accent); font-weight: 800; }
    .pr-opt:hover { transform: translateX(3px); box-shadow: 0 6px 16px rgba(0,0,0,.12); }
    .pr-opt.sel {
      border-left-color: transparent; color: #fff; font-weight: 700;
      background: linear-gradient(135deg, var(--g1), var(--g2)) !important;
      border-color: transparent; box-shadow: 0 10px 24px rgba(0,0,0,.22);
      animation: pr-pop .22s ease;
    }
    .pr-opt.sel b { color: #fff; }
    .pr-opt.sel input { accent-color: #fff; }
    @keyframes pr-pop { 0% { transform: scale(1); } 55% { transform: scale(1.03); } 100% { transform: scale(1); } }
    @media (prefers-reduced-motion: reduce) {
      .pr-opt, .pr-opt.sel { transition: none; animation: none; }
      .pr-opt:hover { transform: none; }
    }

    /* ── 09/2026 (user qarori): javobdan keyin DARHOL natija (Kahoot tarzi).
       Oldinga o'tish faqat javob berilgach; noto'g'ri = issiq jigarrang,
       to'g'ri = yashil. Qizil ko'z oladigan emas. ── */
    .pr-hint{
      display:none;align-items:center;gap:8px;margin:0 0 12px;padding:8px 12px;
      font-size:.82rem;font-weight:700;border-radius:10px;
      color:#b45309;background:color-mix(in srgb,#b45309 9%,transparent);
      border:1px solid rgba(180,83,9,.35);
    }
    .pr-hint.show{display:flex;}
    .pr-opt[data-st="dim"]{opacity:.55;pointer-events:none;}
    .pr-opt[data-st="right"]{
      background:color-mix(in srgb, var(--deborah-semantic-color-status-success,#16a34a) 10%,transparent) !important;
      border-color:var(--deborah-semantic-color-status-success,#16a34a) !important;
      border-left-color:var(--deborah-semantic-color-status-success,#16a34a) !important;
      box-shadow:0 0 0 1px var(--deborah-semantic-color-status-success,#16a34a);
      pointer-events:none;
    }
    .pr-opt[data-st="right"] b{color:var(--deborah-semantic-color-status-success,#16a34a);}
    .pr-opt[data-st="right"] .pr-chk{color:var(--deborah-semantic-color-status-success,#16a34a);}
    .pr-opt[data-st="wrong"]{
      background:color-mix(in srgb,#b45309 8%,transparent) !important;
      border-color:#b45309 !important;border-left-color:#b45309 !important;
      box-shadow:0 0 0 1px #b45309;
      pointer-events:none;
    }
    .pr-opt[data-st="wrong"] b,.pr-opt[data-st="wrong"] .pr-chk{color:#b45309;}
    .pr-opt .pr-chk{margin-left:auto;font-weight:900;font-size:1rem;align-self:center;}
    .pr-fb{
      display:flex;align-items:center;gap:10px;flex-wrap:wrap;
      margin:4px 0 14px;padding:11px 14px;border-radius:13px;
      font-weight:800;font-size:.92rem;
      animation:pr-fb-in .18s ease;
    }
    @keyframes pr-fb-in{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
    @media (prefers-reduced-motion: reduce){.pr-fb{animation:none}}
    .pr-fb.is-ok{
      color:var(--deborah-semantic-color-status-success,#16a34a);
      background:color-mix(in srgb, var(--deborah-semantic-color-status-success,#16a34a) 9%,transparent);
      border:1.5px solid color-mix(in srgb, var(--deborah-semantic-color-status-success,#16a34a) 45%,transparent);
    }
    .pr-fb.is-bad{
      color:#b45309;background:color-mix(in srgb,#b45309 9%,transparent);
      border:1.5px solid rgba(180,83,9,.4);
    }
    [data-resolved-theme="dark"] .pr-fb.is-bad,
    [data-theme="dark"] .pr-fb.is-bad{color:#e2a464;}
    .pr-fb-correct{margin-left:auto;font-size:.78rem;font-weight:700;color:var(--deborah-semantic-color-text-muted);}
    .pr-fb-correct b{color:var(--deborah-semantic-color-status-success,#16a34a);}
    .pr-next-ready{animation:pr-glow 1.3s ease 2;}
    @keyframes pr-glow{
      0%,100%{box-shadow:0 0 0 0 rgba(79,70,229,.0)}
      50%{box-shadow:0 0 0 7px rgba(79,70,229,.16)}
    }
    @media (prefers-reduced-motion: reduce){.pr-next-ready{animation:none}}
  </style>
</head>
<body>
  <header class="pr-top">
    <h1 class="pr-title">🎯 <%= practiceTitle %></h1>
    <span class="pr-badge"><%= pCopy.topBadge %></span>
    <a class="pr-back" href="/user/panel"><%= pCopy.back %></a>
  </header>
  <main class="pr-wrap">
    <div class="pr-meta"><%= pCopy.meta %></div>
    <div class="pr-timer" id="qtimer" aria-live="polite"></div>
    <div class="pr-dots" id="dots"></div>
    <div class="pr-hint" id="pr-hint" role="status" aria-live="polite"></div>
    <div id="quiz"></div>
    <div id="result" hidden></div>
  </main>

  <script>
    const QUESTIONS = <%- JSON.stringify(questions).replace(/</g, '\\u003c') %>;
    const CSRF = <%- JSON.stringify(csrfToken || '') %>;
    const SOURCE = <%- JSON.stringify(source) %>;
    const KEY = <%- JSON.stringify(key) %>;
    const CHUNK = <%- JSON.stringify(chunk) %>;
    const PC = <%- JSON.stringify(pCopy || {}) %>;
    const t = (k, fb) => (PC[k] !== undefined ? PC[k] : fb);
    const fill = (k, fb, map) => t(k, fb).split('{n}').join(map.n != null ? map.n : '').split('{m}').join(map.m != null ? map.m : '').split('{total}').join(map.total != null ? map.total : '').split('{correct}').join(map.correct != null ? map.correct : '').split('{title}').join(map.title != null ? map.title : '');

    /* 09/2026 (user qarori):
       — javobsiz savoldan oldinga o'tib bo'lmaydi (Next/Finish/dots bloklanadi);
       — javob tanlansa DARHOL to'g'ri/noto'g'ri natija chiqadi (Kahoot tarzi);
       — vaqt tugasa savol "o'tkazib yuborilgan" sifatida yopiladi va natija
         ko'rsatiladi (javob -1 — serverda noto'g'ri hisoblanadi). */
    /* S34o: URL'dan vaqt (soniya) — panel Sinov modalida tanlangan */
    const PER_Q_TIME = Math.max(0, parseInt(new URLSearchParams(location.search).get('time'), 10) || 0);
    const answers = new Array(QUESTIONS.length).fill(-1);  // tanlangan variant (yoki -1)
    const revealed = new Array(QUESTIONS.length).fill(false); // savol yopilgan (javob yoki vaqt)
    const missed = new Array(QUESTIONS.length).fill(false);   // vaqt tugab javobsiz qolgan
    let cur = 0;
    let timeLeft = PER_Q_TIME;
    let timerIv = null;

    function esc(s) { return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;'); }
    function correctOf(i) {
      const c = QUESTIONS[i] && QUESTIONS[i].correct;
      const n = QUESTIONS[i] && QUESTIONS[i].options ? QUESTIONS[i].options.length : 0;
      return Number.isInteger(c) && c >= 0 && c < n ? c : -1;
    }
    function hint(msg) {
      const h = document.getElementById('pr-hint');
      if (!h) return;
      h.textContent = '⚠ ' + msg;
      h.classList.add('show');
      clearTimeout(hint._iv);
      hint._iv = setTimeout(() => h.classList.remove('show'), 2600);
    }
    function clearTimer() { clearInterval(timerIv); timerIv = null; }
    function startTimer() {
      clearTimer();
      const el = document.getElementById('qtimer');
      if (!PER_Q_TIME || revealed[cur]) { if (el && !PER_Q_TIME) el.textContent = ''; return; }
      timeLeft = PER_Q_TIME;
      if (!el) return;
      const fmt = () => '⏱ ' + String(Math.floor(timeLeft / 60)).padStart(2, '0') + ':' + String(timeLeft % 60).padStart(2, '0');
      el.textContent = fmt();
      timerIv = setInterval(() => {
        timeLeft--;
        el.textContent = fmt();
        if (timeLeft <= 0) {
          clearTimer();
          el.textContent = '';
          if (!revealed[cur]) {
            missed[cur] = true;
            answers[cur] = -1;
            revealed[cur] = true;
            renderQ();
            renderDots();
          }
        }
      }, 1000);
    }

    const dots = document.getElementById('dots');
    function renderDots() {
      dots.innerHTML = QUESTIONS.map((_, i) => {
        let cls = 'pr-dot';
        if (revealed[i]) cls += ' done' + (missed[i] ? ' miss' : '');
        if (i === cur) cls += ' cur';
        const unlock = i === cur || revealed[i] || (i === cur + 1 && revealed[cur]);
        if (!unlock) cls += ' locked';
        return `<button type="button" class="${cls}" data-i="${i}" ${unlock ? '' : 'tabindex="-1" aria-disabled="true"'} aria-label="${fill('dotAria', 'Savol {n}', { n: i + 1 })}">${i + 1}</button>`;
      }).join('');
      dots.querySelectorAll('.pr-dot').forEach((d) => d.addEventListener('click', () => {
        const i = +d.dataset.i;
        if (i === cur || revealed[i] || (i === cur + 1 && revealed[cur])) { cur = i; renderQ(); renderDots(); }
        else hint(t('answerFirst', 'Avval savolga javob bering'));
      }));
    }

    const quiz = document.getElementById('quiz');
    function renderQ() {
      startTimer();
      const q = QUESTIONS[cur];
      const qc = correctOf(cur);
      const isRev = revealed[cur];
      const chosen = answers[cur];
      const opts = q.options.map((o, j) => {
        let st = '';
        if (isRev) {
          if (j === qc) st = 'right';
          else if (j === chosen) st = 'wrong';
          else st = 'dim';
        } else if (j === chosen) st = 'sel';
        const mark = isRev && j === qc ? '<span class="pr-chk">✓</span>'
          : (isRev && j === chosen && j !== qc ? '<span class="pr-chk">✗</span>' : '');
        return `<label class="pr-opt${st ? ' ' + st : ''}"${st ? ` data-st="${st}"` : ''}>
          <input type="radio" name="q${cur}" value="${j}" ${(j === chosen && !isRev) ? 'checked' : ''} ${isRev ? 'disabled tabindex="-1"' : ''}>
          <span><b>${String.fromCharCode(65 + j)})</b> ${esc(o)}</span>
          ${mark}
        </label>`;
      }).join('');

      let fb = '';
      if (isRev) {
        const okTxt = qc >= 0 ? `${t('correctIs', 'To‘g‘ri javob')}: <b>${String.fromCharCode(65 + qc)}) ${esc(q.options[qc])}</b>` : '';
        const who = missed[cur] ? 'miss' : (chosen === qc ? 'ok' : 'bad');
        const head = missed[cur] ? '⏱ ' + t('timedOut', 'Vaqt tugadi')
          : (chosen === qc ? '✅ ' + t('ok', 'To‘g‘ri!') : '❌ ' + t('notOk', 'Noto‘g‘ri'));
        fb = `<div class="pr-fb is-${who === 'ok' ? 'ok' : 'bad'}" role="status" aria-live="polite">
          <span>${head}</span>
          ${okTxt ? `<span class="pr-fb-correct">${okTxt}</span>` : ''}
        </div>`;
      }

      const isLast = cur === QUESTIONS.length - 1;
      const navBtn = isLast
        ? `<button type="button" class="btn btn-primary" id="finish" ${isRev ? '' : 'disabled'}>${t('finish', '✅ Yakunlash')}</button>`
        : `<button type="button" class="btn btn-primary${isRev ? ' pr-next-ready' : ''}" id="next" ${isRev ? '' : 'disabled'}>${t('next', 'Keyingi →')}</button>`;

      quiz.innerHTML = `
        <div class="pr-card">
          <div class="pr-q">${cur + 1} / ${QUESTIONS.length}. ${esc(q.text)}</div>
          ${opts}
          ${fb}
          <div class="pr-nav">
            <button type="button" class="btn btn-quiet" id="prev" ${cur === 0 ? 'disabled' : ''}>${t('prev', '← Oldingi')}</button>
            ${navBtn}
          </div>
        </div>`;
      quiz.querySelectorAll('input[type=radio]').forEach((r) => r.addEventListener('change', () => {
        if (revealed[cur]) return;
        answers[cur] = +r.value;
        missed[cur] = false;
        revealed[cur] = true;
        clearTimer();
        const qEl = document.getElementById('qtimer');
        if (qEl) qEl.textContent = '';
        renderQ(); // darhol natija
        renderDots();
      }));
      const prev = quiz.querySelector('#prev');
      if (prev) prev.addEventListener('click', () => { if (cur > 0) { cur--; renderQ(); renderDots(); } });
      const next = quiz.querySelector('#next');
      if (next) next.addEventListener('click', () => { if (revealed[cur] && cur < QUESTIONS.length - 1) { cur++; renderQ(); renderDots(); } });
      const fin = quiz.querySelector('#finish');
      if (fin) fin.addEventListener('click', () => { if (revealed[cur]) finish(); });
    }

    async function finish() {
      const unanswered = answers.filter((a) => a < 0).length;
      if (unanswered > 0 && !confirm(fill('finishAsk', '{n} ta savol javobsiz qoldi. Yakunlaymizmi?', { n: unanswered }))) return;
      try {
        const res = await fetch('/user/api/practice/grade', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
          body: JSON.stringify({ answers, source: SOURCE, key: KEY, chunk: CHUNK }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) { alert(t('errPrefix', 'Xato: ') + (data.error || res.status)); return; }
        showResult(data);
      } catch (e) { alert(t('netErr', 'Tarmoq xatosi')); }
    }

    function showResult(data) {
      document.getElementById('quiz').hidden = true;
      dots.hidden = true;
      const el = document.getElementById('result');
      el.hidden = false;
      el.innerHTML = `
        <div class="pr-card">
          <div class="pr-res-score">${data.percent}%</div>
          <div class="pr-res-sub">${fill('resSub', '{correct} / {total} to\'g\'ri javob', { correct: data.correct, total: data.total })}</div>
          <div style="text-align:center" class="no-print">
            <button type="button" class="btn btn-quiet" id="pr-print">${t('print', '🖨️ Chop etish')}</button>
            <a class="btn btn-primary" style="display:inline-block" href="/user/panel">${t('backPanel', '← Panelga qaytish')}</a>
          </div>
        </div>
        ${data.results.map((r, i) => {
          const q = QUESTIONS[i];
          return `<div class="pr-review ${r.isCorrect ? 'right' : 'wrong'}">
            <div class="pr-rv-q">${i + 1}. ${esc(q.text)} ${r.isCorrect ? '✅' : '❌'}</div>
            ${q.options.map((o, j) => `<div class="pr-rv-o${j === r.correctIndex ? ' ok' : j === r.given ? ' no' : ''}">${String.fromCharCode(65 + j)}) ${esc(o)}${j === r.correctIndex ? ' ✓' : j === r.given ? ' ' + t('yourAnswer', '← sizning javobingiz') : ''}</div>`).join('')}
            ${r.explanation ? `<div class="pr-rv-e">💡 ${esc(r.explanation)}</div>` : ''}
          </div>`;
        }).join('')}`;
    }

    const prPrint = document.getElementById('pr-print');
    if (prPrint) prPrint.addEventListener('click', () => window.print());

    renderDots();
    renderQ();
  </script>
</body>
</html>
