<!DOCTYPE html>
<html lang="<%= htmlLang || 'uz' %>" dir="ltr">
<head>
  <%- include('../partials/head') %>
  <title><%= pageTitle %> — Deborah</title>
  <style>
    body{background:var(--deborah-semantic-color-surface-default);min-height:100vh;transition:background .3s;}
    body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;background:radial-gradient(ellipse 55% 40% at 15% 20%,rgba(37,99,235,.1) 0%,transparent 65%),radial-gradient(ellipse 45% 35% at 85% 75%,rgba(56,189,248,.07) 0%,transparent 65%);}
    .navbar{position:sticky;top:0;z-index:100;background:var(--bg-overlay);backdrop-filter:blur(18px);border-bottom:1px solid var(--deborah-semantic-color-border-default);padding:10px 20px;display:flex;align-items:center;justify-content:space-between;transition:background .3s,border-color .3s;}
    .nav-logo{font-family:''Manrope'',cursive;font-size:1.25rem;text-decoration:none;display:flex;align-items:center;gap:6px;background:linear-gradient(135deg,var(--deborah-semantic-color-action-primary),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
    .nav-right{display:flex;align-items:center;gap:8px;}
    .nav-btn{padding:7px 12px;border-radius:9px;border:1px solid var(--deborah-semantic-color-border-default);background:var(--deborah-semantic-color-surface-input);color:var(--deborah-semantic-color-text-muted);font-family:'Source Sans 3',sans-serif;font-size:.78rem;font-weight:600;cursor:pointer;text-decoration:none;transition:color .2s,background-color .2s,border-color .2s,box-shadow .2s,transform .2s,opacity .2s;display:flex;align-items:center;gap:5px;}
    .nav-btn:hover{background:var(--bg-elevated);color:var(--deborah-semantic-color-text-primary);}
    .panel{max-width:720px;margin:0 auto;padding:24px 20px 80px;position:relative;z-index:1;}
    .greeting{font-family:''Manrope'',cursive;font-size:1.5rem;display:flex;align-items:center;gap:8px;margin-bottom:6px;}
    .greeting-sub{font-size:.82rem;color:var(--deborah-semantic-color-text-muted);font-weight:700;margin-bottom:20px;}
    .badge-card{background:var(--deborah-semantic-color-surface-raised);border-radius:18px;padding:20px;border:1px solid var(--deborah-semantic-color-border-default);display:flex;gap:16px;align-items:flex-start;margin-bottom:14px;animation:slideDown .35s ease;}
    .badge-icon{width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,var(--deborah-semantic-color-action-primary),var(--purple));display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#fff;box-shadow:var(--shadow-md);}
    .badge-code{font-family:''Manrope'',cursive;font-size:1.6rem;background:linear-gradient(135deg,var(--deborah-semantic-color-action-primary),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1;}
    .badge-label{font-weight:700;font-size:.95rem;margin:2px 0 4px;}
    .badge-desc{font-size:.8rem;color:var(--deborah-semantic-color-text-muted);font-weight:700;line-height:1.5;}
    .clamp-note{margin-top:8px;font-size:.72rem;font-weight:600;color:var(--gold);background:rgba(251,191,36,.08);border:1px solid rgba(251,191,36,.25);border-radius:8px;padding:6px 10px;display:inline-flex;gap:6px;align-items:center;}
    .sec-title{font-family:''Manrope'',cursive;font-size:1.05rem;display:flex;align-items:center;gap:8px;margin:18px 0 10px;}
    .req-list{display:flex;flex-direction:column;gap:8px;}
    .req-row{display:flex;align-items:center;gap:10px;background:var(--deborah-semantic-color-surface-input);border:1px solid var(--deborah-semantic-color-border-default);border-radius:11px;padding:11px 14px;transition:border-color .3s;}
    .req-row.fail{border-color:rgba(248,113,113,.4);background:rgba(248,113,113,.05);}
    .req-row.ok{border-color:rgba(0,229,160,.3);}
    .req-ico{flex-shrink:0;width:26px;height:26px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700;}
    .req-ico.fail{background:rgba(248,113,113,.15);color:var(--deborah-semantic-color-action-primary);}
    .req-ico.ok{background:rgba(0,229,160,.12);color:var(--green);}
    .req-ico.na{background:rgba(255,255,255,.06);color:var(--deborah-semantic-color-text-muted);}
    .req-name{font-size:.82rem;font-weight:700;}
    .req-detail{font-size:.72rem;color:var(--deborah-semantic-color-text-muted);font-weight:700;margin-top:1px;}
    .unsup-box{margin-top:12px;border-radius:12px;border:1px solid rgba(248,113,113,.3);background:rgba(248,113,113,.06);padding:13px 16px;}
    .unsup-h{font-size:.78rem;font-weight:700;color:var(--deborah-semantic-color-action-primary);display:flex;align-items:center;gap:6px;margin-bottom:8px;}
    .unsup-item{display:flex;align-items:center;gap:8px;font-size:.76rem;font-weight:600;color:var(--deborah-semantic-color-text-muted);padding:4px 0;}
    .verify-row{display:flex;gap:8px;align-items:center;margin-top:14px;flex-wrap:wrap;}
    .verify-inp{flex:1;min-width:180px;background:var(--deborah-semantic-color-surface-input);border:2px solid var(--deborah-semantic-color-border-default);border-radius:10px;padding:10px 13px;color:var(--deborah-semantic-color-text-primary);font-family:'Source Sans 3',sans-serif;font-size:.8rem;font-weight:700;outline:none;transition:border-color .3s;}
    .verify-inp:focus{border-color:var(--deborah-semantic-color-action-primary);}
    .verify-btn{border-radius:10px;border:none;padding:11px 16px;cursor:pointer;transition:color .3s ease,background-color .3s ease,border-color .3s ease,box-shadow .3s ease,transform .3s ease,opacity .3s ease;font-family:'Source Sans 3',sans-serif;font-weight:700;font-size:.8rem;background:var(--deborah-semantic-color-action-primary);color:var(--deborah-semantic-color-action-on-action,#041018);display:flex;align-items:center;gap:6px;}
    .verify-btn:hover{transform:translateY(-2px);box-shadow:var(--shadow-md);}
    .verify-btn:disabled{opacity:.5;cursor:not-allowed;transform:none;box-shadow:none;}
    .verdict{margin-top:10px;border-radius:10px;padding:10px 13px;font-size:.78rem;font-weight:600;border:1px solid var(--deborah-semantic-color-border-default);}
    .verdict.ok{color:var(--green);border-color:rgba(0,229,160,.3);background:rgba(0,229,160,.07);}
    .verdict.fail{color:var(--deborah-semantic-color-action-primary);border-color:rgba(248,113,113,.3);background:rgba(248,113,113,.07);}
    .spinner{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;display:inline-block;animation:spin .7s linear infinite;}
    @keyframes spin{to{transform:rotate(360deg)}}
    @keyframes slideDown{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:translateY(0)}}
    .assign-pick{width:100%;background:var(--deborah-semantic-color-surface-input);border:2px solid var(--deborah-semantic-color-border-default);border-radius:10px;padding:11px 14px;color:var(--deborah-semantic-color-text-primary);font-family:'Source Sans 3',sans-serif;font-size:.84rem;font-weight:600;outline:none;transition:border-color .3s;}
    .assign-pick:focus{border-color:var(--deborah-semantic-color-action-primary);}
    /* AUTH B-24: email change havolasi + izoh (inline visual style o'rniga klasslar) */
    .ec-change-link{display:flex;align-items:center;justify-content:center;text-decoration:none;}
    .ec-change-note{font-size:.72rem;color:var(--deborah-semantic-color-text-muted);font-weight:600;margin-top:6px;}
    .loading{text-align:center;padding:30px;color:var(--deborah-semantic-color-text-muted);font-weight:600;font-size:.84rem;}
    .empty{text-align:center;padding:26px;color:var(--deborah-semantic-color-text-muted);font-weight:700;font-size:.8rem;background:var(--deborah-semantic-color-surface-input);border-radius:14px;border:1px dashed var(--deborah-semantic-color-border-default);}
    @media(max-width:600px){.badge-card{flex-direction:column;}.verify-row{flex-direction:column;}.verify-btn{width:100%;justify-content:center;}}
  </style>
</head>
<% const _PC = typeof pageCopy !== 'undefined' ? pageCopy : null;
   const _PL = typeof pageLang !== 'undefined' ? pageLang : 'uz';
   const _pt = (k) => { const _v = _PC ? _PC[k] : null; if (!_v) return ''; return (_v[_PL] !== undefined) ? _v[_PL] : (_v.uz || ''); };
   const ac = (typeof accountCopy !== 'undefined' && accountCopy && accountCopy.account) || {}; %>
<body>
  <a href="#main" class="skip-link"><%= _pt('skip') %> →</a>
  <nav class="navbar">
    <a href="/" class="nav-logo"><img src="/images/logo-vintage.png" alt="Deborah" class="logo-img" style="height:34px;width:auto"></a>
    <div class="nav-right">
      <a href="/user/panel" class="nav-btn" style="text-decoration:none"><%- icon('book', 14) %> <%= _pt('navPanel') %></a>
      <a href="/sessions" class="nav-btn" style="text-decoration:none"><%- icon('monitor', 14) %> <%= _pt('navSessions') %></a>
      <button type="button" class="nav-btn" data-theme-toggle title="Light mode"><%- icon('moon', 16) %></button>
      <a href="/user/logout" class="nav-btn" style="text-decoration:none"><%- icon('logOut', 14) %> <%= _pt('navLogout') %></a>
    </div>
  </nav>

  <div class="panel" id="main">
    <div class="greeting"><img src="/images/logo-vintage.png" alt="Deborah" class="logo-img" style="height:30px;width:auto"> <%= _pt('h1') %></div>
    <div class="greeting-sub"><%= _pt('sub') %></div>

    <div class="sec-title" style="margin-top:0"><%- icon('monitor', 16) %> <%= _pt('sessTitle') %></div>
    <a href="/sessions" style="display:inline-flex;align-items:center;gap:6px;background:var(--deborah-semantic-color-surface-raised);border:1px solid var(--deborah-semantic-color-border-default);border-radius:11px;padding:11px 14px;color:var(--deborah-semantic-color-text-primary);font-size:.82rem;font-weight:700;text-decoration:none;min-height:44px;transition:border-color .2s,transform .2s">
      <%- icon('logOut', 14) %> <%= _pt('sessMore') %> →
    </a>
    <div style="font-size:.72rem;color:var(--deborah-semantic-color-text-muted);font-weight:600;margin-top:6px"><%= _pt('sessDesc') %></div>

    <% // 2026-08-27: MFA (Authenticator) faqat admin/o'qituvchi uchun %>
    <% const mfaAllowed = !!(user && (user.role === 'teacher' || user.role === 'admin')); %>
    <% if (mfaAllowed) { %>
    <% const ms = accountCopy.mfaSettings || {}; %>
    <div class="sec-title" style="margin-top:18px"><%- icon('shieldCheck', 16) %> <%= ms.title || 'Ikki bosqichli tekshiruv (MFA)' %></div>
    <!-- AUTH D-08 §15: data-copy — mfa-settings.js i18n (4 til) -->
    <div class="mfa-card" id="mfa-card" data-copy='<%= JSON.stringify(ms) %>' style="background:var(--deborah-semantic-color-surface-raised);border-radius:16px;padding:18px;border:1px solid var(--deborah-semantic-color-border-default);">
      <div id="mfa-status"><div class="loading"><span class="spinner" style="border-color:var(--deborah-semantic-color-text-muted);border-top-color:var(--deborah-semantic-color-action-primary)"></span></div></div>
      <div id="mfa-setup" style="display:none">
        <div style="display:flex;gap:14px;align-items:flex-start;flex-wrap:wrap;">
          <img id="mfa-qr" alt="QR" style="width:180px;border-radius:10px;background:#fff;padding:8px;display:none">
          <div style="flex:1;min-width:200px">
            <div style="font-size:.82rem;font-weight:700;margin-bottom:6px"><%= ms.step1 || '1. Autentifikator ilovasini skanerlang' %></div>
            <div style="font-size:.74rem;color:var(--deborah-semantic-color-text-muted);font-weight:600;margin-bottom:10px"><%= ms.manualKey || "QR skanerlanmasa, kalitni qo'lda kiriting:" %></div>
            <input class="verify-inp" id="mfa-secret" readonly style="width:100%;margin-bottom:10px">
            <div style="font-size:.82rem;font-weight:700;margin-bottom:6px"><%= ms.step2 || '2. Ilovadagi 6 xonali kodni kiriting' %></div>
            <div class="verify-row">
              <input class="verify-inp" id="mfa-token" placeholder="000000" inputmode="numeric" maxlength="6" style="text-align:center;letter-spacing:.4em">
              <button class="verify-btn" id="mfa-enable-btn" type="button"><%= ms.enable || 'Yoqish' %></button>
            </div>
            <div id="mfa-setup-err" class="verdict fail" style="display:none"></div>
          </div>
        </div>
      </div>
      <div id="mfa-backup" style="display:none">
        <div class="verdict ok" style="margin-top:0;margin-bottom:10px"><strong><%= ms.enabledTitle || 'MFA yoqildi!' %></strong> <%= ms.enabledIntro || "Quyidagi 10 ta backup kodni saqlang — telefon yo'qolsa ulardan foydalanasiz. Har biri faqat bir marta ishlaydi." %></div>
        <div id="mfa-backup-codes" style="display:grid;grid-template-columns:repeat(2,1fr);gap:6px;font-family:'Manrope',cursive;font-size:.95rem;font-weight:700;letter-spacing:.08em;margin-bottom:12px"></div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <button class="verify-btn" id="mfa-backup-download" type="button"><%- icon('download', 14) %> <%= ms.download || 'Yuklab olish' %></button>
          <!-- D-08 §07: [Print] — kodlarni chop etish -->
          <button class="verify-btn" id="mfa-backup-print" type="button" style="background:linear-gradient(135deg,#2563eb,#1d4ed8)"><%- icon('printer', 14) %> <%= ms.print || 'Chop etish' %></button>
        </div>
        <!-- D-08 §07: "Men saqladim" checkbox MAJBURIY — tanlanmasa davom etib bo'lmaydi -->
        <label style="display:flex;align-items:center;gap:8px;margin-top:12px;font-size:.8rem;font-weight:600;cursor:pointer">
          <input type="checkbox" id="mfa-backup-ack" style="width:18px;height:18px;accent-color:#059669">
          <span id="mfa-backup-ack-label"><%= ms.ackLabel || 'Men bu kodlarni xavfsiz joyda saqladim' %></span>
        </label>
        <button class="verify-btn" id="mfa-backup-done" type="button" disabled style="background:linear-gradient(135deg,#059669,#065f46);margin-top:10px;opacity:.5"><%= ms.ackBtn || 'Kodlarni saqladim' %></button>
      </div>
      <div id="mfa-manage" style="display:none">
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
          <span id="mfa-manage-status" class="badge-label" style="display:inline-flex;align-items:center;gap:6px;background:rgba(0,229,160,.1);color:var(--green);border:1px solid rgba(0,229,160,.3);border-radius:8px;padding:5px 10px;font-size:.74rem"><%= ms.active || '● Faol' %></span>
          <span id="mfa-backup-remaining" style="font-size:.74rem;color:var(--deborah-semantic-color-text-muted);font-weight:600"></span>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px">
          <button class="verify-btn" id="mfa-rotate-btn" type="button" style="background:linear-gradient(135deg,#d97706,#b45309)"><%- icon('refreshCw', 14) %> <%= ms.rotate || 'Backup kodlarni yangilash' %></button>
          <button class="verify-btn" id="mfa-disable-btn" type="button" style="background:linear-gradient(135deg,#dc2626,#991b1b)"><%- icon('power', 14) %> <%= ms.disable || "MFA'ni o'chirish" %></button>
        </div>
        <div id="mfa-manage-err" class="verdict fail" style="display:none"></div>
      </div>
    </div>
    <div style="font-size:.72rem;color:var(--deborah-semantic-color-text-muted);font-weight:600;margin-top:6px"><%= ms.footer || "MFA yoqilgan bo'lsa, har kirishda parol + 6 xonali kod talab qilinadi." %></div>
    <% } else { %>
    <div class="sec-title" style="margin-top:18px"><%- icon('shieldCheck', 16) %> <%= _pt('mfaTitle') %></div>
    <div class="mfa-card" style="background:var(--deborah-semantic-color-surface-raised);border-radius:16px;padding:18px;border:1px solid var(--deborah-semantic-color-border-default);">
      <div class="hemis-profile" style="font-size:.78rem;font-weight:600;line-height:1.6"><%= _pt('mfaNotNeeded') %></div>
    </div>
    <% } %>

    <% const pk = accountCopy.passkeySettings || {}; %>
    <div class="sec-title" style="margin-top:18px"><%- icon('key', 16) %> <%= pk.title || 'Passkeylar (parolsiz kirish)' %></div>
    <!-- AUTH D-08: data-copy — passkey-settings.js i18n (4 til, §15) -->
    <div class="mfa-card" id="passkey-card" data-copy='<%= JSON.stringify(pk) %>' style="background:var(--deborah-semantic-color-surface-raised);border-radius:16px;padding:18px;border:1px solid var(--deborah-semantic-color-border-default);">
      <div style="font-size:.74rem;color:var(--deborah-semantic-color-text-muted);font-weight:600;margin-bottom:12px"><%= pk.desc || "Qurilmangizdagi biometrik (barmoq izi / Face ID) yoki xavfsizlik kaliti bilan tez va phishing'ga chidamli kirish (NIST AAL2+). Parol bilan kirish har doim saqlanadi." %></div>
      <!-- D-08 §13: jonli ro'yxat — screen reader'ga e'lon qilinadi -->
      <div id="passkey-list" role="status" aria-live="polite"><div class="loading"><span class="spinner" style="border-color:var(--deborah-semantic-color-text-muted);border-top-color:var(--deborah-semantic-color-action-primary)"></span></div></div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px">
        <button class="verify-btn" id="passkey-add-btn" type="button" style="min-height:44px"><%- icon('key', 14) %> <%= pk.add || "Yangi passkey qo'shish" %></button>
      </div>
      <div id="passkey-err" class="verdict fail" role="alert" style="display:none"></div>
      <div id="passkey-reauth" style="display:none;margin-top:12px">
        <div style="font-size:.82rem;font-weight:700;margin-bottom:6px"><%- icon('shieldCheck', 13) %> <%= pk.reauthTitle || 'Xavfsizlik uchun parolingizni tasdiqlang' %></div>
        <div class="verify-row">
          <input class="verify-inp" id="passkey-reauth-pw" type="password" placeholder="<%= pk.reauthPlaceholder || 'Parol' %>" autocomplete="current-password" style="min-width:180px">
          <button class="verify-btn" id="passkey-reauth-btn" type="button" style="min-height:44px"><%= pk.reauthSubmit || 'Tasdiqlash' %></button>
        </div>
        <div id="passkey-reauth-err" class="verdict fail" role="alert" style="display:none"></div>
      </div>
    </div>
    <div style="font-size:.72rem;color:var(--deborah-semantic-color-text-muted);font-weight:600;margin-top:6px"><%= pk.recoveryNote || "Passkey yo'qolsa — parol + email orqali tiklash (MFA backup kodlari ham ishlaydi)." %></div>


    <!-- AUTH A-29: password change -->
    <div class="sec-title" style="margin-top:18px"><%- icon('key', 16) %> <%= ac.passwordChangeTitle || 'Parolni o\'zgartirish' %></div>
    <div class="mfa-card">
      <div style="display:flex;flex-direction:column;gap:10px;max-width:420px">
        <input class="verify-inp" id="pw-current" type="password" placeholder="<%= ac.currentPassword || 'Joriy parol' %>" autocomplete="current-password">
        <input class="verify-inp" id="pw-new" type="password" placeholder="<%= ac.newPassword || 'Yangi parol' %>" autocomplete="new-password">
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
          <button class="verify-btn" id="pw-change-btn" type="button"><%- icon('check', 14) %> <%= ac.changePasswordBtn || 'Parolni o\'zgartirish' %></button>
        </div>
        <div id="pw-msg" class="verdict" style="display:none"></div>
      </div>
    </div>

    <!-- AUTH B-24: email change (reauth + double opt-in) — yangi sahifaga havola -->
    <div class="sec-title" style="margin-top:18px"><%- icon('mail', 16) %> <%= ac.emailChangeTitle || 'Email manzilini o\'zgartirish' %></div>
    <div class="mfa-card">
      <div style="display:flex;flex-direction:column;gap:10px;max-width:420px">
        <div style="font-size:.78rem;color:var(--deborah-semantic-color-text-muted)"><%= ac.currentEmail || 'Joriy email' %>: <strong><%= userEmail || '—' %></strong></div>
        <a href="/user/email-change" class="verify-btn ec-change-link"><%- icon('mail', 14) %> <%= ac.emailChangeBtn || 'Emailni o\'zgartirish' %></a>
        <div class="ec-change-note"><%= ac.emailChangeNote || 'Xavfsizlik uchun parol qayta tasdiqlanadi va ikkala email manzili tasdiqlanadi' %></div>
      </div>
    </div>

    <!-- AUTH A-29: security events feed (PII-minimal) -->
    <div class="sec-title" style="margin-top:18px"><%- icon('shieldCheck', 16) %> <%= ac.eventsTitle || 'Xavfsizlik hodisalari' %></div>
    <div class="mfa-card">
      <div id="events-list"><div class="loading"><span class="spinner" style="border-color:var(--deborah-semantic-color-text-muted);border-top-color:var(--deborah-semantic-color-action-primary)"></span></div></div>
    </div>

    <% if (user && user.role === 'student') { %>
    <div class="sec-title" style="margin-top:18px"><%- icon('layers', 16) %> <%= _pt('assessTitle') %></div>
    <select class="assign-pick" id="assign-pick">
      <option value=""><%= _pt('assessPick') %></option>
    </select>

    <div id="content"><div class="loading"><span class="spinner" style="border-color:var(--deborah-semantic-color-text-muted);border-top-color:var(--deborah-semantic-color-action-primary)"></span> <%= _pt('loading') %></div></div>
    <% } %>
  </div>

  <script src="/js/security-profile.js"></script>
  <% if (mfaAllowed) { %><script src="/js/mfa-settings.js"></script><% } %><% /* BUG-011: mfa-settings.js faqat MFA bloki render qilinganda yuklanadi */ %>
  <script src="/js/passkey-settings.js"></script>
  <script src="/js/account-settings.js" defer></script>
  <script>
    // AUTH A-29: account copy (i18n) — account-settings.js ishlatadi
    window.__ACCOUNT_COPY__ = <%- JSON.stringify(accountCopy?.account || {}) .replace(/</g, '\\u003c') %>;
  </script>
</body>
</html>
