<!DOCTYPE html>
<html lang="<%= lang === 'uz-cyrl' ? 'uz-Cyrl' : lang %>" dir="ltr">
<head>
  <%- include('../partials/head') %>
  <style>
    .sec-page{min-height:100vh;background:var(--deborah-semantic-color-surface-default,#0b1020);color:var(--deborah-semantic-color-text-primary,#e8ecf4);padding:30px 20px 60px;max-width:760px;margin:0 auto;}
    .sec-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:8px;flex-wrap:wrap;}
    .sec-title{font-family:var(--font-display,'Manrope',sans-serif);font-size:1.35rem;margin:0;}
    .sec-sub{color:var(--deborah-semantic-color-text-muted,#8b93a7);font-size:.82rem;font-weight:600;margin-bottom:22px;max-width:560px;}
    .sec-back{display:inline-flex;align-items:center;gap:6px;color:var(--deborah-semantic-color-text-muted,#8b93a7);font-size:.8rem;font-weight:700;text-decoration:none;padding:10px 12px;border-radius:10px;min-height:40px;transition:color .2s,background-color .2s;}
    .sec-back:hover{color:var(--deborah-semantic-color-text-primary,#e8ecf4);background:var(--deborah-semantic-color-surface-raised,#141b2e);}
    .lang-row{display:flex;gap:2px;justify-content:flex-end;}
    .lang-link{padding:6px 10px;border-radius:8px;font-size:.72rem;font-weight:700;color:var(--deborah-semantic-color-text-muted,#8b93a7);text-decoration:none;min-height:32px;display:inline-flex;align-items:center;transition:color .2s,background-color .2s;}
    .lang-link:hover{color:var(--deborah-semantic-color-text-primary,#e8ecf4);background:rgba(255,255,255,.05);}
    .lang-link.on{background:var(--deborah-semantic-color-action-primary,#2563eb);color:var(--deborah-semantic-color-action-on-action,#041018);}
    .msg{border-radius:10px;padding:10px 14px;font-size:.8rem;font-weight:700;margin-bottom:16px;display:none;}
    .msg.err{background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.25);color:#f87171;display:block;}
    .msg.ok{background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.25);color:#4ade80;display:block;}
    .sess-sep{height:1px;background:var(--deborah-semantic-color-divider,rgba(125,125,125,.2));margin:6px 0;border-radius:1px}
    .sess-list{display:flex;flex-direction:column;gap:12px;}
    .sess-card{background:var(--deborah-semantic-color-surface-raised,#141b2e);border:1px solid var(--deborah-semantic-color-border-subtle,#1f2a44);border-radius:18px;padding:18px;display:flex;align-items:center;gap:16px;transition:border-color .2s,transform .2s;}
    .sess-card:hover{border-color:var(--deborah-semantic-color-border-default,#2b3a5e);}
    .sess-icon{flex-shrink:0;width:46px;height:46px;border-radius:14px;background:var(--deborah-semantic-color-action-primary,#2563eb);display:flex;align-items:center;justify-content:center;color:#fff;}
    .sess-icon.cur{background:rgba(34,197,94,.15);color:#4ade80;}
    .sess-body{flex:1;min-width:0;}
    .sess-name{font-weight:800;font-size:.95rem;display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
    .sess-meta{color:var(--deborah-semantic-color-text-muted,#8b93a7);font-size:.76rem;font-weight:600;margin-top:3px;display:flex;gap:10px;flex-wrap:wrap;}
    .sess-time{color:var(--deborah-semantic-color-text-muted,#8b93a7);font-size:.72rem;font-weight:600;margin-top:2px;}
    .badge-cur{background:rgba(34,197,94,.15);color:#4ade80;font-size:.68rem;font-weight:800;padding:3px 9px;border-radius:99px;text-transform:uppercase;letter-spacing:.4px;}
    .badge-method{background:rgba(37,99,235,.12);color:#60a5fa;font-size:.66rem;font-weight:700;padding:2px 8px;border-radius:99px;}
    .sess-action{flex-shrink:0;}
    .btn-revoke{background:transparent;border:1px solid var(--deborah-semantic-color-border-default,#2b3a5e);color:var(--deborah-semantic-color-text-primary,#e8ecf4);font-size:.78rem;font-weight:700;padding:0 16px;min-height:44px;border-radius:12px;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:border-color .2s,background-color .2s,color .2s,transform .2s;}
    .btn-revoke:hover:not(:disabled){border-color:#ef4444;color:#f87171;background:rgba(239,68,68,.08);}
    .btn-revoke:disabled{opacity:.45;cursor:not-allowed;}
    .btn-revoke-all{width:100%;background:transparent;border:1px solid #ef4444;color:#f87171;font-size:.85rem;font-weight:800;min-height:48px;border-radius:14px;cursor:pointer;margin-top:20px;display:flex;align-items:center;justify-content:center;gap:8px;transition:background-color .2s,color .2s,transform .2s;}
    .btn-revoke-all:hover{background:rgba(239,68,68,.12);}
    .sec-hint{display:flex;align-items:center;gap:8px;color:var(--deborah-semantic-color-text-muted,#8b93a7);font-size:.74rem;font-weight:600;margin-top:14px;}
    .sec-empty{text-align:center;color:var(--deborah-semantic-color-text-muted,#8b93a7);font-size:.85rem;font-weight:600;padding:40px 0;}
    .skip-link{position:absolute;left:-999px;top:0;background:var(--deborah-semantic-color-action-primary,#2563eb);color:var(--deborah-semantic-color-action-on-action,#041018);padding:10px 16px;border-radius:0 0 10px 0;font-weight:700;font-size:.8rem;text-decoration:none;z-index:1000;}
    .skip-link:focus{left:0;}
    @media(max-width:600px){
      .sess-card{flex-direction:column;align-items:flex-start;gap:12px;}
      .sess-action{width:100%;}
      .btn-revoke{width:100%;justify-content:center;}
      .sec-title{font-size:1.15rem;}
    }
  </style>
</head>
<body>
  <a href="#main" class="skip-link"><%= copy.sessions.title %> →</a>
  <main class="sec-page" id="main">
    <div class="sec-top">
      <div>
        <h1 class="sec-title"><%= copy.sessions.title %></h1>
      </div>
      <div class="lang-row" aria-label="Language">
        <% AUTH_LANGS.forEach(function(l){ %>
          <a class="lang-link <%= l === lang ? 'on' : '' %>" href="?lang=<%= l %>" hreflang="<%= l === 'uz-cyrl' ? 'uz-Cyrl' : l %>"><%= l === 'uz' ? 'O\'zbek' : (l === 'uz-cyrl' ? 'Ўзбекча' : (l === 'ru' ? 'Русский' : 'English')) %></a>
        <% }); %>
      </div>
    </div>
    <div class="sec-sub"><%= copy.sessions.sub %></div>

    <div id="msg-box" class="msg" role="status" aria-live="polite"></div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="msg err" role="alert"><%= error %></div>
    <% } %>

    <% if (!sessions.length) { %>
      <div class="sec-empty"><%= copy.sessions.empty %></div>
    <% } else { %>
      <div class="sess-list">
        <% var prevGroup = null; %>
        <% sessions.forEach(function(s){ %>
          <% var isCurrent = s.sessionId === currentSessionId; %>
          <% var grp = (s.device || '?') + '|' + (s.browser || '?') + '|' + (s.ipHash || ''); %>
          <% if (grp !== prevGroup && prevGroup !== null) { %><div class="sess-sep" role="separator"></div><% } %>
          <% var dupOfPrev = grp === prevGroup; prevGroup = grp; %>
          <div class="sess-card" data-session-key="<%= s.key %>">
            <div class="sess-icon <%= isCurrent ? 'cur' : '' %>">
              <%- icon(isCurrent ? 'check' : 'monitor', 22) %>
            </div>
            <div class="sess-body">
              <div class="sess-name">
                <%= s.noUa ? copy.sessions.noUaDevice : (dupOfPrev ? copy.sessions.sameDeviceMore : (s.device || copy.sessions.unknownDevice)) %>
                <% if (isCurrent) { %><span class="badge-cur"><%= copy.sessions.current %> ✓</span><% } %>
                <span class="badge-method"><%= s.authMethod %></span>
              </div>
              <div class="sess-meta">
                <span><%= copy.sessions.browser %>: <%= s.browser || copy.sessions.unknownBrowser %></span>
                <% if (s.ipHash) { %><span><%= copy.sessions.ip %>: <code style="font-size:.72rem"><%= s.ipHash.slice(0, 12) %>…</code></span><% } %>
              </div>
              <div class="sess-time"><%= copy.sessions.lastActive %>: <%= timeAgo(s.lastActiveAt) %></div>
            </div>
            <% if (!isCurrent) { %>
            <div class="sess-action">
              <form method="POST" action="/sessions/<%= encodeURIComponent(s.sessionId) %>/revoke" data-confirm="1">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="lang" value="<%= lang %>">
                <button type="submit" class="btn-revoke" data-analytics="session_revoke"><%- icon('logOut', 15) %> <%= copy.sessions.revoke %></button>
              </form>
            </div>
            <% } %>
          </div>
        <% }); %>
      </div>

      <% /* 09/2026 (user qarori): tugma 'Boshqa barchasini o'chirish' — joriy
            qurilma O'ZI o'chirilmaydi (server ham faqat boshqalarni yakunlaydi).
            Boshqa sessiya bo'lmasa tugma ko'rsatilmaydi. */ %>
      <% const othersCount = sessions.filter(function (s) { return s.sessionId !== currentSessionId; }).length; %>
      <% if (othersCount > 0) { %>
      <form method="POST" action="/sessions/revoke-all" data-confirm-all="<%= copy.sessions.revokeAllConfirm %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="lang" value="<%= lang %>">
        <button type="submit" class="btn-revoke-all" data-analytics="session_revoke_all"><%- icon('shield', 16) %> <%= copy.sessions.revokeAll %></button>
      </form>
      <% } else { %>
      <div class="sec-hint"><%- icon('check', 14) %> <%= copy.sessions.noOthers %></div>
      <% } %>

      <div class="sec-hint"><%- icon('info', 14) %> <%= copy.sessions.hint %></div>
    <% } %>

    <div style="margin-top:26px">
      <a class="sec-back" href="/user/security-profile?lang=<%= lang %>">← <%= copy.sessions.back %></a>
    </div>
  </main>

  <script>
  (function () {
    'use strict';
    var msgBox = document.getElementById('msg-box');
    function showMsg(text, ok) {
      msgBox.textContent = text || '';
      msgBox.className = 'msg ' + (ok ? 'ok' : 'err');
      msgBox.style.display = text ? 'block' : 'none';
    }
    function onFormSubmit(e) {
      var form = e.target.closest('form[data-confirm], form[data-confirm-all]');
      if (!form || e.submitter && e.submitter.form !== form && !form.contains(e.submitter)) return;
      var confirmText = form.getAttribute('data-confirm-all') || '<%= copy.sessions.revoke %>?';
      if (!window.confirm(confirmText)) {
        e.preventDefault();
        return;
      }
      e.preventDefault();
      var btn = form.querySelector('button[type="submit"]');
      if (btn) btn.disabled = true;
      var fd = new FormData(form);
      fetch(form.action, { method: 'POST', body: fd, credentials: 'same-origin', redirect: 'manual' })
        .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return { status: r.status, body: j }; }); })
        .then(function (res) {
          if (res.status === 401) { showMsg('<%= copy.errors.session %>', false); }
          else if (res.body && res.body.ok) {
            showMsg('<%= copy.sessions.revoked %>', true);
            setTimeout(function () { window.location.href = '/sessions?lang=<%= lang %>'; }, 700);
          } else if (res.body && res.body.redirect) {
            window.location.href = res.body.redirect;
          } else {
            showMsg('<%= copy.errors.server %>', false);
            if (btn) btn.disabled = false;
          }
        })
        .catch(function () { showMsg('<%= copy.errors.network %>', false); if (btn) btn.disabled = false; });
    }
    document.addEventListener('submit', onFormSubmit);
  })();
  </script>
</body>
</html>
