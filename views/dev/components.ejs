<!DOCTYPE html>
<html lang="uz" dir="ltr" data-theme="light">
<head>
  <%- include('../partials/head') %>
  <style>
    body { padding: 24px; }
    .row { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-bottom: 24px; }
    .group { margin-bottom: 32px; }
    .group h2 { font-size: 18px; margin-bottom: 12px; opacity: .8; }
  </style>
</head>
<body>
  <h1>Deborah Components</h1>

  <section class="group" id="group-variants">
    <h2>Variantlar (S12.01)</h2>
    <div class="row">
      <button type="button" class="btn btn-primary"><span class="btn-label">Primary</span></button>
      <button type="button" class="btn btn-secondary"><span class="btn-label">Secondary</span></button>
      <button type="button" class="btn btn-quiet"><span class="btn-label">Quiet</span></button>
      <button type="button" class="btn btn-danger"><span class="btn-label">Danger</span></button>
      <button type="button" class="btn btn-link"><span class="btn-label">Link</span></button>
    </div>
  </section>

  <section class="group" id="group-sizes">
    <h2>Size'lar (S12.02)</h2>
    <div class="row">
      <button type="button" class="btn btn-primary btn-sm"><span class="btn-label">32px</span></button>
      <button type="button" class="btn btn-primary"><span class="btn-label">44px</span></button>
      <button type="button" class="btn btn-primary btn-lg"><span class="btn-label">48px</span></button>
      <button type="button" class="btn btn-primary btn-xl"><span class="btn-label">48px</span></button>
    </div>
  </section>

  <section class="group" id="group-states">
    <h2>States (S12.03–05)</h2>
    <div class="row">
      <button type="button" class="btn btn-primary"><span class="btn-label">Hover/Active</span></button>
      <button type="button" class="btn btn-primary is-loading" disabled><span class="spinner"></span><span class="btn-label">Loading</span></button>
      <button type="button" class="btn btn-primary" disabled><span class="btn-label">Disabled</span></button>
      <button type="button" class="btn btn-primary is-selected"><span class="btn-label">Selected</span></button>
      <button type="button" class="btn btn-quiet is-selected" aria-pressed="true"><span class="btn-label">Pressed</span></button>
    </div>
  </section>

  <section class="group" id="group-icon-buttons">
    <h2>Icon Button (S12.07–08)</h2>
    <div class="row">
      <button type="button" class="icon-btn" aria-label="Qidirish" data-tip="Qidirish"><%- icon('search', 20) %></button>
      <button type="button" class="icon-btn" aria-label="Sozlamalar" data-tip="Sozlamalar"><%- icon('settings', 20) %></button>
      <button type="button" class="icon-btn is-selected" aria-label="Yoqilgan" aria-pressed="true" data-tip="Yoqilgan"><%- icon('bell', 20) %></button>
    </div>
  </section>

  <section class="group" id="group-badges">
    <h2>Badge (S12.09)</h2>
    <div class="row">
      <span class="badge badge-neutral">Neytral</span>
      <span class="badge badge-info">Info</span>
      <span class="badge badge-success">Muvaffaqiyat</span>
      <span class="badge badge-warning">Ogohlantirish</span>
      <span class="badge badge-danger">Xato</span>
    </div>
  </section>

  <section class="group" id="group-long-label">
    <h2>Long label (S12)</h2>
    <div class="row">
      <button type="button" class="btn btn-primary" id="long-label-btn"><span class="btn-label">Juda uzun matnli tugma — bu matn hech qachon kesilmasligi kerak, qanchalik uzun bo‘lsa ham to‘liq ko‘rinishi shart</span></button>
    </div>
  </section>

  <section class="group" id="group-forms">
    <h2>Form Field (S13)</h2>
    <form class="form-stack" id="test-form" novalidate>
      <%- include('../partials/components/form-field', {
        id: 'f-name', name: 'name', label: 'Ism', required: true,
        placeholder: 'masalan: Aziza', hint: '3-30 belgi', maxlength: 30,
        autocomplete: 'name',
      }) %>
      <%- include('../partials/components/form-field', {
        id: 'f-email', name: 'email', type: 'email', label: 'Email', required: true,
        placeholder: 'aziza@example.com', autocomplete: 'email', inputmode: 'email',
      }) %>
      <%- include('../partials/components/form-field', {
        id: 'f-role', name: 'role', type: 'select', label: 'Rol', required: true,
        options: [{ value: '', label: '— tanlang —' }, { value: 'student', label: 'O‘quvchi' }, { value: 'teacher', label: 'O‘qituvchi' }],
      }) %>
      <%- include('../partials/components/form-field', {
        id: 'f-note', name: 'note', type: 'textarea', label: 'Izoh', optional: 'ixtiyoriy',
        hint: 'Kengaytirilgan izoh', maxlength: 200,
      }) %>
      <div class="form-field form-field--error">
        <label class="form-field__label" for="f-bad"><span>Xatoli maydon</span><span class="form-field__required" style="color:var(--deborah-semantic-color-status-danger)">*</span></label>
        <input class="form-control" id="f-bad" name="bad" type="text" aria-invalid="true" aria-describedby="f-bad-error" value="xato qiymat">
        <span class="form-field__error" id="f-bad-error" role="alert"><%- icon('alertTriangle', 14) %><span>Bu maydon noto‘g‘ri to‘ldirildi — iltimos qayta tekshiring va qisqaroq, aniqroq ma’lumot kiriting.</span></span>
      </div>
      <div class="form-field form-field--warning">
        <label class="form-field__label" for="f-warn"><span>Ogohlantirish</span></label>
        <input class="form-control" id="f-warn" name="warn" type="text" value="eski format" aria-describedby="f-warn-error">
        <span class="form-field__error" id="f-warn-error" style="color:var(--deborah-semantic-color-status-warning)">Bu qiymat eskirgan formatda — yangilash tavsiya etiladi</span>
      </div>
      <div class="form-field">
        <label class="form-field__label" for="f-ro"><span>Faqat o‘qish</span></label>
        <input class="form-control" id="f-ro" name="ro" type="text" value="read-only qiymat" readonly>
      </div>
      <div class="form-field form-field--disabled">
        <label class="form-field__label" for="f-dis"><span>O‘chirilgan</span></label>
        <input class="form-control" id="f-dis" name="dis" type="text" value="disabled" disabled>
      </div>
    </form>
  </section>

  <section class="group" id="group-selection">
    <h2>Selection (S14)</h2>
    <fieldset style="border:none;padding:0;margin:0 0 24px">
      <legend style="font-weight:700;margin-bottom:8px">Radio — javob turi</legend>
      <label class="choice choice--radio">
        <input class="choice__input" type="radio" name="s14-radio" value="a" checked>
        <span class="choice__mark" aria-hidden="true"></span>
        <span class="choice__label"><span class="choice__title">Yagona javob</span><span class="choice__desc">One-of-many — test savoli</span></span>
      </label>
      <label class="choice choice--radio">
        <input class="choice__input" type="radio" name="s14-radio" value="b">
        <span class="choice__mark" aria-hidden="true"></span>
        <span class="choice__label"><span class="choice__title">Moslik</span><span class="choice__desc">Juftlashtirish savoli</span></span>
      </label>
    </fieldset>
    <div style="margin-bottom:24px">
      <label class="choice choice--checkbox">
        <input class="choice__input" type="checkbox" name="s14-check" checked>
        <span class="choice__mark" aria-hidden="true"></span>
        <span class="choice__label"><span class="choice__title">Foydali maslahatlar</span><span class="choice__desc">Independent choice</span></span>
      </label>
    </div>
    <div style="margin-bottom:24px" data-pending-switch>
      <label class="switch">
        <input class="switch__input" type="checkbox" role="switch" name="s14-switch" id="s14-switch">
        <span class="switch__track" aria-hidden="true"><span class="switch__thumb"></span></span>
        <span class="switch__label"><span class="choice__title">Jonli natijalar</span></span>
      </label>
    </div>
    <div style="margin-bottom:24px">
      <span style="font-weight:700;display:block;margin-bottom:8px">Selectable card</span>
      <label class="select-card">
        <input class="select-card__input" type="radio" name="s14-card" value="compact" checked>
        <span class="select-card__body">
          <span class="select-card__mark" aria-hidden="true"></span>
          <span class="select-card__content">
            <span class="select-card__title">Kompakt rejim</span>
            <span class="select-card__desc">Kichik ekranlar uchun ixcham variant</span>
          </span>
        </span>
      </label>
      <label class="select-card" style="margin-top:8px">
        <input class="select-card__input" type="radio" name="s14-card" value="full">
        <span class="select-card__body">
          <span class="select-card__mark" aria-hidden="true"></span>
          <span class="select-card__content">
            <span class="select-card__title">To‘liq rejim</span>
            <span class="select-card__desc">Barcha funksiyalar bilan</span>
          </span>
        </span>
      </label>
      <label class="select-card" style="margin-top:8px">
        <input class="select-card__input" type="radio" name="s14-card" value="disabled" disabled aria-describedby="s14-card-disabled-note">
        <span class="select-card__body">
          <span class="select-card__mark" aria-hidden="true"></span>
          <span class="select-card__content">
            <span class="select-card__title">Bloklangan rejim</span>
            <span class="select-card__desc" id="s14-card-disabled-note">Bu rejim faqat VIP hisobda ochiladi</span>
          </span>
        </span>
      </label>
    </div>
  </section>

  <section class="group" id="group-tabs">
    <h2>Tabs (S14.07)</h2>
    <div class="tabs" data-tabs>
      <div class="tablist" role="tablist" aria-label="Namuna tabs">
        <button class="tab" type="button" role="tab" id="t-a" aria-selected="true" aria-controls="tp-a">Natijalar</button>
        <button class="tab" type="button" role="tab" id="t-b" aria-selected="false" aria-controls="tp-b" tabindex="-1">Tahlil</button>
        <button class="tab" type="button" role="tab" id="t-c" aria-selected="false" aria-controls="tp-c" tabindex="-1">Sozlamalar</button>
      </div>
      <div class="tabpanel" id="tp-a" role="tabpanel" aria-labelledby="t-a">Natijalar paneli — birinchi tab</div>
      <div class="tabpanel" id="tp-b" role="tabpanel" aria-labelledby="t-b" hidden>tahlil paneli — ikkinchi tab</div>
      <div class="tabpanel" id="tp-c" role="tabpanel" aria-labelledby="t-c" hidden>Sozlamalar paneli — uchinchi tab</div>
    </div>
  </section>

  <section class="group" id="group-accordion">
    <h2>Accordion (S14.09)</h2>
    <div data-accordion="single">
      <div class="accordion">
        <h3 class="accordion__header"><button class="accordion__trigger" type="button" aria-expanded="true" aria-controls="acc-1"><span>Savollar bazasi</span><span class="accordion__icon"><%- icon('chevronDown', 16) %></span></button></h3>
        <div class="accordion__panel" id="acc-1"><div class="accordion__panel-inner"><div class="accordion__panel-content">Ochiq panel — birinchi bo‘lim matni shu yerda.</div></div></div>
      </div>
      <div class="accordion">
        <h3 class="accordion__header"><button class="accordion__trigger" type="button" aria-expanded="false" aria-controls="acc-2"><span>Ball hisobi</span><span class="accordion__icon"><%- icon('chevronDown', 16) %></span></button></h3>
        <div class="accordion__panel" id="acc-2"><div class="accordion__panel-inner"><div class="accordion__panel-content">Yopiq panel — ikkinchi bo‘lim matni.</div></div></div>
      </div>
    </div>
  </section>

  <section class="group" id="group-overlays">
    <h2>Dialog (S15.01)</h2>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <button type="button" class="btn btn-primary" data-confirm-demo>Confirm dialog</button>
      <button type="button" class="btn btn-secondary" data-toast-success>Toast: success</button>
      <button type="button" class="btn btn-secondary" data-toast-error>Toast: error</button>
    </div>

    <h2 style="margin-top:24px">Popover (S15.07)</h2>
    <div style="position:relative;display:inline-block">
      <button type="button" class="btn btn-secondary" data-popover aria-expanded="false" aria-controls="s15-pop">Menyu ochish</button>
      <div class="popover" id="s15-pop" role="menu" aria-label="Amallar">
        <button type="button" class="popover__item" role="menuitem">Tahrirlash</button>
        <button type="button" class="popover__item" role="menuitem">Nusxalash</button>
        <div class="popover__sep"></div>
        <button type="button" class="popover__item popover__item--danger" role="menuitem" data-danger>O‘chirish</button>
      </div>
    </div>

    <h2 style="margin-top:24px">Tooltip (S15.08)</h2>
    <p>
      <button type="button" class="btn btn-quiet" data-tooltip aria-describedby="s15-tip">Nima bu?</button>
      <span class="tooltip tooltip--top" id="s15-tip" role="tooltip">Qo‘shimcha tushuntirish — faqat matn.</span>
    </p>
  </section>

  <section class="group" id="group-states">
    <h2>Loading & progress (S16.01)</h2>
    <div style="display:flex;gap:24px;flex-wrap:wrap;align-items:center">
      <div aria-busy="true" style="display:flex;flex-direction:column;gap:10px;flex:1;min-width:220px">
        <span class="skeleton skeleton--title" style="width:60%"></span>
        <span class="skeleton skeleton--line" style="width:85%"></span>
        <span class="skeleton skeleton--line" style="width:70%"></span>
        <span class="skeleton skeleton--list-item"></span>
        <span class="skeleton skeleton--list-item"></span>
        <span class="skeleton skeleton--list-item"></span>
      </div>
      <div style="display:flex;flex-direction:column;gap:16px;flex:1;min-width:220px">
        <span class="inline-status" role="status"><span class="spinner spinner--sm"></span> Yuklanmoqda…</span>
        <div class="progress-wrap" aria-busy="true">
          <span class="progress-label"><span>Yuklab olinmoqda</span><span>72%</span></span>
          <div class="progress" role="progressbar" aria-valuenow="72" aria-valuemin="0" aria-valuemax="100"><div class="progress__bar" style="width:72%"></div></div>
        </div>
      </div>
    </div>

    <h2 style="margin-top:24px">Empty states (S16.05)</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px">
      <div class="empty-state empty-state--first-use">
        <span class="empty-state__icon"><%- icon('fileText', 24) %></span>
        <h3 class="empty-state__title">Birinchi test yarating</h3>
        <p class="empty-state__desc">Savollaringizni jamlab, talabalar bilan baham ko‘ring — bir necha daqiqa kifoya.</p>
        <div class="empty-state__actions"><button type="button" class="btn btn-primary">Test yaratish</button></div>
      </div>
      <div class="empty-state empty-state--no-results">
        <span class="empty-state__icon"><%- icon('search', 24) %></span>
        <h3 class="empty-state__title">Hech narsa topilmadi</h3>
        <p class="empty-state__desc"><span class="empty-state__query">"algebra"</span> so‘roviga mos test yo‘q. Filtrlarni tozalab qayta urinib ko‘ring.</p>
        <div class="empty-state__actions"><button type="button" class="btn btn-quiet">Filtrlarni tozalash</button></div>
      </div>
      <div class="empty-state empty-state--completion">
        <span class="empty-state__icon"><%- icon('check', 24) %></span>
        <h3 class="empty-state__title">Hammasi tayyor!</h3>
        <p class="empty-state__desc">Sessiya yakunlandi, natijalar saqlandi. Endi tahlilni ko‘rishingiz mumkin.</p>
        <div class="empty-state__actions"><button type="button" class="btn btn-secondary">Natijalarni ko‘rish</button></div>
      </div>
    </div>

    <h2 style="margin-top:24px">Messages (S16.08)</h2>
    <div style="display:flex;flex-direction:column;gap:10px;max-width:560px">
      <div class="message message--error" role="alert">
        <span class="message__icon" aria-hidden="true"><%- icon('alertTriangle', 20) %></span>
        <div class="message__body">
          <div class="message__title">Saqlash amalga oshmadi</div>
          <div>Javoblaringiz saqlanmadi. Iltimos qayta urinib ko‘ring; muammo davom etsa, qo‘llab-quvvatlash xizmatiga murojaat qiling.</div>
          <div class="message__actions"><button type="button" class="btn btn-quiet btn-sm">Qayta urinish</button></div>
        </div>
      </div>
      <div class="message message--warning">
        <span class="message__icon" aria-hidden="true"><%- icon('alertTriangle', 20) %></span>
        <div class="message__body">
          <div class="message__title">Internet aloqasi beqaror</div>
          <div>O‘zgarishlaringiz qurilmada saqlanmoqda va qayta ulanganda yuboriladi.</div>
        </div>
      </div>
    </div>

    <h2 style="margin-top:24px">Offline banner (S16.09)</h2>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <button type="button" class="btn btn-secondary" data-offline-demo>Offline demo</button>
      <button type="button" class="btn btn-secondary" data-reconnect-demo>Reconnect demo</button>
      <button type="button" class="btn btn-secondary" data-online-demo>Online demo</button>
    </div>
  </section>

  <section class="group" id="group-navigation">
    <h2>Navigation & wayfinding (S17)</h2>
    <div style="max-width:560px">
      <h3 style="margin:6px 0 8px;font-size:.9rem">Breadcrumb (S17.09)</h3>
      <nav class="crumb" aria-label="Yo'l (breadcrumb)">
        <ol class="crumb-list">
          <li class="crumb-item"><a href="#" class="crumb-link">Bosh sahifa</a></li>
          <li class="crumb-item"><span class="crumb-sep" aria-hidden="true"><%- icon('chevronRight', 12) %></span><a href="#" class="crumb-link">Testlar</a></li>
          <li class="crumb-item"><span class="crumb-sep" aria-hidden="true"><%- icon('chevronRight', 12) %></span><span class="crumb-link" aria-current="page">Algebra</span></li>
        </ol>
      </nav>
    </div>
    <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:flex-start">
      <div style="display:flex;flex-direction:column;gap:6px;flex:1;min-width:220px;background:var(--deborah-semantic-color-surface-input,var(--deborah-semantic-color-surface-raised));border:1px solid var(--deborah-semantic-color-border-default);border-radius:var(--deborah-radius-md,12px);padding:14px">
        <h3 style="margin:0 0 8px;font-size:.9rem">Active nav state (S17.05)</h3>
        <a href="#" class="shell-nav-link" style="text-decoration:none"><span class="shell-nav-ico"><%- icon('grid', 16) %></span><span>Overview</span></a>
        <a href="#" class="shell-nav-link active" style="text-decoration:none"><span class="shell-nav-ico"><%- icon('bookOpen', 16) %></span><span>Kurslar</span></a>
        <a href="#" class="shell-nav-link" style="text-decoration:none"><span class="shell-nav-ico"><%- icon('target', 16) %></span><span>Baholashlar</span></a>
      </div>
      <div style="display:flex;flex-direction:column;gap:6px;flex:1;min-width:220px;background:var(--deborah-semantic-color-surface-input,var(--deborah-semantic-color-surface-raised));border:1px solid var(--deborah-semantic-color-border-default);border-radius:var(--deborah-radius-md,12px);padding:14px">
        <h3 style="margin:0 0 8px;font-size:.9rem">Account menu (S17.11)</h3>
        <div class="shell-account" data-shell-account>
          <button type="button" class="shell-account-btn" aria-haspopup="true" aria-expanded="false" aria-controls="demo-account-menu">
            <span class="shell-nav-ico"><%- icon('user', 15) %></span>
            <span><span class="shell-account-name">Demo User</span><span class="shell-account-sub">O'qituvchi</span></span>
            <span class="shell-nav-ico" style="margin-left:auto;opacity:.6"><%- icon('chevronDown', 12) %></span>
          </button>
          <div class="shell-account-menu" id="demo-account-menu">
            <a href="#" class="shell-account-menu-item"><span class="shell-nav-ico"><%- icon('home', 14) %></span> Bosh sahifa</a>
            <a href="#" class="shell-account-menu-item"><span class="shell-nav-ico"><%- icon('grid', 14) %></span> Panel</a>
            <div class="theme-segmented" role="group" aria-label="Mavzu">
              <button type="button" data-theme-state-btn="system" aria-pressed="false">System</button>
              <button type="button" data-theme-state-btn="light" aria-pressed="false">☀ Light</button>
              <button type="button" data-theme-state-btn="dark" aria-pressed="false">☾ Dark</button>
            </div>
            <a href="#" class="shell-account-menu-item shell-account-menu-item--logout"><span class="shell-nav-ico"><%- icon('logOut', 14) %></span> Chiqish</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="group" id="group-tables">
    <h2>Data table (S18)</h2>
    <div data-dt="demo" data-dt-options='{"sortable":true,"search":true,"density":true,"key":"demo"}'>
      <div class="dt-wrap is-reflow">
        <table class="dt">
          <thead>
            <tr>
              <th scope="col" data-sort="name">Test nomi</th>
              <th scope="col" data-sort="count" class="dt-num">Savollar</th>
              <th scope="col" data-sort="date" class="dt-ts">Yaratilgan</th>
              <th scope="col" class="dt-actions">Amallar</th>
            </tr>
          </thead>
          <tbody>
            <tr class="dt-row" data-name="Algebra" data-count="15" data-date="2026-05-12">
              <td class="dt-cell-main">Algebra</td>
              <td class="dt-num" data-label="Savollar">15</td>
              <td class="dt-ts dt-cell-meta" data-label="Yaratilgan"><span data-label="Sana">2026-05-12</span></td>
              <td class="dt-actions dt-cell-actions"><button type="button" class="btn btn-quiet btn-sm">Tahrirlash</button></td>
            </tr>
            <tr class="dt-row" data-name="Geometriya" data-count="9" data-date="2026-06-03">
              <td class="dt-cell-main">Geometriya</td>
              <td class="dt-num" data-label="Savollar">9</td>
              <td class="dt-ts dt-cell-meta" data-label="Yaratilgan"><span data-label="Sana">2026-06-03</span></td>
              <td class="dt-actions dt-cell-actions"><button type="button" class="btn btn-quiet btn-sm">Tahrirlash</button></td>
            </tr>
            <tr class="dt-row" data-name="Fizika" data-count="22" data-date="2026-04-18">
              <td class="dt-cell-main">Fizika</td>
              <td class="dt-num" data-label="Savollar">22</td>
              <td class="dt-ts dt-cell-meta" data-label="Yaratilgan"><span data-label="Sana">2026-04-18</span></td>
              <td class="dt-actions dt-cell-actions"><button type="button" class="btn btn-quiet btn-sm">Tahrirlash</button></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="group" id="group-charts">
    <h2>Charts & evidence visualization</h2>
    <p class="group-desc">S19 — distribution bar, revote pair, confidence grid, progress line. CVD-safe shapes, stable order, direct labels, accessible table, sample threshold.</p>
    <div class="demo-grid">
      <div class="demo-block">
        <h3>Distribution bar</h3>
        <div id="demo-dist" class="ev-card"></div>
      </div>
      <div class="demo-block">
        <h3>Revote pair</h3>
        <div id="demo-revote" class="ev-card"></div>
      </div>
      <div class="demo-block">
        <h3>Confidence grid</h3>
        <div id="demo-conf" class="ev-card"></div>
      </div>
      <div class="demo-block">
        <h3>Progress line</h3>
        <div id="demo-progress" class="ev-card"></div>
      </div>
    </div>
  </section>

  <script>
    // S15 demo triggerlar
    document.querySelector('[data-confirm-demo]').addEventListener('click', async () => {
      const ok = await showConfirm('O\'chirish', 'Bu amalni tasdiqlaysizmi?', 'Ha, o\'chir');
      showToast(ok ? 'Tasdiqlandi' : 'Bekor qilindi', ok ? 'success' : 'info');
    });
    document.querySelector('[data-toast-success]').addEventListener('click', () => showToast('Muvaffaqiyatli saqlandi', 'success'));
    document.querySelector('[data-toast-error]').addEventListener('click', () => showToast('Xatolik yuz berdi', 'error'));

    // S16 demo triggerlar
    document.querySelector('[data-offline-demo]').addEventListener('click', () => DeborahOffline.offline());
    document.querySelector('[data-reconnect-demo]').addEventListener('click', () => { DeborahOffline.reconnect(); let p = 0; const t = setInterval(() => { p += 20; DeborahOffline.progress(p); if (p >= 100) { clearInterval(t); DeborahOffline.online(2); } }, 300); });
    document.querySelector('[data-online-demo]').addEventListener('click', () => DeborahOffline.online(2));

    // S18: init data tables
    if (window.DataTable) {
      document.querySelectorAll('[data-dt]').forEach((el) => {
        const opts = el.getAttribute('data-dt-options');
        const o = opts ? JSON.parse(opts) : {};
        new window.DataTable(el, o);
      });
    }

    // S19: chart demos
    if (window.CastCharts) {
      const C = window.CastCharts;
      C.distributionBar(document.getElementById('demo-dist'), {
        label: 'Savol 1 — javoblar',
        total: 24,
        sampleThreshold: 3,
        noResponse: 3,
        options: [
          { id: 'A', label: 'Toshkent', count: 14, correct: true },
          { id: 'B', label: 'Samarqand', count: 6 },
          { id: 'C', label: 'Buxoro', count: 3 },
          { id: 'D', label: 'Xiva', count: 1 },
        ],
      });
      C.revotePair(document.getElementById('demo-revote'), {
        label: 'Qayta ovoz',
        beforeTotal: 24,
        afterTotal: 24,
        options: [
          { id: 'A', label: 'Toshkent', before: 9, after: 14, correct: true },
          { id: 'B', label: 'Samarqand', before: 8, after: 6 },
          { id: 'C', label: 'Buxoro', before: 4, after: 3 },
          { id: 'D', label: 'Xiva', before: 3, after: 1 },
        ],
      });
      C.confidenceGrid(document.getElementById('demo-conf'), {
        label: 'Ishonch matritsasi',
        cells: [
          { label: 'A — ishonchim bor', value: '8' },
          { label: 'A — taxmin', value: '4' },
          { label: 'A — ishonchim yo‘q', value: '2' },
        ],
      });
      C.progressLine(document.getElementById('demo-progress'), {
        label: 'Faollik dinamikasi',
        points: [
          { value: 2, label: '1-savol' },
          { value: 5, label: '2-savol' },
          { value: 9, label: '3-savol' },
          { value: 14, label: '4-savol' },
          { value: 18, label: '5-savol' },
          { value: 22, label: '6-savol' },
          { value: 24, label: '7-savol' },
        ],
        max: 30,
        latest: '24 javob',
        ariaLabel: 'Faollik 7 savol davomida 24 javobgacha oshdi',
      });
    }
  </script>
</body>
</html>
