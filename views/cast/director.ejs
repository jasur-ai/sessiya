<!DOCTYPE html>
<html lang="uz" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/images/logo-icon.svg">
  <link rel="stylesheet" href="/css/cast-tokens.css">
  <link rel="stylesheet" href="/css/cast-director.css">
  <link rel="stylesheet" href="/design/foundations/typography.css">
  <link rel="stylesheet" href="/design/foundations/layout.css">
  <link rel="stylesheet" href="/design/foundations/motion.css">
  <link rel="stylesheet" href="/design/components/charts.css">
  <script>
    window.__BOOT__ = <%- JSON.stringify(boot).replace(/</g, '\\u003c') %>;
    window.__CSRF_TOKEN = '<%= boot.csrfToken %>';
  </script>
</head>
<% const SIMPLE = !!(boot && boot.simple); %>
<body class="cast-page<% if (SIMPLE) { %> cast-simple<% } %>" data-cast-theme="focus_dark">
  <div class="cast-live-region" aria-live="polite" id="status-live"></div>
  <div class="cast-live-region" aria-live="assertive" id="alert-live"></div>

  <!-- C4-04 (item 18/23): a11y controls -->
  <div class="cast-a11y-bar" aria-label="Imkoniyatlar">
    <button type="button" class="cast-icon-btn" data-a11y-toggle="theme" title="Tema / yuqori kontrast" aria-label="Tema almashtirish (yuqori kontrast)">◐</button>
    <button type="button" class="cast-icon-btn" data-a11y-toggle="hints" title="Klaviatura yorliqlari (?)" aria-label="Klaviatura yorliqlari">⌨</button>
  </div>

  <header class="dir-topbar">
    <div class="dir-topbar-left">
      <span class="dir-logo"><%- icon('gamepad', 16) %> Cast</span>
      <span class="dir-title" id="dir-title"><%= boot.title %></span>
      <span class="dir-code">Kod: <b id="dir-code-val">—</b></span>
      <span class="dir-phase-badge" id="dir-phase-badge" role="status">Lobbi</span>
    </div>
    <div class="dir-topbar-right">
      <span class="dir-health" id="dir-health">Ulanish…</span>
      <a class="dir-status-chip" id="dir-projector-status" href="<%= '/cast/' + boot.sessionId + '/projector' %>" target="_blank" rel="noopener"><%- icon('monitor', 13) %> <span>Proyektor</span></a>
      <span class="dir-status-chip" id="dir-role-chip" data-role="<%= boot.actor.role %>"><%- icon('shieldCheck', 13) %> <span><%= boot.actor.role === 'owner' ? 'Owner' : boot.actor.role === 'co_host' ? 'Co-host' : 'Moderator' %></span></span>
      <!-- C5-01: sessiya tugagach natijalar sahifasi -->
      <a class="cast-btn cast-btn-outline" id="btn-results" href="<%= '/cast/' + boot.sessionId + '/results' %>"><%- icon('barChart', 16) %> Natijalar</a>
      <!-- C5-02: event replay + reflection (overflow menu'da) -->
      <div class="dir-overflow" data-dir-overflow>
        <button type="button" class="cast-btn" id="btn-overflow" aria-haspopup="menu" aria-expanded="false" aria-label="Ko'proq amallar"><%- icon('moreHorizontal', 16) %></button>
        <div class="dir-overflow-menu" id="dir-overflow-menu" role="menu" aria-label="Sessiya amallari" data-dir-overflow-menu hidden>
          <a role="menuitem" id="btn-replay" href="<%= '/cast/' + boot.sessionId + '/replay' %>"><%- icon('refresh', 14) %> Replay</a>
          <button role="menuitem" type="button" id="btn-end-session" class="dir-overflow-danger"><%- icon('trash', 14) %> Sessiyani tugatish</button>
        </div>
      </div>
    </div>
  </header>

  <div class="dir-layout">
    <!-- Main content -->
    <main class="dir-main cast-surface" id="dir-main">
      <div id="dir-lobby" class="dir-lobby">
        <div class="lobby-code-card cast-surface">
          <div class="lobby-label">QO'SHILISH KODI</div>
          <div class="lobby-code" id="dir-code-big">—</div>
          <div class="lobby-link" id="dir-join-link"></div>
          <!-- C4-10: QR — telefon bilan kirish (skaner → /play?code=) -->
          <div class="lobby-qr-wrap" id="dir-qr-wrap" hidden>
            <button type="button" class="lobby-qr-btn" id="btn-qr-open" aria-label="QR kodni kattalashtirish">
              <img id="dir-qr" width="124" height="124" alt="QR kod">
            </button>
            <div class="lobby-qr-hint">Telefon bilan kirish — skanerlang</div>
          </div>
          <!-- C4-06: raid paytida kod aylantirish (item 16) -->
          <div class="poe-ctl-row" style="margin-top:10px">
            <button class="cast-btn" id="btn-rotate-code" data-i18n="director.rotateCode"><%- icon('refresh', 16) %> Kodni almashtirish</button>
          </div>
        </div>
        <div class="lobby-stats">
          <div class="stat-box"><div class="stat-num" id="dir-player-count">0</div><div class="stat-label">Ishtirokchi</div></div>
        </div>
        <!-- C4-06: participant boshqaruvi (remove vs block alohida — item 15) -->
        <div class="lobby-participants cast-surface" id="dir-participant-list">
          <div class="ev-title"><%- icon("users", 14) %> Ishtirokchilar</div>
          <div id="dir-participant-items"></div>
        </div>
        <button class="cast-btn cast-btn-primary cast-btn-lg" id="btn-start-session" data-i18n="director.start">Cast qilish</button>
      </div>

      <div id="dir-question" class="dir-question" hidden>
        <div class="dir-q-meta" id="dir-q-meta">—</div>
        <div class="dir-q-text" id="dir-q-text">—</div>
        <div class="dir-q-options" id="dir-q-options"></div>
      </div>

      <!-- S29.03: teacher evidence + private panels (5 cols) -->
      <aside class="dir-pane" id="dir-pane" aria-label="O'qituvchi dalillari">
        <!-- S29.04: primary evidence — max 4 metrics -->
        <div class="dir-metrics cast-surface" id="dir-metrics" role="list" aria-label="Asosiy ko'rsatkichlar">
          <div class="dir-metric" role="listitem"><span class="dir-metric-label">Javob berdi</span><span class="dir-metric-val" id="dir-metric-answered">—</span></div>
          <div class="dir-metric" role="listitem"><span class="dir-metric-label">To'g'ri</span><span class="dir-metric-val" id="dir-metric-correct">—</span></div>
          <div class="dir-metric" role="listitem"><span class="dir-metric-label">Asosiy distraktor</span><span class="dir-metric-val" id="dir-metric-distractor">—</span></div>
          <div class="dir-metric" role="listitem"><span class="dir-metric-label">Texnik muammo</span><span class="dir-metric-val" id="dir-metric-issue">—</span></div>
        </div>
        <div class="dir-evidence cast-surface" id="dir-evidence" hidden>
          <div class="ev-title">📊 Ishtirokchilar dalillari <span class="ev-private-badge">faqat sizga</span></div>
          <div class="ev-grid" id="dir-ev-grid"></div>
          <div class="ev-stats" id="dir-ev-stats"></div>
          <div class="ev-dist" id="dir-ev-dist"></div>
          <div class="hinge-card cast-surface" id="dir-hinge" hidden></div>
          <!-- C5-11 AI Co-host shadow card (recommendation only — live action yo'q) -->
          <div class="shadow-card cast-surface" id="dir-shadow" hidden>
            <div class="shadow-head">
              <span>🤖 AI Co-host <span class="shadow-badge">shadow</span></span>
              <span class="shadow-meta" id="dir-shadow-meta"></span>
            </div>
            <div class="shadow-body" id="dir-shadow-body"></div>
            <div class="shadow-actions">
              <button class="shadow-btn shadow-btn-ok" id="dir-shadow-accept" type="button" hidden><%- icon('check', 16) %> Qabul qilish</button>
              <button class="shadow-btn shadow-btn-no" id="dir-shadow-dismiss" type="button" hidden><%- icon('x', 16) %> Rad etish</button>
            </div>
            <button class="shadow-btn shadow-btn-run" id="dir-shadow-run" type="button"><%- icon('refresh', 16) %> Shadow taklif olish</button>
          </div>
          <div class="vm-card cast-surface" id="dir-vote-matrix" hidden></div>
          <div class="vm-card cast-surface" id="dir-confidence" hidden></div>
          <div class="reasoning-queue cast-surface" id="dir-reasoning-queue" hidden>
            <div class="ev-title">💬 Talabalar fikrlari <span class="ev-private-badge">faqat sizga</span></div>
            <div id="dir-reasoning-list"></div>
          </div>
          <!-- C3-10 Confusion aggregate (identity yashirin) -->
          <div class="confusion-panel cast-surface" id="dir-confusion" hidden>
            <div class="ev-title">🚦 Chalkashlik signallari <span class="ev-private-badge">aggregat — anonim</span></div>
            <div class="confusion-chips" id="dir-confusion-chips"></div>
          </div>
          <!-- C3-10 Question Wall moderation queue (faqat sizga) -->
          <div class="wall-queue cast-surface" id="dir-wall-queue" hidden>
            <div class="ev-title">💬 Savollar devori <span class="ev-private-badge">faqat sizga</span></div>
            <div id="dir-wall-list"></div>
          </div>
          <!-- C3-12 Open-Response Semantic Board (faqat sizga) -->
          <div class="orb-panel cast-surface" id="dir-orb" hidden>
            <div class="ev-title">🗂 Semantic Board <span class="ev-private-badge">faqat sizga</span></div>
            <div class="orb-collect-ctl" id="orb-collect-ctl">
              <div id="dir-orb-prompt" class="orb-prompt"></div>
              <div class="poe-ctl-row">
                <button class="cast-btn cast-btn-primary" id="btn-orb-close"><%- icon('lock', 16) %> Yig‘ishni yopish</button>
              </div>
            </div>
            <div class="orb-review-ctl" id="orb-review-ctl" hidden>
              <div class="poe-ctl-row">
                <button class="cast-btn" id="btn-orb-cluster"><%- icon('layers', 16) %> Cluster ishga tushirish</button>
                <button class="cast-btn" id="btn-orb-end"><%- icon('check', 16) %> Boardni yakunlash</button>
              </div>
              <div id="orb-cluster-status" class="orb-status"></div>
              <div class="orb-columns">
                <div class="orb-col">
                  <div class="orb-col-title">🟢 Unclustered</div>
                  <div id="orb-unclustered" class="orb-list"></div>
                </div>
                <div class="orb-col">
                  <div class="orb-col-title">🟡 Suggested</div>
                  <div id="orb-suggested" class="orb-list"></div>
                </div>
                <div class="orb-col">
                  <div class="orb-col-title">✅ Confirmed</div>
                  <div id="orb-confirmed" class="orb-list"></div>
                </div>
              </div>
              <div class="orb-merge-ctl">
                <button class="cast-btn" id="btn-orb-merge" disabled><%- icon('link', 16) %> Tanlanganlarni birlashtirish</button>
                <input class="cast-input" id="orb-merge-label" placeholder="Yangi cluster nomi…" maxlength="120">
              </div>
              <div class="ev-title" style="margin-top:12px">📜 Event log</div>
              <div id="orb-events" class="orb-events"></div>
            </div>
          </div>
          <!-- C3-13 Student Question Forge (faqat sizga) -->
          <div class="forge-panel cast-surface" id="dir-forge" hidden>
            <div class="ev-title">✏️ Student Question Forge <span class="ev-private-badge">faqat sizga</span></div>
            <div class="orb-status" id="forge-meta"></div>
            <div id="forge-queue" class="forge-queue"></div>
          </div>
          <!-- C3-14 Session Choreography (composer + dashboard) -->
          <div class="choreo-panel cast-surface" id="dir-choreo" hidden>
            <div class="ev-title">🎬 Choreography <span class="ev-private-badge">faqat sizga</span></div>
            <!-- Runtime dashboard (item 13) -->
            <div class="chor-dash" id="chor-dash" hidden>
              <div class="chor-dash-grid">
                <div class="chor-cell"><span class="chor-cell-label">CURRENT</span><div class="chor-cell-val" id="chor-current">—</div></div>
                <div class="chor-cell"><span class="chor-cell-label">NEXT</span><div class="chor-cell-val" id="chor-next">—</div></div>
                <div class="chor-cell"><span class="chor-cell-label">ELAPSED</span><div class="chor-cell-val" id="chor-elapsed">—</div></div>
                <div class="chor-cell"><span class="chor-cell-label">REMAINING</span><div class="chor-cell-val" id="chor-remaining">—</div></div>
                <div class="chor-cell"><span class="chor-cell-label">COVERAGE</span><div class="chor-cell-val" id="chor-coverage">—</div></div>
                <div class="chor-cell"><span class="chor-cell-label">HEALTH</span><div class="chor-cell-val" id="chor-health">—</div></div>
              </div>
              <div class="poe-ctl-row">
                <button class="cast-btn" id="btn-chor-next">⏭ Keyingi blok</button>
                <button class="cast-btn" id="btn-chor-override">↪ Override</button>
              </div>
              <div class="orb-status" id="chor-dash-status"></div>
            </div>
            <!-- Composer (item 4-5) -->
            <div class="chor-composer">
              <div class="poe-ctl-row">
                <select class="cast-input" id="chor-template-select"></select>
                <button class="cast-btn" id="btn-chor-new">+ Yangi</button>
                <button class="cast-btn" id="btn-chor-save"><%- icon('save', 16) %> Saqlash</button>
                <button class="cast-btn" id="btn-chor-preview"><%- icon('eye', 16) %> Preview</button>
              </div>
              <label class="part-field">
                <span>Template nomi</span>
                <input class="cast-input" id="chor-name" maxlength="80" placeholder="Dars rejasi nomi…">
              </label>
              <label class="part-field">
                <span>Rejim</span>
                <select class="cast-input" id="chor-mode">
                  <option value="guided">Guided (qo‘lda boshqarish)</option>
                  <option value="fully_auto">Fully-auto (avtomatik exit trigger)</option>
                </select>
              </label>
              <div class="poe-ctl-row">
                <select class="cast-input" id="chor-block-type">
                  <option value="LOBBY">Lobbi</option>
                  <option value="INSTRUCTIONS">Ko‘rsatma</option>
                  <option value="THINK">O‘ylash</option>
                  <option value="QUESTION">Savol</option>
                  <option value="CONFIDENCE">Ishonch</option>
                  <option value="REVEAL">Natija</option>
                  <option value="DISCUSS">Muhokama</option>
                  <option value="REVOTE">Qayta ovoz</option>
                  <option value="EXPLANATION">Tushuntirish</option>
                  <option value="LEADERBOARD">Reyting</option>
                  <option value="CLASS_GOAL">Sinf maqsadi</option>
                  <option value="BREAK">Tanaffus</option>
                  <option value="QUICK_PROMPT">Tezkor savol</option>
                  <option value="REDEMPTION">Redemption</option>
                  <option value="EXIT_TICKET">Chiqish bileti</option>
                </select>
                <button class="cast-btn" id="btn-chor-add">+ Qo‘shish</button>
              </div>
              <div id="chor-blocks" class="chor-blocks"></div>
              <div class="orb-status" id="chor-validation"></div>
              <div class="orb-status" id="chor-duration"></div>
            </div>
          </div>
          <!-- C3-11 POE panel (faqat sizga) -->
          <div class="poe-panel cast-surface" id="dir-poe" hidden>
            <div class="ev-title">🔭 POE <span class="ev-private-badge">faqat sizga</span></div>
            <div id="dir-poe-pred-dist"></div>
            <div id="dir-poe-obs-ctl" class="poe-ctl" hidden>
              <span class="poe-readiness" id="dir-poe-readiness">—</span>
              <div class="poe-ctl-row">
                <button class="cast-btn" id="btn-poe-close-pred" hidden><%- icon('lock', 16) %> Bashoratni yopish</button>
                <button class="cast-btn cast-btn-primary" id="btn-poe-start-exp" hidden>▶ Tushuntirish</button>
                <button class="cast-btn" id="btn-poe-close-exp" hidden><%- icon('lock', 16) %> Tushuntirishni yopish</button>
                <button class="cast-btn" id="btn-poe-analysis" hidden><%- icon('barChart', 16) %> Tahlilni ko‘rsatish</button>
              </div>
              <div class="poe-ctl-row">
                <button class="cast-btn" id="btn-poe-media-retry" hidden><%- icon('refresh', 16) %> Media qayta</button>
                <button class="cast-btn" id="btn-poe-media-skip" hidden>⏭ O‘tkazish</button>
                <button class="cast-btn" id="btn-poe-media-fallback" hidden><%- icon('fileText', 16) %> Fallback matn</button>
              </div>
            </div>
            <div id="dir-poe-analysis" hidden>
              <div id="dir-poe-change-matrix"></div>
              <div class="poe-exemplars" id="dir-poe-exemplars"></div>
            </div>
          </div>
          <!-- C3-17 Power-ups panel (faqat sizga) -->
          <div class="sp-panel cast-surface" id="dir-powerups" hidden>
            <div class="ev-title">⚡ Power-up'lar <span class="ev-private-badge">faqat sizga</span></div>
            <div class="orb-status" id="pu-status"></div>
            <div class="ev-title" style="margin-top:10px">Ruxsat etilgan turlar</div>
            <div class="poe-ctl-row">
              <label class="pu-type"><input type="checkbox" class="pu-allowed" value="hint"> 💡 Maslahat</label>
              <label class="pu-type"><input type="checkbox" class="pu-allowed" value="extra_time"> ⏱ Qo‘shimcha vaqt</label>
              <label class="pu-type"><input type="checkbox" class="pu-allowed" value="team_consult"> 🤝 Jamoa maslahati</label>
              <label class="pu-type"><input type="checkbox" class="pu-allowed" value="private_redemption"> 🔁 Qayta urinish</label>
            </div>
            <div class="orb-status" id="pu-note">⚡ Ishlatilishi sinfga oshkor qilinmaydi — faqat shaxsiy.</div>
            <div class="poe-ctl-row">
              <button class="cast-btn cast-btn-primary" id="btn-pu-save"><%- icon('save', 16) %> Saqlash</button>
            </div>
          </div>
          <!-- C3-16 Self-Paced Race panel (faqat sizga) -->
          <div class="sp-panel cast-surface" id="dir-sp" hidden>
            <div class="ev-title">🏁 Self-Paced Race <span class="ev-private-badge">faqat sizga</span></div>
            <div class="poe-ctl-row">
              <button class="cast-btn cast-btn-primary" id="btn-sp-start" hidden>▶ Poygani boshlash</button>
              <button class="cast-btn" id="btn-sp-pause" hidden>⏸ Pauza</button>
              <button class="cast-btn" id="btn-sp-resume" hidden>▶ Davom</button>
            </div>
            <div class="orb-status" id="sp-status"></div>
            <div class="chor-dash-grid">
              <div class="chor-cell"><span class="chor-cell-label">ACTIVE</span><div class="chor-cell-val" id="sp-active">—</div></div>
              <div class="chor-cell"><span class="chor-cell-label">FINISHED</span><div class="chor-cell-val" id="sp-finished">—</div></div>
              <div class="chor-cell"><span class="chor-cell-label">PENDING</span><div class="chor-cell-val" id="sp-pending">—</div></div>
              <div class="chor-cell"><span class="chor-cell-label">PARTICIP.</span><div class="chor-cell-val" id="sp-participation">—</div></div>
              <div class="chor-cell"><span class="chor-cell-label">SPREAD</span><div class="chor-cell-val" id="sp-spread">—</div></div>
              <div class="chor-cell"><span class="chor-cell-label">FAIRNESS</span><div class="chor-cell-val" id="sp-fairness">—</div></div>
            </div>
            <div class="ev-title" style="margin-top:12px">Progress distribution</div>
            <div id="sp-dist" class="sp-dist"></div>
            <div class="orb-status" id="sp-health-issues"></div>
          </div>
          <!-- C4-03 Paper-card mode panel (faqat sizga) -->
          <div class="sp-panel cast-surface" id="dir-cards" hidden>
            <div class="ev-title">📷 Qog‘oz kartochka skaneri <span class="ev-private-badge">faqat sizga</span></div>
            <div class="poe-ctl-row">
              <button class="cast-btn cast-btn-primary" id="btn-card-scan"><%- icon('camera', 16) %> Skanerlash</button>
              <button class="cast-btn" id="btn-card-correct"><%- icon('edit', 16) %> Manuel tuzatish</button>
            </div>
            <div class="orb-status" id="card-status"></div>
            <div class="ev-title" style="margin-top:12px">Progress (skanerlangan/kutilgan)</div>
            <div id="card-progress" class="sp-dist"></div>
            <div class="card-correct-box" id="card-correct-box" hidden>
              <div class="poe-ctl-row">
                <label class="pu-type">Karta: <input class="cast-input" id="card-correct-id" placeholder="CARD-001" maxlength="9"></label>
                <label class="pu-type">Variant: <input class="cast-input" id="card-correct-opt" placeholder="A" maxlength="1" style="width:50px"></label>
              </div>
              <div class="poe-ctl-row">
                <label class="pu-type">Sabab: <input class="cast-input" id="card-correct-reason" placeholder="nima uchun?" style="flex:1"></label>
                <button class="cast-btn cast-btn-primary" id="btn-card-correct-save"><%- icon('save', 16) %></button>
              </div>
              <div class="orb-status">✏️ Tuzatish audit qilinadi (actor/time/reason).</div>
            </div>
          </div>
          <!-- C4-01 Team Challenge panel (faqat sizga) -->
          <div class="sp-panel cast-surface" id="dir-teams" hidden>
            <div class="ev-title">👥 Jamoa rejimi <span class="ev-private-badge">faqat sizga</span></div>
            <div class="poe-ctl-row">
              <button class="cast-btn cast-btn-primary" id="btn-team-assign"><%- icon('dice', 16) %> Jamoalarni taqsimlash</button>
              <button class="cast-btn" id="btn-team-talk"><%- icon('users', 16) %> Jamoa muhokamasi</button>
            </div>
            <div class="poe-ctl-row">
              <label class="pu-type"><input type="number" id="team-talk-secs" class="cast-input" value="60" min="10" max="600" style="width:70px"> soniya</label>
            </div>
            <div class="orb-status" id="team-status"></div>
            <div class="ev-title" style="margin-top:12px">Jamoalar</div>
            <div id="team-roster" class="sp-dist"></div>
            <div class="ev-title" style="margin-top:12px">Reyting (faqat jamoalar)</div>
            <div id="team-lb" class="sp-dist"></div>
          </div>
        </div>
      </aside>
    </main>

    <!-- C4-10: oddiy rejim yagona markaziy boshqaruvi (avto oqimda savolni yopish) -->
    <button type="button" class="dir-close-pill" id="btn-close-pill" hidden>
      <%- icon('lock', 15) %> <span data-close-label>Savolni yopish</span>
    </button>

    <!-- Control rail (S29.03: bottom full-width) -->
    <nav class="dir-rail cast-surface" id="dir-rail" aria-label="Boshqaruv paneli">
      <!-- S29.05/06: primary actions — phase bo'yicha, maks 3, faqat BIRTA cobalt -->
      <div class="rail-group rail-primary" role="group" aria-label="Asosiy amallar">
        <button type="button" class="cast-btn" id="btn-close" data-i18n="director.close" disabled><%- icon('lock', 16) %> Yopish</button>
        <button type="button" class="cast-btn" id="btn-reveal" data-i18n="director.reveal" disabled><%- icon('target', 16) %> Javobni ko'rsatish</button>
        <button type="button" class="cast-btn" id="btn-next" data-i18n="director.next" disabled>Keyingi savol →</button>
      </div>
      <!-- S29.09: Add Time menu (bitta tugma + popover) -->
      <div class="rail-group rail-secondary">
        <details class="rail-addtime" data-addtime>
          <summary class="cast-btn" aria-label="Vaqt qo'shish"><%- icon('clock', 16) %> Vaqt</summary>
          <div class="rail-addtime-menu cast-surface" role="menu" aria-label="Vaqt qo'shish" data-addtime-menu>
            <button type="button" class="cast-btn rail-time-btn" data-sec="5" role="menuitem">+5s</button>
            <button type="button" class="cast-btn rail-time-btn" data-sec="10" role="menuitem">+10s</button>
            <button type="button" class="cast-btn rail-time-btn" data-sec="15" role="menuitem">+15s</button>
            <button type="button" class="cast-btn rail-time-btn" data-sec="30" role="menuitem">+30s</button>
          </div>
        </details>
        <button type="button" class="cast-btn" id="btn-pause" data-i18n="director.pause" disabled>Pauza</button>
        <button type="button" class="cast-btn" id="btn-resume" data-i18n="director.resume" disabled>Davom</button>
        <button type="button" class="cast-btn" id="btn-discuss" data-i18n="director.discuss" disabled><%- icon('users', 16) %> Muhokama</button>
        <button type="button" class="cast-btn" id="btn-revote" data-i18n="director.revote" disabled><%- icon('refresh', 16) %> Qayta ovoz</button>
      </div>
      <!-- Tools (doim mavjud, quiet) — oddiy rejimda CSS orqali yashirinadi (C4-10) -->
      <div class="rail-group rail-tools" aria-label="Qo'shimcha vositalar">
        <button type="button" class="cast-btn" id="btn-quick-prompt"><%- icon('zap', 16) %> Tezkor savol</button>
        <button type="button" class="cast-btn" id="btn-transfer"><%- icon('refresh', 16) %> Transfer</button>
        <button type="button" class="cast-btn" id="btn-goal"><%- icon('target', 16) %> Sinf maqsadi</button>
        <button type="button" class="cast-btn" id="btn-poe"><%- icon('search', 16) %> POE</button>
        <button type="button" class="cast-btn" id="btn-orb"><%- icon('folder', 16) %> Semantic Board</button>
        <button type="button" class="cast-btn" id="btn-forge"><%- icon('edit', 16) %> Forge</button>
        <button type="button" class="cast-btn" id="btn-choreo"><%- icon('play', 16) %> Choreography</button>
        <button type="button" class="cast-btn" id="btn-sp" hidden><%- icon('clock', 16) %> Self-Paced</button>
        <button type="button" class="cast-btn" id="btn-powerups" hidden><%- icon('zap', 16) %> Power-up'lar</button>
        <button type="button" class="cast-btn" id="btn-teams" hidden><%- icon('users', 16) %> Jamoalar</button>
        <button type="button" class="cast-btn" id="btn-cards" hidden><%- icon('camera', 16) %> Kartochka</button>
        <button type="button" class="cast-btn" id="btn-lock-lobby"><%- icon('lock', 16) %> Lobbi qulflash</button>
      </div>
      <div class="dir-timer cast-surface" id="dir-timer">
        <div class="timer-label">QOLGAN VAQT</div>
        <div class="timer-value" id="dir-timer-val">—</div>
      </div>
    </nav>
  </div>

  <!-- C4-10: QR kattalashtirilgan ko'rinish -->
  <div class="qr-modal" id="qr-modal" role="dialog" aria-modal="true" aria-label="QR kod" hidden>
    <div class="qr-modal-box cast-surface">
      <div class="qr-modal-code-label">QO'SHILISH KODI</div>
      <div class="qr-modal-code" id="dir-qr-code">—</div>
      <img id="dir-qr-big" width="340" height="340" alt="QR kod">
      <div class="qr-modal-url" id="dir-qr-url"></div>
      <div class="qr-modal-hint">Telefon kamerasi bilan skanerlang — sahifa o'zi ochiladi</div>
      <button type="button" class="cast-btn cast-btn-primary" id="btn-qr-close"><%- icon('x', 15) %> Yopish</button>
    </div>
  </div>

  <!-- End confirmation dialog -->
  <div class="modal-overlay" id="end-modal" hidden>
    <div class="modal-box cast-surface" role="dialog" aria-modal="true" aria-labelledby="end-modal-title">
      <h3 id="end-modal-title">Sessiyani tugatish</h3>
      <p>Barcha ishtirokchilar uchun sessiya yakunlanadi. Davom etasizmi?</p>
      <div class="modal-actions">
        <button class="cast-btn" id="btn-end-cancel">Bekor qilish</button>
        <button class="cast-btn cast-btn-danger" id="btn-end-confirm">Ha, tugatish</button>
      </div>
    </div>
  </div>

  <!-- Class Goal Drawer -->
  <div class="qp-overlay" id="goal-overlay" hidden>
    <div class="qp-drawer cast-surface" role="dialog" aria-modal="true" aria-labelledby="goal-title">
      <div class="qp-header">
        <h3 id="goal-title">🎯 Sinf maqsadi</h3>
        <button type="button" class="cast-btn qp-close" id="goal-close"><%- icon('close', 16) %></button>
      </div>
      <div class="qp-body">
        <div class="qp-field">
          <label>Maqsad turi</label>
          <select id="goal-type" class="cast-input">
            <option value="accuracy_threshold">Aniqlik chegarasi (class %)</option>
            <option value="knowledge_points">Bilim ballari (to‘g‘ri javoblar)</option>
            <option value="misconceptions_resolved">Tushunmovchiliklar hal qilindi</option>
            <option value="mastery_rounds">O‘zlashtirish raundlari</option>
          </select>
        </div>
        <div class="qp-field">
          <label>Maqsad qiymati</label>
          <input type="number" id="goal-target" class="cast-input" value="80" min="1" max="1000">
        </div>
        <div class="qp-errors cast-surface" id="goal-errors" hidden></div>
      </div>
      <div class="qp-actions">
        <button type="button" class="cast-btn cast-btn-primary" id="goal-save"><%- icon('check', 16) %> Maqsadni o‘rnatish</button>
      </div>
    </div>
  </div>

  <!-- Transfer / Redemption Picker Drawer -->
  <div class="qp-overlay" id="tr-overlay" hidden>
    <div class="qp-drawer cast-surface" role="dialog" aria-modal="true" aria-labelledby="tr-title">
      <div class="qp-header">
        <h3 id="tr-title">🔁 Transfer / Redemption</h3>
        <button type="button" class="cast-btn qp-close" id="tr-close"><%- icon('close', 16) %></button>
      </div>
      <div class="qp-body">
        <div class="qp-field">
          <label>Flow turi</label>
          <select id="tr-flow-type" class="cast-input">
            <option value="TRANSFER">Transfer (ekvivalent ko‘nikma)</option>
            <option value="REDEMPTION">Redemption (qayta urinish)</option>
          </select>
        </div>
        <div class="qp-field">
          <label>Manba savol (qaysi savolga javob berilgan)</label>
          <select id="tr-source" class="cast-input"></select>
        </div>
        <div class="qp-field">
          <label>Follow-up savol (qaysi savol bilan transfer qilinadi)</label>
          <select id="tr-followup" class="cast-input"></select>
        </div>
        <div class="qp-errors cast-surface" id="tr-errors" hidden></div>
      </div>
      <div class="qp-actions">
        <button type="button" class="cast-btn cast-btn-primary" id="tr-launch"><%- icon('rocket', 16) %> Ishga tushirish</button>
      </div>
    </div>
  </div>

  <!-- Quick Prompt Composer Drawer -->
  <div class="qp-overlay" id="qp-overlay" hidden>
    <div class="qp-drawer cast-surface" role="dialog" aria-modal="true" aria-labelledby="qp-title">
      <div class="qp-header">
        <h3 id="qp-title">⚡ Tezkor savol</h3>
        <button type="button" class="cast-btn qp-close" id="qp-close"><%- icon('close', 16) %></button>
      </div>
      <div class="qp-body">
        <div class="qp-field">
          <label>Tur</label>
          <select id="qp-type" class="cast-input">
            <option value="single_choice">Tanlov (bir)</option>
            <option value="true_false">To‘g‘ri / Noto‘g‘ri</option>
            <option value="multiple_select">Tanlov (ko‘p)</option>
            <option value="short_answer">Qisqa javob</option>
            <option value="exit_ticket">Chiqish bileti</option>
            <option value="confidence">Ishonch darajasi</option>
            <option value="rating">Baholash</option>
            <option value="prediction">Bashorat</option>
          </select>
        </div>
        <div class="qp-field">
          <label>Savol matni</label>
          <div id="qp-ai-row" style="display:flex;gap:8px;align-items:center;margin-bottom:6px;flex-wrap:wrap;">
            <button type="button" class="cast-btn" id="qp-ai-go" title="Gemini AI mavzu bo‘yicha savol tuzib beradi">✨ AI yozib beradi</button>
            <input id="qp-ai-topic" class="cast-input" style="flex:1;min-width:140px;" placeholder="Mavzu (masalan: Kapital iqtisodiyoti)">
            <select id="qp-ai-count" class="cast-input" style="width:auto;" title="Nechta savol">
              <option value="1">1 ta</option>
              <option value="2">2 ta</option>
              <option value="3">3 ta</option>
            </select>
          </div>
          <div id="qp-ai-status" class="cast-hint" style="display:none;font-size:12px;"></div>
          <textarea id="qp-text" class="cast-input cast-textarea" rows="2" placeholder="Savolingizni yozing… yoki ✦ AI yozib beradi"></textarea>
        </div>
        <div class="qp-field" id="qp-options-wrap">
          <label>Variantlar</label>
          <div id="qp-options-list">
            <div class="qp-option-row">
              <input class="cast-input qp-opt-input" placeholder="Variant A" data-idx="0">
              <input type="checkbox" class="qp-correct" data-idx="0" title="To‘g‘ri javob">
              <button type="button" class="cast-btn qp-opt-del" data-idx="0"><%- icon('close', 16) %></button>
            </div>
            <div class="qp-option-row">
              <input class="cast-input qp-opt-input" placeholder="Variant B" data-idx="1">
              <input type="checkbox" class="qp-correct" data-idx="1" title="To‘g‘ri javob">
              <button type="button" class="cast-btn qp-opt-del" data-idx="1"><%- icon('close', 16) %></button>
            </div>
          </div>
          <button type="button" class="cast-btn" id="qp-add-opt">+ Variant qo‘shish</button>
        </div>
        <div class="qp-field">
          <label>Vaqt (soniya)</label>
          <input type="number" id="qp-seconds" class="cast-input" value="30" min="5" max="600">
        </div>
        <div class="qp-errors cast-surface" id="qp-errors" hidden></div>
      </div>
      <div class="qp-actions">
        <button type="button" class="cast-btn" id="qp-save-lib"><%- icon('save', 16) %> Kutubxonaga saqlash</button>
        <button type="button" class="cast-btn cast-btn-primary" id="qp-launch"><%- icon('rocket', 16) %> Yuborish</button>
      </div>
    </div>
  </div>

  <!-- POE Launch Drawer (C3-11) -->
  <div class="qp-overlay" id="poe-overlay" hidden>
    <div class="qp-drawer cast-surface" role="dialog" aria-modal="true" aria-labelledby="poe-title">
      <div class="qp-header">
        <h3 id="poe-title">🔭 POE — Bashorat → Kuzatuv → Tushuntirish</h3>
        <button type="button" class="cast-btn qp-close" id="poe-close"><%- icon('close', 16) %></button>
      </div>
      <div class="qp-body">
        <div class="qp-field">
          <label>Flow ID</label>
          <input id="poe-flow-id" class="cast-input" value="poe_01" maxlength="60">
        </div>
        <div class="qp-field">
          <label>Bashorat savoli (Prediction)</label>
          <select id="poe-pred-q" class="cast-input"></select>
        </div>
        <div class="qp-field">
          <label>Kuzatuv turi</label>
          <select id="poe-media-type" class="cast-input">
            <option value="image">🖼 Rasm</option>
            <option value="animation">🎞 Animatsiya</option>
            <option value="video">🎬 Video</option>
            <option value="experiment">🧪 Eksperiment ko‘rsatmasi</option>
            <option value="live_note">📝 Jonli eslatma</option>
          </select>
        </div>
        <div class="qp-field" id="poe-media-url-wrap">
          <label>Media URL (http/https)</label>
          <input id="poe-media-url" class="cast-input" placeholder="https://example.com/obs.png">
        </div>
        <div class="qp-field" id="poe-media-text-wrap" hidden>
          <label>Matn / ko‘rsatma</label>
          <textarea id="poe-media-text" class="cast-input cast-textarea" rows="3" placeholder="Kuzatuv matni…"></textarea>
        </div>
        <div class="qp-field">
          <label>Kuzatuv ID</label>
          <input id="poe-obs-id" class="cast-input" value="obs_01" maxlength="60">
        </div>
        <div class="qp-field">
          <label>Tushuntirish savoli (Explanation)</label>
          <select id="poe-exp-q" class="cast-input"></select>
        </div>
        <div class="qp-field poe-timer-row">
          <label>⏱ Bashorat (s) <input type="number" id="poe-pred-sec" class="cast-input" value="20" min="5" max="600"></label>
          <label>⏱ Tushuntirish (s) <input type="number" id="poe-exp-sec" class="cast-input" value="90" min="5" max="600"></label>
        </div>
        <div class="qp-errors cast-surface" id="poe-errors" hidden></div>
      </div>
      <div class="qp-actions">
        <button type="button" class="cast-btn cast-btn-primary" id="poe-launch"><%- icon('rocket', 16) %> POE boshlash</button>
      </div>
    </div>
  </div>

  <!-- Open-Response Semantic Board Launch Drawer (C3-12) -->
  <div class="qp-overlay" id="orb-overlay" hidden>
    <div class="qp-drawer cast-surface" role="dialog" aria-modal="true" aria-labelledby="orb-title">
      <div class="qp-header">
        <h3 id="orb-title">🗂 Semantic Board — ochiq javoblar</h3>
        <button type="button" class="cast-btn qp-close" id="orb-close"><%- icon('close', 16) %></button>
      </div>
      <div class="qp-body">
        <div class="qp-field">
          <label>Savol (ochiq javob)</label>
          <textarea id="orb-prompt" class="cast-input cast-textarea" rows="3" maxlength="500" placeholder="Nima uchun shunday bo‘ldi deb o‘ylaysiz?…"></textarea>
        </div>
        <div class="qp-field poe-timer-row">
          <label>⏱ Vaqt (s) <input type="number" id="orb-seconds" class="cast-input" value="60" min="5" max="600"></label>
        </div>
        <div class="qp-field orb-note cast-surface">
          PII/profanity o‘z ichiga olgan javoblar clustering'ga yuborilmaydi. Cluster natijalari hech qachon ballga aylanmaydi.
        </div>
        <div class="qp-errors cast-surface" id="orb-errors" hidden></div>
      </div>
      <div class="qp-actions">
        <button type="button" class="cast-btn cast-btn-primary" id="orb-launch"><%- icon('rocket', 16) %> Board boshlash</button>
      </div>
    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/cast-socket-client.js"></script>
  <script src="/js/cast-choreography.js"></script>
  <script src="/js/cast-card-scanner.js"></script>
  <!-- C4-05: i18n bootstrap -->
  <script src="/js/i18n.js"></script>
  <!-- C4-04: accessibility bootstrap -->
  <script src="/js/cast-a11y.js"></script>
  <script src="/js/components/charts.js"></script>
  <script src="/js/cast-director.js"></script>
  <script src="/js/icon-kit.js"></script>
</body>
</html>
