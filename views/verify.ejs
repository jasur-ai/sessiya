<% const r = result || {}; %>
<!DOCTYPE html>
<html lang="uz" dir="ltr" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Deborah Verify</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="app-body">
  <main class="page-wrap" style="max-width:560px;margin:60px auto;padding:0 16px">
    <div class="card" style="text-align:center;padding:32px">
      <img src="/images/logo-vintage.png" alt="Deborah" class="logo-img" style="height:48px;width:auto;margin-bottom:16px">
      <% if (r.verifiable && r.status) { %>
        <div style="font-size:52px;margin-bottom:10px"><%= r.status === 'revoked' ? '✕' : (r.status === 'expired' ? '⏱' : '✓') %></div>
        <h1 style="margin:0 0 6px;color:var(--deborah-semantic-color-action-primary)">
          <%= r.status === 'revoked' ? 'Revoked' : (r.status === 'expired' ? 'Expired' : 'Valid') %>
        </h1>
        <p style="margin:0 0 4px;color:var(--deborah-semantic-color-text-primary)"><b><%= (r.name || 'Credential') %></b></p>
        <p style="margin:0 0 16px;color:var(--deborah-semantic-color-text-muted);font-size:14px">
          Recipient: <%= (r.recipient || '—') %><br>
          Issued: <%= (r.issuedAt || '—') %>
        </p>
        <div style="font-size:12px;color:var(--deborah-semantic-color-text-muted)">
          Ommaviy payload faqat select maydonlarni ko'rsatadi — raw submission
          hech qachon public verifier orqali chiqmaydi (Prompt 61 §15).
        </div>
      <% } else if (r.verifiable && r.item) { %>
        <div style="font-size:52px;margin-bottom:10px">🔗</div>
        <h1 style="margin:0 0 6px;color:var(--deborah-semantic-color-action-primary)">Shared evidence</h1>
        <p style="margin:0 0 4px;color:var(--deborah-semantic-color-text-primary)"><b><%= (r.item.title || '') %></b></p>
        <p style="margin:0;color:var(--deborah-semantic-color-text-muted);font-size:14px">Kind: <%= (r.item.kind || '') %></p>
      <% } else { %>
        <div style="font-size:52px;margin-bottom:10px">✕</div>
        <h1 style="margin:0 0 6px;color:var(--deborah-semantic-color-status-danger, #ef4444)">Not available</h1>
        <p style="margin:0;color:var(--deborah-semantic-color-text-muted);font-size:14px"><%= (r.error || "Havola topilmadi yoki muddati o'tgan") %></p>
      <% } %>
      <p style="margin-top:24px"><a href="/" class="btn">Deborah bosh sahifa</a></p>
    </div>
  </main>
  <script src="/js/icon-kit.js"></script>
</body>
</html>
