<% const gs = typeof locals.gameSess !== 'undefined' ? locals.gameSess : null; %>
<!DOCTYPE html>
<html lang="uz" dir="ltr">
<head>
  <%- include('../partials/head') %>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <style>
    :root{--bg:#0a0f1f;--card:#111a35;--border:rgba(255,255,255,.07);--accent:#2563eb;--gold:#FBBF24;--green:#38bdf8;--blue:#38bdf8;--purple:#64748b;--text:#e8edf7;--muted:#8b96b3;}
    body.light{--bg:#f0f0f8;--card:#fff;--border:rgba(0,0,0,.09);--text:#0a0a1a;--muted:#7070a0;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{font-family:'Source Sans 3',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden;transition:background .3s,color .3s;}
    .screen{display:none;min-height:100vh;flex-direction:column;align-items:center;justify-content:center;padding:20px;position:relative;}
    .screen.on{display:flex;}
    #s-lobby{background:radial-gradient(ellipse at 20% 30%,rgba(37,99,235,.18) 0%,transparent 55%),radial-gradient(ellipse at 80% 70%,rgba(56,189,248,.12) 0%,transparent 55%),var(--bg);text-align:center;}
    .lob-head{position:fixed;top:0;left:0;right:0;display:flex;align-items:center;justify-content:space-between;padding:12px 20px;background:rgba(6,6,15,.8);backdrop-filter:blur(18px);border-bottom:1px solid var(--border);z-index:100;transition:background .3s;}
    body.light .lob-head{background:rgba(240,240,248,.85);}
    .lob-head .logo{font-family:''Manrope'',cursive;font-size:1.15rem;background:linear-gradient(135deg,var(--accent),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;display:flex;align-items:center;gap:6px;}
    .lob-head .logo img{height:30px;width:auto;}
    .hd-right{display:flex;align-items:center;gap:8px;}
    .mode-btn{background:rgba(255,255,255,.07);border:1px solid var(--border);border-radius:9px;padding:7px 13px;font-family:'Source Sans 3',sans-serif;font-size:.78rem;font-weight:600;cursor:pointer;color:var(--muted);transition:color .2s,background-color .2s,border-color .2s,box-shadow .2s,transform .2s,opacity .2s;text-decoration:none;display:flex;align-items:center;gap:5px;}
    .mode-btn:hover{background:rgba(255,255,255,.12);color:var(--text);}
    .end-btn{background:rgba(37,99,235,.12);border:1px solid rgba(37,99,235,.25);border-radius:9px;padding:7px 13px;font-family:'Source Sans 3',sans-serif;font-size:.78rem;font-weight:600;cursor:pointer;color:var(--accent);transition:color .2s,background-color .2s,border-color .2s,box-shadow .2s,transform .2s,opacity .2s;}
    .end-btn:hover{background:rgba(37,99,235,.22);}
    .float-end-btn{position:fixed;top:14px;right:14px;z-index:200;background:rgba(37,99,235,.16);border:1px solid rgba(37,99,235,.35);border-radius:10px;padding:8px 14px;font-family:'Source Sans 3',sans-serif;font-size:.78rem;font-weight:700;cursor:pointer;color:#fff;display:none;backdrop-filter:blur(10px);box-shadow:0 4px 16px rgba(0,0,0,.3);}
    .float-end-btn.show{display:flex;align-items:center;gap:5px;}
    .float-end-btn:hover{background:rgba(37,99,235,.3);transform:translateY(-1px);}
    .corner-back{position:fixed;top:14px;left:14px;z-index:300;background:rgba(6,6,15,.82);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.12);border-radius:50px;padding:8px 16px;font-family:'Source Sans 3',sans-serif;font-size:.78rem;font-weight:700;cursor:pointer;color:var(--muted);transition:color .2s,background-color .2s,border-color .2s,box-shadow .2s,transform .2s,opacity .2s;text-decoration:none;display:none;align-items:center;gap:6px;}
    body.light .corner-back{background:rgba(240,240,248,.85);border-color:rgba(0,0,0,.12);}
    .corner-back.show{display:flex;}
    .corner-back:hover{color:var(--text);background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.22);}
    .lob-sub{font-size:.78rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:8px;margin-top:80px;}
    .lob-code{font-family:''Manrope'',cursive;font-size:clamp(4rem,14vw,8rem);color:var(--gold);letter-spacing:10px;animation:glow 2.5s ease-in-out infinite;line-height:1;}
    @keyframes glow{0%,100%{text-shadow:0 0 30px rgba(56,189,248,.3)}50%{text-shadow:0 0 70px rgba(56,189,248,.8)}}
    .qr-wrap{display:flex;flex-direction:column;align-items:center;gap:8px;margin-bottom:20px;}
    .qr-box{background:#fff;border-radius:16px;padding:10px;width:240px;height:240px;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 3px rgba(56,189,248,.4),0 8px 30px rgba(0,0,0,.5);}
    .qr-box canvas{display:block;}
    .qr-hint{font-size:.72rem;font-weight:600;color:var(--muted);letter-spacing:.5px;text-transform:uppercase;}
    .join-url{font-size:.75rem;font-weight:700;color:var(--accent);background:rgba(37,99,235,.08);border:1px solid rgba(37,99,235,.2);border-radius:8px;padding:5px 12px;cursor:pointer;transition:color .2s,background-color .2s,border-color .2s,box-shadow .2s,transform .2s,opacity .2s;text-decoration:none;display:inline-block;margin-top:2px;}
    .join-url:hover{background:rgba(37,99,235,.15);}
    .lob-count{font-family:''Manrope'',cursive;font-size:1.6rem;color:var(--green);margin-bottom:12px;}
    .lob-players{display:flex;flex-wrap:wrap;gap:7px;justify-content:center;max-width:700px;margin:0 auto 28px;}
    .p-chip{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);border-radius:50px;padding:6px 14px;font-size:.8rem;font-weight:600;display:flex;align-items:center;gap:6px;animation:popIn .2s ease-out both;}
    @keyframes popIn{from{transform:scale(.7);opacity:0}to{transform:scale(1);opacity:1}}
    .start-btn{background:linear-gradient(135deg,var(--green),#1d9bcf);color:#000;border:none;border-radius:16px;padding:16px 44px;font-family:''Manrope'',cursive;font-size:1.3rem;cursor:pointer;transition:color .25s,background-color .25s,border-color .25s,box-shadow .25s,transform .25s,opacity .25s;box-shadow:0 8px 30px rgba(56,189,248,.3);}
    .start-btn:hover:not(:disabled){transform:translateY(-3px);box-shadow:0 14px 40px rgba(56,189,248,.45);}
    .start-btn:disabled{opacity:.4;cursor:not-allowed;transform:none;}
    #s-qprev{text-align:center;background:linear-gradient(135deg,#0a0a20,#180a2a);}
    .qp-num{color:var(--muted);font-size:.88rem;font-weight:600;margin-bottom:8px;}
    .qp-text{font-family:''Manrope'',cursive;font-size:clamp(1.4rem,4.5vw,2.6rem);max-width:740px;line-height:1.4;color:var(--text);}
    .badge-double{display:inline-block;padding:5px 16px;border-radius:50px;font-size:.8rem;font-weight:700;background:rgba(56,189,248,.18);border:1px solid rgba(56,189,248,.4);color:var(--gold);margin-bottom:10px;}
    .q-total{color:var(--muted);font-size:.82rem;margin-top:16px;}
    .countdown-ring{margin:24px auto 0;position:relative;width:70px;height:70px;}
    .countdown-ring svg{transform:rotate(-90deg);}
    .countdown-ring .cnt-num{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:''Manrope'',cursive;font-size:1.4rem;color:var(--accent);}
    #s-qact{flex-direction:column;align-items:center;justify-content:flex-start;padding:14px 16px 100px;}
    body.light #s-qact{background:var(--bg);}
    .qa-top{width:100%;max-width:920px;text-align:center;padding:8px 10px 10px;}
    .qa-text{font-family:''Manrope'',cursive;font-size:clamp(1.1rem,3.5vw,1.9rem);line-height:1.4;}
    .qa-meta{color:var(--muted);font-size:.78rem;margin-top:5px;}
    .opts-host{display:grid;grid-template-columns:1fr 1fr;gap:10px;width:100%;max-width:920px;margin-top:12px;}
    .opts-host.single{grid-template-columns:1fr;}
    .opt-host{position:relative;overflow:hidden;background:#101a2e;border:2px solid var(--opt-c,rgba(255,255,255,.15));border-radius:14px;padding:16px 14px;font-family:'Source Sans 3',sans-serif;font-size:.97rem;font-weight:600;color:#fff;text-align:left;display:flex;align-items:center;gap:10px;min-height:68px;animation:optShimmer 4.5s ease-in-out infinite;animation-delay:var(--opt-delay,0s);}
    .opt-host::before{content:'';position:absolute;top:0;left:-60%;width:40%;height:100%;background:linear-gradient(115deg,transparent,rgba(255,255,255,.07),transparent);animation:optSweep 5.5s ease-in-out infinite;animation-delay:var(--opt-delay,0s);pointer-events:none;}
    @keyframes optShimmer{0%,100%{box-shadow:inset 0 0 0 0 transparent}50%{box-shadow:inset 0 0 32px 0 rgba(255,255,255,.04)}}
    @keyframes optSweep{0%{left:-60%}45%{left:120%}100%{left:120%}}
    .opt-host.correct{border-color:var(--green)!important;background:rgba(0,255,170,.08);box-shadow:0 0 0 1px var(--green);transform:scale(1.02);animation:none;}
    .opt-host.correct::before{display:none;}
    .opt-sym{font-size:1.3rem;flex-shrink:0;color:var(--opt-c,#fff);}
    .ans-bar{position:fixed;bottom:0;left:0;right:0;background:rgba(6,6,15,.9);backdrop-filter:blur(16px);border-top:1px solid var(--border);padding:12px 20px;display:none;align-items:center;justify-content:space-between;gap:12px;z-index:90;transition:background .3s;}
    body.light .ans-bar{background:rgba(240,240,248,.92);}
    .ans-count{font-family:''Manrope'',cursive;font-size:1.1rem;color:var(--text);}
    .ans-label{font-size:.75rem;font-weight:700;color:var(--muted);}
    .next-btn{background:linear-gradient(135deg,var(--accent),#1d4ed8);color:#fff;border:none;border-radius:12px;padding:11px 28px;font-family:''Manrope'',cursive;font-size:1rem;cursor:pointer;transition:color .2s,background-color .2s,border-color .2s,box-shadow .2s,transform .2s,opacity .2s;}
    .next-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(37,99,235,.4);}
    .timer-wrap{position:fixed;bottom:70px;right:18px;z-index:91;}
    .t-ring{position:relative;width:58px;height:58px;}
    .t-ring svg{transform:rotate(-90deg);}
    .t-num{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:''Manrope'',cursive;font-size:1.15rem;color:var(--text);}
    .t-ring circle.bg-c{stroke:rgba(255,255,255,.08);}
    .t-ring circle.fg-c{stroke:var(--accent);stroke-linecap:round;transition:stroke .4s;}
    #s-lb{text-align:center;background:radial-gradient(ellipse at 50% 20%,rgba(56,189,248,.2) 0%,transparent 55%),var(--bg);}
    #s-end{text-align:center;background:radial-gradient(ellipse at 50% 20%,rgba(56,189,248,.18) 0%,transparent 55%),radial-gradient(ellipse at 80% 80%,rgba(0,255,170,.08) 0%,transparent 50%),var(--bg);padding-top:70px;padding-bottom:80px;}
    .end-badge{font-size:3.5rem;margin-bottom:8px;animation:pop .4s ease-out;}
    @keyframes pop{0%{transform:scale(0)}60%{transform:scale(1.2)}100%{transform:scale(1)}}
    .lb-title{font-family:''Manrope'',cursive;font-size:2.2rem;color:var(--gold);animation:gleam 2s ease-in-out infinite;margin-bottom:4px;}
    @keyframes gleam{0%,100%{text-shadow:0 0 20px rgba(56,189,248,.3)}50%{text-shadow:0 0 60px rgba(56,189,248,.9)}}
    .lb-sub{color:var(--muted);font-size:.8rem;margin-bottom:18px;}
    .lb-list{width:100%;max-width:520px;margin:0 auto 24px;}
    .lbi{display:flex;align-items:center;gap:12px;background:rgba(255,255,255,.05);border-radius:14px;padding:12px 16px;margin-bottom:7px;border:1px solid rgba(255,255,255,.06);animation:slideIn .4s ease-out both;}
    .lbi:nth-child(1){border-color:rgba(56,189,248,.4);background:rgba(56,189,248,.07);animation-delay:0s;}
    .lbi:nth-child(2){border-color:rgba(192,192,192,.35);animation-delay:.06s;}
    .lbi:nth-child(3){border-color:rgba(205,127,50,.35);animation-delay:.12s;}
    .lbi:nth-child(4){animation-delay:.18s;}.lbi:nth-child(5){animation-delay:.24s;}
    .lbi:nth-child(6){animation-delay:.30s;}.lbi:nth-child(7){animation-delay:.36s;}
    @keyframes slideIn{from{transform:translateX(-30px);opacity:0}to{transform:translateX(0);opacity:1}}
    .lb-rank{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:''Manrope'',cursive;font-size:1rem;flex-shrink:0;}
    .rank-1{background:var(--gold);color:#000;}.rank-2{background:#c0c0c0;color:#000;}.rank-3{background:#cd7f32;color:#000;}.rank-n{background:rgba(255,255,255,.1);color:var(--muted);}
    .lb-em{font-size:1.3rem;flex-shrink:0;display:flex;align-items:center;}
    .lb-nm{flex:1;font-weight:600;font-size:.92rem;text-align:left;}
    .lb-sc{font-family:''Manrope'',cursive;font-size:1rem;color:var(--gold);}
    .lb-auto{color:var(--muted);font-size:.78rem;margin-top:4px;}
    .lbi-plain{background:transparent!important;border:none!important;box-shadow:none;padding:7px 16px;animation:none!important;}
    .lbi-plain .lb-rank{background:transparent;color:var(--muted);font-family:'Source Sans 3',sans-serif;font-weight:600;font-size:.8rem;width:auto;}
    .lbi-plain .lb-em{font-size:1.05rem;opacity:.75;}
    .lbi-plain .lb-nm{font-weight:700;font-size:.84rem;color:var(--muted);}
    .lbi-plain .lb-sc{color:var(--muted);font-size:.85rem;}
    .cont-btn{background:linear-gradient(135deg,var(--blue),#1a6599);color:#fff;border:none;border-radius:12px;padding:12px 32px;font-family:''Manrope'',cursive;font-size:1rem;cursor:pointer;transition:color .2s,background-color .2s,border-color .2s,box-shadow .2s,transform .2s,opacity .2s;margin-top:8px;}
    .cont-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(56,189,248,.3);}
    .end-title{font-family:''Manrope'',cursive;font-size:1.7rem;margin-bottom:6px;color:var(--green);}
    .end-sub{color:var(--muted);font-size:.8rem;margin-bottom:20px;}
    #s-end .lb-list{max-height:55vh;overflow-y:auto;padding-right:4px;}
    #s-end .lb-list::-webkit-scrollbar{width:4px;}
    #s-end .lb-list::-webkit-scrollbar-thumb{background:rgba(56,189,248,.35);border-radius:4px;}
    #s-end .lb-list::-webkit-scrollbar-track{background:rgba(255,255,255,.04);}
    .spin{width:40px;height:40px;border:3px solid rgba(255,255,255,.08);border-top-color:var(--accent);border-radius:50%;animation:sp .8s linear infinite;}
    @keyframes sp{to{transform:rotate(360deg)}}
    #loading{position:fixed;inset:0;z-index:9999;background:var(--bg);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12px;}
    #loading.hide{display:none;}
  </style>
</head>
<body>
<div id="loading"><div class="spin"></div><div style="color:var(--muted);font-size:.82rem;font-weight:700">O'yin yuklanmoqda...</div></div>

<button type="button" class="float-end-btn" id="float-end-btn" onclick="confirmEnd()">✕ Tugatish</button>
<a id="corner-back" class="corner-back" href="/user/panel">← Panelga qaytish</a>

<div class="screen" id="s-lobby">
  <div class="lob-head">
    <div class="logo"><img src="/images/logo-vintage.png" alt="Deborah"></div>
    <div class="hd-right">
      <span style="font-size:.72rem;font-weight:700;color:var(--muted)" id="lob-test-name">Test</span>
      <button type="button" class="mode-btn" id="dark-toggle" onclick="toggleDark()"><%- icon('sun', 14) %></button>
      <a href="/user/panel" class="mode-btn">← Qaytish</a>
      <button type="button" class="end-btn" onclick="confirmEnd()">✕ Tugatish</button>
    </div>
  </div>
  <div class="lob-sub">O'yin kodi</div>
  <div class="lob-code" id="lob-code">—</div>
  <div class="qr-wrap">
    <div class="qr-box" id="qr-canvas"></div>
    <div class="qr-hint">QR skan qiling</div>
    <button type="button" class="join-url" id="join-url">Havola nusxalash</button>
  </div>
  <div class="lob-count" id="lob-cnt">0 o'yinchi</div>
  <div class="lob-players" id="lob-players"></div>
  <button type="button" class="start-btn" id="start-btn" onclick="startGame()">▶ O'yinni Boshlash</button>
</div>

<div class="screen" id="s-qprev">
  <div class="qp-num" id="qp-num">Savol 1</div>
  <div id="qp-badge"></div>
  <div class="qp-text" id="qp-text"></div>
  <div class="q-total" id="qp-total"></div>
  <div class="countdown-ring">
    <svg width="70" height="70"><circle class="bg-c" cx="35" cy="35" r="28" fill="none" stroke-width="5" stroke="rgba(255,255,255,.08)"></circle><circle id="cnt-arc" cx="35" cy="35" r="28" fill="none" stroke-width="5" stroke="var(--accent)" stroke-dasharray="175.9" stroke-dashoffset="0" stroke-linecap="round" style="transition:stroke-dashoffset .1s"></circle></svg>
    <div class="cnt-num" id="cnt-num">3</div>
  </div>
</div>

<div class="screen" id="s-qact">
  <div class="qa-top">
    <div class="qa-text" id="qa-text"></div>
    <div id="qa-badge"></div>
    <div class="qa-meta" id="qa-meta"></div>
  </div>
  <div class="opts-host" id="opts-host"></div>
  <div class="timer-wrap">
    <div class="t-ring">
      <svg width="58" height="58"><circle class="bg-c" cx="29" cy="29" r="23" fill="none" stroke-width="5" stroke="rgba(255,255,255,.08)"></circle><circle class="fg-c" id="t-arc" cx="29" cy="29" r="23" fill="none" stroke-width="5" stroke="var(--accent)" stroke-dasharray="144.5" stroke-dashoffset="0" stroke-linecap="round"></circle></svg>
      <div class="t-num" id="t-num">20</div>
    </div>
  </div>
</div>
<div class="ans-bar" id="ans-bar">
  <div><div class="ans-count" id="ans-count">0 / 0</div><div class="ans-label">javob berdi</div></div>
  <button type="button" class="next-btn" onclick="hostNext()">Keyingi →</button>
</div>

<div class="screen" id="s-lb">
  <div class="lb-title">🏆 Shoxsupa</div>
  <div class="lb-sub" id="lb-sub">Natijalar</div>
  <div class="lb-list" id="lb-list"></div>
  <div class="lb-auto" id="lb-auto"></div>
  <button type="button" class="cont-btn" onclick="afterLbNext()">Davom etish →</button>
</div>

<div class="screen" id="s-end">
  <div class="end-badge">🎉</div>
  <div class="lb-title">🏆 Final Shoxsupa</div>
  <div class="end-title">O'yin tugadi!</div>
  <div class="end-sub" id="end-sub">Barcha o'yinchilar natijalari</div>
  <div class="lb-list" id="end-list"></div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  const questions = <%- JSON.stringify(gs ? gs.questions : []) %>;
  const settings = <%- JSON.stringify(gs ? gs.settings : {}) %>;
  const testName = '<%= gs ? gs.test_name.replace(/'/g, "\\'") : "Test" %>';
  const OPT_COLORS = ['#ff4466','#38bdf8','#ffd60a','#00ffaa','#c084fc'];
  const RANK_CLS = ['rank-1','rank-2','rank-3','rank-n','rank-n','rank-n','rank-n'];
  const SYMS = ['▲','●','◆','★','✦'];
  const BG_STYLES = ['', 'radial-gradient(ellipse at 20% 20%,#0a1628 0%,#0d2240 50%,#1a3a5c 100%)', 'radial-gradient(ellipse at 50% 0%,#1a0020 0%,#2d003a 50%,#0a1a10 100%)'];

  let gameCode = null, currentQIdx = 0, isProcessing = false, gameFinished = false, hasStarted = false;
  let darkMode = true, timerIv = null, cntIv = null, lbAutoIv = null, lbAutoTimer = null, lateAnswerTm = null;
  let playerCount = 0, activeBg = 0;

  const $ = id => document.getElementById(id);
  const esc = s => String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

  function charImg(imgPath, size) {
    size = size || 30;
    if (!imgPath) return '<span style="font-size:'+size+'px">👤</span>';
    const safePath = esc(imgPath);
    if (imgPath.startsWith('characters/') || imgPath.startsWith('http') || imgPath.startsWith('/'))
      return '<img src="' + safePath + '" style="width:'+size+'px;height:'+size+'px;object-fit:contain;vertical-align:middle;border-radius:4px;" alt="">';
    return '<span style="font-size:'+size+'px">'+safePath+'</span>';
  }

  function applyBgTo(el) { if (activeBg > 0 && el) el.style.background = BG_STYLES[activeBg] || ''; }
  function applyBg(n) {
    activeBg = n;
    if (n > 0) document.querySelectorAll('.screen').forEach(s => s.style.background = BG_STYLES[n] || '');
  }    function goTo(id) {
      document.querySelectorAll('.screen').forEach(s => { s.classList.remove('on'); s.style.background = ''; });
      $(id).classList.add('on');
      if (activeBg > 0) applyBgTo($(id));
    $('ans-bar').style.display = id === 's-qact' ? 'flex' : 'none';
    $('float-end-btn').classList.toggle('show', id === 's-qprev' || id === 's-qact' || id === 's-lb');
    const cb = $('corner-back');
    if (cb) cb.classList.toggle('show', id === 's-end');
  }

  function shuffleForQ(arr, seed) {
    const a = [...arr];
    let s = (seed + 1) * 1103515245 + 12345;
    for (let i = a.length - 1; i > 0; i--) { s = (s * 1103515245 + 12345) & 0x7fffffff; const j = s % (i + 1); [a[i], a[j]] = [a[j], a[i]]; }
    return a;
  }

  function fmtMs(ms) {
    const s = Math.round((ms || 0) / 1000);
    return s < 60 ? s + 's' : Math.floor(s / 60) + 'm ' + (s % 60) + 's';
  }

  // INIT
  document.addEventListener('DOMContentLoaded', () => {
    $('lob-test-name').textContent = testName;
    $('loading').classList.add('hide');
    socket.emit('host:create', {
      testName,
      questions,
      settings: {
        timePerQ: settings.time_per_q || 20,
        type: settings.type || 'score',
        auto: settings.auto !== false,
        bg: 0
      },
      hostName: 'Host'
    });
    applyBg(settings.bg || 0);
  });    socket.on('host:created', (data) => {
      $('loading').classList.add('hide');
      gameCode = data.code;
      $('lob-code').textContent = gameCode;
    const joinURL = window.location.origin + '/play?code=' + gameCode;
    if (typeof QRCode !== 'undefined') {
      new QRCode($('qr-canvas'), { text: joinURL, width: 200, height: 200, colorDark: '#000', colorLight: '#fff', correctLevel: QRCode.CorrectLevel.H });
    }
    $('join-url').onclick = function(e) {
      e.preventDefault();
      navigator.clipboard.writeText(joinURL).then(() => {
        this.textContent = '✅ Nusxalandi!';
        setTimeout(() => this.textContent = 'Havola nusxalash', 2000);
      });
    };
    goTo('s-lobby');
  });

  socket.on('players:update', (data) => {
    const players = data.players || [];
    playerCount = players.length;
    $('lob-cnt').textContent = players.length + ' o\'yinchi';
    $('lob-players').innerHTML = players.map(p =>
      '<div class="p-chip">' + charImg(p.emoji, 22) + ' ' + esc(p.name) + '</div>'
    ).join('');
  });

  socket.on('game:questionPreview', (data) => {
    goTo('s-qprev');
    currentQIdx = data.qIndex;
    const q = questions[data.qIndex];
    $('qp-num').textContent = 'Savol ' + (data.qIndex + 1);
    $('qp-total').textContent = (data.qIndex + 1) + ' / ' + questions.length;
    $('qp-text').textContent = q ? q.text : '';
    $('qp-badge').innerHTML = q && q.is_double ? '<div class="badge-double">⚡ IKKI BAROBAR BALL</div>' : '';
    let cnt = 3;
    const arc = $('cnt-arc'), num = $('cnt-num');
    const circ = 175.9;
    if (cntIv) clearInterval(cntIv);
    num.textContent = cnt; arc.style.strokeDashoffset = '0';
    cntIv = setInterval(() => {
      cnt--; num.textContent = cnt;
      arc.style.strokeDashoffset = String(circ * (1 - cnt / 3));
      if (cnt <= 0) { clearInterval(cntIv); cntIv = null; }
    }, 1000);
  });

  socket.on('game:questionActive', (data) => {
    goTo('s-qact');
    currentQIdx = data.qIndex;
    const q = questions[data.qIndex];
    $('qa-text').textContent = q ? q.text : '';
    $('qa-badge').innerHTML = q && q.is_double ? '<div class="badge-double">⚡ IKKI BAROBAR</div>' : '';
    $('qa-meta').textContent = (data.qTime || 20) + 's';

    // Shuffle options deterministically
    const rawOpts = (q ? q.options : []).map((o, i) => ({ text: o, origIdx: i }));
    const shuffled = shuffleForQ(rawOpts, currentQIdx);
    $('opts-host').innerHTML = shuffled.map((o, pos) =>
      '<div class="opt-host" data-orig="' + o.origIdx + '" style="--opt-c:' + (OPT_COLORS[pos]||'#fff') + ';--opt-delay:' + (pos * 0.6) + 's">' +
      '<span class="opt-sym">' + (SYMS[pos]||'•') + '</span>' + esc(o.text) + '</div>'
    ).join('');
    $('opts-host').className = 'opts-host' + (rawOpts.length <= 2 ? ' single' : '');

    const totalSec = data.qTime || 20;
    const startAt = data.startedAt || Date.now();
    const arc = $('t-arc'), tnum = $('t-num');
    const circ = 144.5;
    if (timerIv) clearInterval(timerIv);
    timerIv = setInterval(() => {
      const el = (Date.now() - startAt) / 1000;
      const rem = Math.max(0, totalSec - el);
      arc.style.strokeDashoffset = String(circ * (1 - rem / totalSec));
      arc.style.stroke = rem < totalSec * .3 ? '#2563eb' : rem < totalSec * .6 ? '#f2a827' : 'var(--green)';
      tnum.textContent = Math.ceil(rem);
      if (rem <= 0) {
        stopTimer();
        if (!isProcessing && settings.auto !== false) {
          clearTimeout(lateAnswerTm);
          lateAnswerTm = setTimeout(() => { if (!isProcessing) hostNext(); }, 500);
        }
      }
    }, 100);
  });
  function stopTimer() { if (timerIv) { clearInterval(timerIv); timerIv = null; } }

  socket.on('answer:count', (data) => {
    $('ans-count').textContent = (data.answered || 0) + ' / ' + (data.total || 0);
  });

  socket.on('game:leaderboard', (data) => {
    isProcessing = false;
    goTo('s-lb');
    const lb = data.leaderboard || [];
    currentQIdx = data.qIndex;
    $('lb-sub').textContent = data.isLast ? 'Final natijalar' : 'Oraliq natijalar';

    // TOP 7 styled
    $('lb-list').innerHTML = renderLb(lb);

    if (lbAutoIv) clearInterval(lbAutoIv);
    if (lbAutoTimer) clearTimeout(lbAutoTimer);
    if (data.autoNext) {
      let sec = 5;
      $('lb-auto').textContent = sec + 's da davom etadi...';
      lbAutoIv = setInterval(() => { sec--; if (sec > 0) $('lb-auto').textContent = sec + 's da davom etadi...'; else { clearInterval(lbAutoIv); $('lb-auto').textContent = ''; } }, 1000);
    } else {
      $('lb-auto').textContent = 'Qo\'lda boshqarish rejimi';
    }
  });

  socket.on('game:ended', (data) => {
    gameFinished = true;
    const lb = data.leaderboard || [];
    // Full render — TOP 7 styled + rest plain
    $('end-list').innerHTML = renderLbFull(lb);
    $('end-sub').textContent = lb.length + ' ta o\'yinchi';
    goTo('s-end');
  });

  socket.on('error', (data) => { showToast(data.message || 'Xatolik', 'err'); });

  // ── LB RENDER ──
  function renderLb(lb) {
    return lb.slice(0, 7).map((p, i) =>
      '<div class="lbi"><div class="lb-rank ' + (RANK_CLS[i]||'rank-n') + '">' + (['🥇','🥈','🥉'][i]||(i+1)) + '</div>' +
      '<div class="lb-em">' + charImg(p.emoji, 32) + '</div>' +
      '<div class="lb-nm">' + esc(p.name) + '</div>' +
      '<div class="lb-sc">' + (p.score||0) + ' ball</div></div>'
    ).join('');
  }

  // Full render — TOP 7 styled, rest plain with time
  function renderLbFull(lb) {
    return (lb || []).map((p, i) => {
      const plain = i >= 7;
      if (plain) {
        return '<div class="lbi lbi-plain">' +
          '<div class="lb-rank rank-n">' + (i + 1) + '</div>' +
          '<div class="lb-em">' + charImg(p.emoji, 24) + '</div>' +
          '<div class="lb-nm">' + esc(p.name) + '</div>' +
          '<div style="text-align:right"><div class="lb-sc">' + (p.score||0) + ' ball</div>' +
          '<div style="font-size:.65rem;color:var(--muted);font-weight:700">' + fmtMs(p.time) + '</div></div></div>';
      }
      return '<div class="lbi">' +
        '<div class="lb-rank ' + (RANK_CLS[i]||'rank-n') + '">' + (['🥇','🥈','🥉'][i]||(i+1)) + '</div>' +
        '<div class="lb-em">' + charImg(p.emoji, 32) + '</div>' +
        '<div class="lb-nm">' + esc(p.name) + '</div>' +
        '<div style="text-align:right"><div class="lb-sc">' + (p.score||0) + ' ball</div>' +
        '<div style="font-size:.65rem;color:var(--muted);font-weight:700">' + fmtMs(p.time) + '</div></div></div>';
    }).join('');
  }

  // ── GAME ACTIONS ──
  async function startGame() {
    if (hasStarted) return;
    if (playerCount === 0 && !(await showConfirm('O\'yinni boshlash', 'Hali o\'yinchi yo\'q. Baribir boshlaysizmi?', 'Boshlash'))) return;
    hasStarted = true;
    socket.emit('host:start', { code: gameCode });
  }

  function hostNext() {
    if (isProcessing || gameFinished) return;
    isProcessing = true;
    if (cntIv) { clearInterval(cntIv); cntIv = null; }
    stopTimer();
    clearTimeout(lateAnswerTm);      socket.emit('host:forceNext', { code: gameCode, currentIndex: currentQIdx });
  }

  function afterLbNext() {
    if (lbAutoIv) clearInterval(lbAutoIv);
    if (lbAutoTimer) clearTimeout(lbAutoTimer);
    socket.emit('host:next', { code: gameCode, currentIndex: currentQIdx });
  }

  async function confirmEnd() {
    if (!(await showConfirm('O\'yinni tugatish', 'O\'yinni tugatishni xohlaysizmi?', 'Tugatish'))) return;
    if (lbAutoIv) clearInterval(lbAutoIv);
    if (lbAutoTimer) clearTimeout(lbAutoTimer);
    socket.emit('host:end', { code: gameCode });
  }

  function toggleDark() {
    darkMode = !darkMode;
    document.body.classList.toggle('light', !darkMode);
    $('dark-toggle').innerHTML = darkMode ? '<%- icon("sun", 14) %>' : '<%- icon("moon", 14) %>';
  }
</script>
  <script src="/js/icon-kit.js"></script>
</body>
</html>
