<!-- STEP 08 (S08.05): faqat critical UI font (Source Sans 3 latin) preload;
     barcha weight/fontlarni emas. Self-hosted — tarmoq beqaror bo'lsa ham ishlaydi. -->
<link rel="preload" href="/fonts/source-sans-3-latin-200.woff2" as="font" type="font/woff2" crossorigin>
<meta name="theme-color" content="#080C1A" id="meta-theme-color" data-light="#F5F7FB" data-dark="#080C1A" data-hc="#FFFFFF">

<!-- ═══════════ THEME BOOT (S07.02) — tiny synchronous, first-paint oldin ═══════════
     FOUC'siz: local pref + prefers-color-scheme/contrast ni CSS yuklanmasdan
     resolve qiladi va yagona attribute model'ni (data-theme + data-resolved-theme)
     o'rnatadi. JS/Node'da ham theme-core (S07.01) bilan bir xil mantiq. -->
<script>
(function(){var K='deborah-theme-state',L='deborah-theme',s=null;try{s=localStorage.getItem(K)}catch(_){}if(!s){try{var l=localStorage.getItem(L);if(l==='light'||l==='dark'){s=l;try{localStorage.setItem(K,s)}catch(_){}}}catch(_){}}
var STATES=['system','light','dark','hc-light','hc-dark'];if(STATES.indexOf(s)<0)s='system';
/* S07.10: projector/classroom (data-cast-theme) sahifalari — OS'dan mustaqil.
   Boot ham engine kabi skip qiladi (reviewer fix, konsistentlik). */
var dc=document.documentElement.getAttribute('data-cast-theme');if(!dc&&document.body&&document.body.getAttribute('data-cast-theme'))dc=1;
if(!dc){
var mL=window.matchMedia&&matchMedia('(prefers-color-scheme: light)').matches;
var mC=window.matchMedia&&matchMedia('(prefers-contrast: more)').matches;
var r='dark',cs='dark',cv='#080C1A';
if(s==='light'){r='light';cs='light';cv='#F5F7FB'}
else if(s==='dark'){r='dark';cs='dark';cv='#080C1A'}
else if(s==='hc-light'){r='light';cs='light'} /* BUG-077: hc token sheeti yo'q — bazaga graceful resolve */
else if(s==='hc-dark'){r='dark';cs='dark'}
else{r=mL?'light':'dark';cs=mL?'light':'dark';cv=r==='light'?(cv||'#F5F7FB'):cv} // BUG-077: OS kontrast pref'i high-contrast'ga otmaydi (CSS yo'q)
var d=document.documentElement;d.setAttribute('data-theme',r);d.setAttribute('data-resolved-theme',r);d.setAttribute('data-theme-state',s);d.style.colorScheme=cs;
var mc=document.getElementById('meta-theme-color');if(mc)mc.setAttribute('content',cv);
}
})();
</script>
