    .update-banner-close{width:28px;height:28px;border:none;background:transparent;color:var(--text-tertiary, #6B7288);font-size:1.1rem;line-height:1;cursor:pointer;border-radius:6px;}
    .update-banner-close:hover{background:var(--deborah-semantic-color-surface-nested, #131B3A);color:var(--deborah-semantic-color-text-primary);}
    @media (prefers-reduced-motion: reduce){.update-banner{animation:none !important;}}
  </style>

<!-- STEP 40 S40.02: feature flag status (monitoring/rollout) -->
<script>
  document.documentElement.setAttribute('data-ff-theme', '<%= typeof featureFlags !== 'undefined' && featureFlags.theme === false ? 'off' : 'on' %>');
  document.documentElement.setAttribute('data-ff-landing', '<%= typeof featureFlags !== 'undefined' && featureFlags.landing === false ? 'off' : 'on' %>');
  document.documentElement.setAttribute('data-ff-auth', '<%= typeof featureFlags !== 'undefined' && featureFlags.auth === false ? 'off' : 'on' %>');
  document.documentElement.setAttribute('data-ff-workspace', '<%= typeof featureFlags !== 'undefined' && featureFlags.workspace === false ? 'off' : 'on' %>');
  document.documentElement.setAttribute('data-ff-cast', '<%= typeof featureFlags !== 'undefined' && featureFlags.cast === false ? 'off' : 'on' %>');
  document.documentElement.setAttribute('data-ff-admin', '<%= typeof featureFlags !== 'undefined' && featureFlags.admin === false ? 'off' : 'on' %>');
</script>

<!-- Service Worker (lightweight, deduped via controller check) -->
<script>
if ('serviceWorker' in navigator && !navigator.serviceWorker.controller) {
  window.addEventListener('load', function() {
    navigator.serviceWorker.register('/service-worker.js', { scope: '/' });
  });
}
</script>
