    .update-banner{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:var(--z-toast, 9000);max-width:min(92vw, 520px);background:var(--deborah-semantic-color-surface-raised, #0F1630);border:1px solid var(--deborah-semantic-color-border-default, #2C3346);border-radius:12px;box-shadow:0 12px 34px rgba(0,0,0,.35);padding:10px 12px;}
