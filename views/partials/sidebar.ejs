    <div class="shell-account-menu" id="shell-account-menu">
      <a href="/" class="shell-account-menu-item"><span class="shell-nav-ico"><%- icon('home', 14) %></span> <%= _st('home', 'Bosh sahifa') %></a>
      <a href="/user/panel" class="shell-account-menu-item"><span class="shell-nav-ico"><%- icon('grid', 14) %></span> <%= _st('panel', 'Panel') %></a>
      <% /* 09/2026 (user qarori): Profilim akkaunt-menyusidan olib tashlandi —
             profil faqat sidebar navigatsiyasida bitta joyda turadi (dublikat yo'q). */ %>
      <%- include('theme-control', { headerCopy: _tc }) %>
      <a href="/user/logout" class="shell-account-menu-item shell-account-menu-item--logout"><span class="shell-nav-ico"><%- icon('logOut', 14) %></span> <%= _st('logout', 'Chiqish') %></a>
