    <button type="button" class="shell-account-btn" aria-haspopup="true" aria-expanded="false" aria-controls="shell-account-menu">
      <span class="shell-nav-ico"><%- icon('user', 15) %></span>
      <span>
        <span class="shell-account-name"><%= _uname || _roleLabel %></span>
        <span class="shell-account-sub"><%= _roleLabel %></span>
